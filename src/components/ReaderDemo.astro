---
// Interactive parallel reader demo, loads real book content via backend API
interface Props {
  targetLang?: string;
  uiLang?: string;
  /** Screenshot mode: freeze on a representative still frame instead of animating. */
  still?: boolean;
}
const { targetLang = 'de', uiLang = 'en', still = false } = Astro.props;
---

<div class="reader-demo" data-target-lang={targetLang} data-ui-lang={uiLang} data-still={still ? '1' : undefined}>
  <div class="reader-demo__phone-wrap">
    <img src="/images/phone-clean.svg" alt="" class="reader-demo__shell" />
    <div class="reader-demo__frame">
      <div class="reader" id="readerRoot">
        <!-- Header -->
        <div class="reader__header">
          <span class="reader__back">&#8249;</span>
          <span class="reader__title" id="readerTitle">Loading…</span>
          <button class="reader__listen is-active" style="display:none">
            <span class="reader__eq">
              <span class="reader__eq-bar"></span>
              <span class="reader__eq-bar"></span>
              <span class="reader__eq-bar"></span>
              <span class="reader__eq-bar"></span>
            </span>
            Reading…
          </button>
        </div>

        <!-- Content (filled dynamically) -->
        <div class="reader__content" id="readerContent">
          <div class="reader__loading" id="readerLoading">Loading...</div>
        </div>

        <!-- Page footer -->
        <div class="reader__footer">
          <span class="reader__page">&#8249;</span>
          <span class="reader__page">1 / 30</span>
          <span class="reader__page">&#8250;</span>
        </div>

        <!-- Tap finger -->
        <div class="reader__finger" id="readerFinger">
          <img src="/images/finger.svg" alt="" width="36" height="36" />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Phone wrapper */
  .reader-demo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .reader-demo__phone-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .reader-demo__shell {
    position: absolute;
    width: 332px;
    height: 645px;
    top: -2px;
    left: -6px;
    z-index: 20;
    pointer-events: none;
  }

  .reader-demo__frame {
    width: 320px;
    height: 640px;
    background: #fff;
    border-radius: 36px;
    overflow: hidden;
    position: relative;
  }

  /* Finger */
  .reader__finger {
    position: absolute;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, top 0.4s ease, left 0.4s ease;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }
  .reader__finger.is-visible { opacity: 1; }
  .reader__finger.is-tapping { animation: finger-tap 0.5s ease; }
  /* Float above the word, pointing down, keeps the translation line clear. */
  .reader__finger.is-above img { transform: scaleY(-1); }
  /* Small, angled tap pose: smaller hand tilted so it points up-left at the word
     from below while its body swings off into the margin. */
  .reader__finger.is-tap-pose img { width: 26px; height: 26px; transform: rotate(-24deg); transform-origin: 50% 12%; }

  @keyframes finger-tap {
    0% { transform: scale(1); }
    30% { transform: scale(0.75); }
    60% { transform: scale(0.85); }
    100% { transform: scale(1); }
  }

  /* Reader */
  .reader {
    width: 100%;
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .reader__header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
  }

  .reader__back {
    font-size: 20px;
    color: #f97316;
    font-weight: 600;
    line-height: 1;
  }

  .reader__title {
    font-size: 11px;
    color: #333;
    font-weight: 500;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader__page { font-size: 11px; color: #999; }

  .reader__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid #eee;
    flex-shrink: 0;
  }

  .reader__listen {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: none;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    background: #e5e7eb;
    color: #666;
    transition: all 0.3s;
  }
  .reader__listen.is-active {
    background: #f97316;
    color: #fff;
  }

  .reader__eq {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 12px;
  }
  .reader__eq-bar {
    width: 2px;
    background: #fff;
    border-radius: 1px;
    animation: eq-bounce 1s ease-in-out infinite;
  }
  .reader__eq-bar:nth-child(1) { height: 4px; animation-delay: 0s; }
  .reader__eq-bar:nth-child(2) { height: 8px; animation-delay: 0.15s; }
  .reader__eq-bar:nth-child(3) { height: 5px; animation-delay: 0.3s; }
  .reader__eq-bar:nth-child(4) { height: 10px; animation-delay: 0.45s; }

  @keyframes eq-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  .reader__content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 14px 14px 20px;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    pointer-events: none;
  }
  .reader__content::-webkit-scrollbar { display: none; }

  .reader__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #999;
    font-size: 14px;
    font-weight: 500;
  }

  :global(.reader__chapter) {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  :global(.reader__chapter-trans) {
    font-size: 11px;
    color: #999;
    text-align: center;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  :global(.reader__subchapter) {
    font-size: 12px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 2px;
  }
  :global(.reader__subchapter-trans) {
    font-size: 10px;
    color: #999;
    text-align: center;
    margin-bottom: 14px;
    font-style: italic;
  }

  :global(.reader__pair) { margin-bottom: 10px; }

  :global(.reader__en) {
    font-size: 12px;
    line-height: 1.5;
    color: #1a1a2e;
    margin-bottom: 2px;
    transition: background 0.3s, color 0.3s;
    padding: 2px 4px;
    margin: 0 -4px 2px;
    border-radius: 4px;
  }
  :global(.reader__en.is-reading) {
    background: rgba(249, 115, 22, 0.06);
    border-radius: 4px;
  }

  :global(.reader__word.is-spoken) {
    background: rgba(249, 115, 22, 0.25);
    color: #c2410c;
    border-radius: 3px;
    padding: 1px 2px;
    margin: -1px -2px;
  }

  :global(.reader__trans) {
    font-size: 11px;
    line-height: 1.4;
    color: #aaa;
    padding: 0 4px;
  }

  :global(.reader__word.is-tapped) {
    background: #f97316;
    color: #fff;
    border-radius: 3px;
    padding: 1px 3px;
    margin: -1px -3px;
  }

  @media (max-width: 768px) {
    .reader-demo__frame {
      width: 260px;
      height: 520px;
      border-radius: 30px;
    }
    .reader-demo__shell {
      width: 272px;
      height: 530px;
      left: -5px;
      top: -2px;
    }
  }

  :global(.reader__trans-word) {
    transition: background 0.3s, color 0.3s;
    border-radius: 3px;
    padding: 1px 2px;
    margin: -1px -2px;
  }
  :global(.reader__trans-word.is-trans-highlighted) {
    background: rgba(249, 115, 22, 0.2);
    color: #c2410c;
    border-radius: 3px;
  }
</style>

<script>
  const BACKEND = 'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api';
  const BOOK = 'summary_11_A2';
  const readerRoot = document.querySelector<HTMLElement>('.reader-demo');
  const INITIAL_TGT = readerRoot?.dataset.targetLang || 'de';
  const INITIAL_TRN = readerRoot?.dataset.uiLang || 'en';
  // Screenshot mode: render one clean frame (tapped word + highlighted
  // translation) and signal readiness via window.__shotReady, no animation.
  const STILL = readerRoot?.dataset.still === '1';
  // Optional still-frame overrides (used by the Instagram-grid centerpiece, not the
  // store screenshots): tap a specific, more evocative word and float the finger
  // ABOVE it (pointing down) so it never covers the highlighted translation below.
  const STILL_TAP_WORD = (readerRoot?.dataset.stillTapWord || '').toLowerCase();
  // Finger placement mode for the still frame: 'above' (points down from above),
  // 'angled' (small tilted hand below the word), or '' (default centered below).
  const FINGER_MODE = readerRoot?.dataset.finger || '';

  // Cancellation token: every load bumps this; running setTimeouts bail if stale.
  let currentRequestId = 0;
  // First reveal waits for viewport intersection; subsequent reloads start immediately.
  let hasRevealed = false;

  // Fetch JSON from the v2 backend. The /page and /align endpoints generate
  // synchronously on a cache miss (they block until ready), so no polling is
  // needed, just retry a couple of times on transient network/5xx errors.
  async function fetchJson(url, retries = 2) {
    let lastErr;
    for (let i = 0; i <= retries; i++) {
      try {
        const res = await fetch(url);
        if (res.ok) return await res.json();
        lastErr = new Error(`Backend ${res.status}`);
      } catch (e) { lastErr = e; }
      if (i < retries) await new Promise(r => setTimeout(r, 1500));
    }
    throw lastErr;
  }

  // Group a v2 block's tokens by sentence using its pre-split sentence ranges.
  // Returns one entry per sentence: { words, text, tokenOffset } where
  // tokenOffset is the index of the sentence's first token within the block's
  // token array, the same index space the v2 alignments use.
  function blockToSentences(block) {
    const sents = block.sentences || [];
    const groups = sents.map(() => ({ words: [], text: '', tokenOffset: -1 }));
    for (let ti = 0; ti < block.tokens.length; ti++) {
      const t = block.tokens[ti];
      let si = 0;
      for (let j = 0; j < sents.length; j++) {
        if (t.s >= sents[j].s && t.e <= sents[j].e) { si = j; break; }
      }
      const g = groups[si];
      if (!g) continue;
      if (g.tokenOffset < 0) g.tokenOffset = ti;
      g.words.push(block.text.substring(t.s, t.e));
    }
    for (let si = 0; si < sents.length; si++) {
      groups[si].text = block.text.substring(sents[si].s, sents[si].e).trim();
    }
    return groups;
  }

  // Extract title/subtitle + flat sentence list from one side ('orig' | 'trans')
  // of a v2 page response. Sentences carry their block index + within-block
  // sentence index so word taps can look up the matching alignment entry.
  function parseSide(page, side) {
    let title = '';
    let subtitle = '';
    const sentences = []; // { words, text, blockIdx, sentIdx, tokenOffset }
    for (let bi = 0; bi < page.blocks.length; bi++) {
      const block = page.blocks[bi][side];
      const style = block.style;
      if (style === 'h1' || style === 'h2' || style === 'h3') {
        const text = block.text.trim();
        if (style === 'h1' && !title) title = text;
        else if (!subtitle) subtitle = text;
        continue;
      }
      const groups = blockToSentences(block);
      for (let si = 0; si < groups.length; si++) {
        sentences.push({
          words: groups[si].words,
          text: groups[si].text,
          blockIdx: bi,
          sentIdx: si,
          tokenOffset: groups[si].tokenOffset,
        });
      }
    }
    return { title, subtitle, sentences };
  }

  // Build word-wrapped HTML for a sentence
  function renderWords(words, cssClass) {
    return words.map((w, i) =>
      `<span class="${cssClass}" data-word-idx="${i}">${w}</span>`
    ).join(' ');
  }

  async function loadAndRender(tgtLang, trnLang) {
    const requestId = ++currentRequestId;
    const container = document.getElementById('readerContent');
    const titleEl = document.getElementById('readerTitle');
    if (!container) return;

    // Reset UI for new render
    container.innerHTML = '<div class="reader__loading">Loading…</div>';
    if (titleEl) titleEl.textContent = 'Loading…';
    const listenBtn = document.querySelector<HTMLElement>('.reader__listen');
    if (listenBtn) listenBtn.style.display = 'none';
    const fingerEl = document.getElementById('readerFinger');
    if (fingerEl) fingerEl.classList.remove('is-visible');

    try {
      // v2: one call returns orig (target lang) + trans (ui lang) paired, with
      // sentences already split server-side (locale-aware) and orig/trans
      // sentence counts guaranteed equal, so a short sentence can never be
      // paired with a whole paragraph the way the old client-side splitter
      // (Latin-only /[.!?]/) did for scripts like Armenian.
      const page = await fetchJson(
        `${BACKEND}/books2/${BOOK}/page?page=0&orig_lang=${tgtLang}&target_lang=${trnLang}`
      );
      if (requestId !== currentRequestId) return;

      const targetData = parseSide(page, 'orig');
      const transData = parseSide(page, 'trans');

      // Set header title (truncated)
      titleEl.textContent = targetData.title.length > 22
        ? targetData.title.slice(0, 20) + '…'
        : targetData.title;

      // Build content HTML
      let html = '';

      if (targetData.title) {
        html += `<div class="reader__chapter">${targetData.title}</div>`;
        html += `<div class="reader__chapter-trans">${transData.title}</div>`;
      }

      if (targetData.subtitle) {
        html += `<div class="reader__subchapter">${targetData.subtitle}</div>`;
        html += `<div class="reader__subchapter-trans">${transData.subtitle}</div>`;
      }

      const maxSentences = Math.min(targetData.sentences.length, transData.sentences.length, 8);
      for (let i = 0; i < maxSentences; i++) {
        const tgt = targetData.sentences[i];
        const tr = transData.sentences[i];
        html += `<div class="reader__pair">`;
        html += `<p class="reader__en" data-line="${i}">${renderWords(tgt.words, 'reader__word')}</p>`;
        html += `<p class="reader__trans" data-line="${i}">${renderWords(tr.words, 'reader__trans-word')}</p>`;
        html += `</div>`;
      }

      container.innerHTML = html;

      // Load word-level alignments (v2): alignments[blockIdx][sentIdx] is a list
      // of [origTokenIdx, transTokenIdx] pairs, token indices global within the
      // block, the same space parseSide records as tokenOffset.
      let alignments = null;
      try {
        const alignRes = await fetchJson(
          `${BACKEND}/books2/${BOOK}/align?page=0&orig_lang=${tgtLang}&target_lang=${trnLang}`
        );
        alignments = alignRes.alignments;
      } catch (e) {
        console.warn('ReaderDemo: alignments unavailable', e);
      }
      if (requestId !== currentRequestId) return;

      // Show listen button and start animation
      if (listenBtn) listenBtn.style.display = '';
      startFingerAnimation(targetData.sentences, transData.sentences, alignments, maxSentences, requestId);
    } catch (e) {
      if (requestId !== currentRequestId) return;
      console.error('ReaderDemo: failed to load book data', e);
    }
  }

  function startFingerAnimation(targetSentences, transSentences, alignments, count, requestId) {
    const isStale = () => requestId !== currentRequestId;
    const lines = document.querySelectorAll('#readerContent .reader__en[data-line]');
    const transLines = document.querySelectorAll('#readerContent .reader__trans[data-line]');
    const container = document.getElementById('readerContent');
    const finger = document.getElementById('readerFinger');
    const reader = document.getElementById('readerRoot');
    if (!lines.length || !container) return;

    const WORD_DELAY = 300;
    const LINE_PAUSE = 500;
    const TAP_HIGHLIGHT_DURATION = 1800;

    // Pick tap word indices: every 5-6 words, prefer words >= 5 chars
    function pickTapWordIndices(words) {
      const indices = [];
      let nextEligible = 3;
      for (let i = nextEligible; i < words.length; i++) {
        if (i < nextEligible) continue;
        const wordText = words[i].textContent || '';
        if (wordText.length >= 5) {
          indices.push(i);
          nextEligible = i + 5 + Math.floor(Math.random() * 2);
        }
      }
      return indices;
    }

    function positionFinger(wordEl, mode) {
      const rect = wordEl.getBoundingClientRect();
      const readerRect = reader.getBoundingClientRect();
      // The phone may be CSS-transform-scaled (store screenshots). getBoundingClientRect
      // returns scaled screen px, but finger.style.top/left live in the reader's own
      // (unscaled) coordinate space, normalize by the scale so they line up.
      const scale = (readerRect.width / reader.offsetWidth) || 1;
      const wx = (rect.left - readerRect.left) / scale;
      const wy = (rect.top - readerRect.top) / scale;
      const ww = rect.width / scale;
      const wh = rect.height / scale;
      const clampL = (v) => Math.max(0, Math.min(v, reader.offsetWidth - 24));
      finger.classList.toggle('is-above', mode === 'above');
      finger.classList.toggle('is-tap-pose', mode === 'angled');
      let top, left;
      if (mode === 'above') {
        // Sit above the word, fingertip (flipped) pointing down at it; the body
        // extends up into the gap, never onto the translation line below.
        left = clampL(wx + ww / 2 - 6);
        top = Math.max(2, wy - 30);
      } else if (mode === 'angled') {
        // Small angled hand touching the word from below; body swings down-right.
        left = clampL(wx + ww / 2 - 4);
        top = wy + wh * 0.7;
      } else {
        const maxTop = reader.offsetHeight * 0.85;
        left = clampL(wx + ww / 2 - 6);
        top = Math.min(wy + wh * 0.5, maxTop);
      }
      finger.style.top = top + 'px';
      finger.style.left = left + 'px';
    }

    function scrollToLine(line) {
      const pair = line.closest('.reader__pair');
      if (!pair) return;
      const pairBottom = pair.offsetTop + pair.offsetHeight - container.offsetTop;
      const visibleBottom = container.scrollTop + container.clientHeight;
      if (pairBottom > visibleBottom) {
        const top = pair.offsetTop - container.offsetTop - 20;
        container.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      }
    }

    function getTransIndices(sentenceIdx, wordIdx) {
      if (!alignments) return [];
      const sent = targetSentences[sentenceIdx];
      const transSent = transSentences[sentenceIdx];
      if (!sent || !transSent) return [];
      const blockAlign = alignments[sent.blockIdx];
      if (!blockAlign) return [];
      const sentAlign = blockAlign[sent.sentIdx];
      if (!sentAlign) return [];
      const origTok = sent.tokenOffset + wordIdx;
      const out = [];
      for (const pair of sentAlign) {
        if (pair[0] === origTok) {
          const within = pair[1] - transSent.tokenOffset;
          if (within >= 0 && within < transSent.words.length) out.push(within);
        }
      }
      return out;
    }

    // Screenshot mode: freeze on a representative frame and bail out.
    if (STILL) {
      let li = Math.min(1, lines.length - 1);
      let wi;
      // If a specific tap word was requested, find it across the visible lines.
      if (STILL_TAP_WORD) {
        const norm = (s) => (s || '').toLowerCase().replace(/[^\p{L}]/gu, '');
        for (let l = 0; l < lines.length && wi === undefined; l++) {
          const ws = lines[l].querySelectorAll('.reader__word');
          for (let i = 0; i < ws.length; i++) {
            if (norm(ws[i].textContent) === STILL_TAP_WORD) { li = l; wi = i; break; }
          }
        }
      }
      const line = lines[li];
      const transLine = transLines[li];
      const words = line.querySelectorAll('.reader__word');
      const transWords = transLine ? transLine.querySelectorAll('.reader__trans-word') : [];
      if (wi === undefined) {
        const taps = pickTapWordIndices(words);
        wi = taps.length ? taps[0] : Math.min(3, words.length - 1);
      }
      const wordEl = words[wi];
      // Highlights don't depend on layout, apply immediately.
      line.classList.add('is-reading');
      if (wordEl) {
        wordEl.classList.add('is-tapped');
        for (const ti of getTransIndices(li, wi)) {
          if (transWords[ti]) transWords[ti].classList.add('is-trans-highlighted');
        }
      }
      // Position the finger only AFTER the web font has loaded and the layout
      // has settled, otherwise the text reflows down and the finger lands on
      // the wrong line. Signal readiness once it's correctly placed.
      const placeFinger = () => {
        if (wordEl) { positionFinger(wordEl, FINGER_MODE); finger.classList.add('is-visible'); }
        (window as any).__shotReady = true;
      };
      const fontsReady = (document as any).fonts?.ready || Promise.resolve();
      fontsReady.then(() => requestAnimationFrame(() => requestAnimationFrame(placeFinger)));
      return;
    }

    let lineIdx = 0;

    function readLine() {
      if (isStale()) return;
      const line = lines[lineIdx];
      const transLine = transLines[lineIdx];
      const words = line.querySelectorAll('.reader__word');
      const transWords = transLine ? transLine.querySelectorAll('.reader__trans-word') : [];
      const tapWordIndices = pickTapWordIndices(words);

      line.classList.add('is-reading');
      scrollToLine(line);

      let wordIdx = 0;
      let tapping = false;

      function moveToWord() {
        if (isStale()) return;
        if (wordIdx >= words.length) {
          finger.classList.remove('is-visible');
          setTimeout(() => {
            if (isStale()) return;
            line.classList.remove('is-reading');
            lineIdx++;
            if (lineIdx >= count) {
              lineIdx = 0;
              container.scrollTo({ top: 0, behavior: 'smooth' });
              setTimeout(readLine, 1000);
            } else {
              readLine();
            }
          }, LINE_PAUSE);
          return;
        }

        const wordEl = words[wordIdx];
        positionFinger(wordEl);
        finger.classList.add('is-visible');

        if (tapWordIndices.includes(wordIdx) && !tapping) {
          tapping = true;
          const transIdxs = getTransIndices(lineIdx, wordIdx);
          setTimeout(() => {
            if (isStale()) return;
            finger.classList.add('is-tapping');
            setTimeout(() => { if (!isStale()) finger.classList.remove('is-tapping'); }, 500);
            // Highlight after finger presses down
            setTimeout(() => {
              if (isStale()) return;
              wordEl.classList.add('is-tapped');
              for (const ti of transIdxs) {
                if (transWords[ti]) transWords[ti].classList.add('is-trans-highlighted');
              }
            }, 250);
            // Hold, then clear and continue
            setTimeout(() => {
              if (isStale()) return;
              wordEl.classList.remove('is-tapped');
              for (const ti of transIdxs) {
                if (transWords[ti]) transWords[ti].classList.remove('is-trans-highlighted');
              }
              tapping = false;
              wordIdx++;
              moveToWord();
            }, 250 + TAP_HIGHLIGHT_DURATION);
          }, 1100);
          return;
        }

        wordIdx++;
        setTimeout(moveToWord, WORD_DELAY);
      }

      moveToWord();
    }

    // First reveal waits for the phone to enter viewport; reloads run immediately.
    const demoEl = document.querySelector('.reader-demo');
    if (hasRevealed || !demoEl || !('IntersectionObserver' in window)) {
      hasRevealed = true;
      readLine();
      return;
    }
    const io = new IntersectionObserver((entries, obs) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          obs.disconnect();
          if (isStale()) return;
          hasRevealed = true;
          readLine();
          break;
        }
      }
    }, { threshold: 0.35 });
    io.observe(demoEl);
  }

  // Expose a reload hook for FeaturesSlider's inline language dropdown.
  // Reloading keeps targetLang (the book language) but swaps the translation language.
  window.__lingoseven_reloadReader = function (newTrnLang) {
    loadAndRender(INITIAL_TGT, newTrnLang);
  };

  loadAndRender(INITIAL_TGT, INITIAL_TRN);
</script>
