---
// Interactive parallel reader demo — loads real book content via the books2 API.
// Uses the V2 page format (text + sentence/token offsets) and the /align endpoint
// for word-level mappings used by the tap-highlight animation.
interface Props {
  targetLang?: string;
  uiLang?: string;
}
const { targetLang = 'de', uiLang = 'en' } = Astro.props;
---

<div class="reader-demo" data-target-lang={targetLang} data-ui-lang={uiLang}>
  <div class="reader-demo__phone-wrap">
    <img src="/images/phone-clean.svg" alt="" class="reader-demo__shell" />
    <div class="reader-demo__frame">
      <div class="reader" id="readerRoot">
        <!-- Header -->
        <div class="reader__header">
          <span class="reader__back">&#8249;</span>
          <span class="reader__title" id="readerTitle">Loading…</span>
          <button class="reader__listen is-active" style="display:none">
            <span class="reader__eq">
              <span class="reader__eq-bar"></span>
              <span class="reader__eq-bar"></span>
              <span class="reader__eq-bar"></span>
              <span class="reader__eq-bar"></span>
            </span>
            Reading…
          </button>
        </div>

        <!-- Content (filled dynamically) -->
        <div class="reader__content" id="readerContent">
          <div class="reader__loading" id="readerLoading">Loading...</div>
        </div>

        <!-- Page footer -->
        <div class="reader__footer">
          <span class="reader__page">&#8249;</span>
          <span class="reader__page">1 / 30</span>
          <span class="reader__page">&#8250;</span>
        </div>

        <!-- Tap finger -->
        <div class="reader__finger" id="readerFinger">
          <img src="/images/finger.svg" alt="" width="36" height="36" />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Phone wrapper */
  .reader-demo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .reader-demo__phone-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .reader-demo__shell {
    position: absolute;
    width: 332px;
    height: 645px;
    top: -2px;
    left: -6px;
    z-index: 20;
    pointer-events: none;
  }

  .reader-demo__frame {
    width: 320px;
    height: 640px;
    background: #fff;
    border-radius: 36px;
    overflow: hidden;
    position: relative;
  }

  /* Finger */
  .reader__finger {
    position: absolute;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, top 0.4s ease, left 0.4s ease;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }
  .reader__finger.is-visible { opacity: 1; }
  .reader__finger.is-tapping { animation: finger-tap 0.5s ease; }

  @keyframes finger-tap {
    0% { transform: scale(1); }
    30% { transform: scale(0.75); }
    60% { transform: scale(0.85); }
    100% { transform: scale(1); }
  }

  /* Reader */
  .reader {
    width: 100%;
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .reader__header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
  }

  .reader__back {
    font-size: 20px;
    color: #f97316;
    font-weight: 600;
    line-height: 1;
  }

  .reader__title {
    font-size: 11px;
    color: #333;
    font-weight: 500;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader__page { font-size: 11px; color: #999; }

  .reader__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid #eee;
    flex-shrink: 0;
  }

  .reader__listen {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: none;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    background: #e5e7eb;
    color: #666;
    transition: all 0.3s;
  }
  .reader__listen.is-active {
    background: #f97316;
    color: #fff;
  }

  .reader__eq {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 12px;
  }
  .reader__eq-bar {
    width: 2px;
    background: #fff;
    border-radius: 1px;
    animation: eq-bounce 1s ease-in-out infinite;
  }
  .reader__eq-bar:nth-child(1) { height: 4px; animation-delay: 0s; }
  .reader__eq-bar:nth-child(2) { height: 8px; animation-delay: 0.15s; }
  .reader__eq-bar:nth-child(3) { height: 5px; animation-delay: 0.3s; }
  .reader__eq-bar:nth-child(4) { height: 10px; animation-delay: 0.45s; }

  @keyframes eq-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  .reader__content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 14px 14px 20px;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    pointer-events: none;
  }
  .reader__content::-webkit-scrollbar { display: none; }

  .reader__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #999;
    font-size: 14px;
    font-weight: 500;
  }

  :global(.reader__chapter) {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  :global(.reader__chapter-trans) {
    font-size: 11px;
    color: #999;
    text-align: center;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  :global(.reader__subchapter) {
    font-size: 12px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 2px;
  }
  :global(.reader__subchapter-trans) {
    font-size: 10px;
    color: #999;
    text-align: center;
    margin-bottom: 14px;
    font-style: italic;
  }

  :global(.reader__pair) { margin-bottom: 10px; }

  :global(.reader__en) {
    font-size: 12px;
    line-height: 1.5;
    color: #1a1a2e;
    margin-bottom: 2px;
    transition: background 0.3s, color 0.3s;
    padding: 2px 4px;
    margin: 0 -4px 2px;
    border-radius: 4px;
  }
  :global(.reader__en.is-reading) {
    background: rgba(249, 115, 22, 0.06);
    border-radius: 4px;
  }

  :global(.reader__word.is-spoken) {
    background: rgba(249, 115, 22, 0.25);
    color: #c2410c;
    border-radius: 3px;
    padding: 1px 2px;
    margin: -1px -2px;
  }

  :global(.reader__trans) {
    font-size: 11px;
    line-height: 1.4;
    color: #aaa;
    padding: 0 4px;
  }

  :global(.reader__word.is-tapped) {
    background: #f97316;
    color: #fff;
    border-radius: 3px;
    padding: 1px 3px;
    margin: -1px -3px;
  }

  @media (max-width: 768px) {
    .reader-demo__frame {
      width: 260px;
      height: 520px;
      border-radius: 30px;
    }
    .reader-demo__shell {
      width: 272px;
      height: 530px;
      left: -5px;
      top: -2px;
    }
  }

  :global(.reader__trans-word) {
    transition: background 0.3s, color 0.3s;
    border-radius: 3px;
    padding: 1px 2px;
    margin: -1px -2px;
  }
  :global(.reader__trans-word.is-trans-highlighted) {
    background: rgba(249, 115, 22, 0.2);
    color: #c2410c;
    border-radius: 3px;
  }
</style>

<script>
  const BACKEND = 'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api';
  const BOOK = 'summary_11_A';
  const PAGE = 0;
  const MAX_RENDERED_ROWS = 8;

  const readerRoot = document.querySelector<HTMLElement>('.reader-demo');
  const TGT = readerRoot?.dataset.targetLang || 'de';
  const TRN = readerRoot?.dataset.uiLang || 'en';

  // ── V2 types ──
  // TokenV2  : { s, e, b?, i? }              offsets into block.text
  // SentenceV2: { s, e }                      offsets into block.text
  // BlockV2   : { style, text, sentences[], tokens[] }
  // PairV2    : { orig: BlockV2, trans: BlockV2 }
  // /page     → { blocks: PairV2[], generated? }
  // /align    → { type, alignments[blockIdx][sentenceIdx] = [[origTokIdx, transTokIdx], ...] }

  // ── Helpers ──

  function tokenText(block, tok) {
    return block.text.slice(tok.s, tok.e);
  }

  /** Return global token-index range [start, end) for tokens within sentence `sentIdx` of block. */
  function tokenRangeForSentence(block, sentIdx) {
    const sent = block.sentences[sentIdx];
    if (!sent) return [0, 0];
    let start = -1;
    let end = block.tokens.length;
    for (let i = 0; i < block.tokens.length; i++) {
      const t = block.tokens[i];
      if (t.s >= sent.s && t.e <= sent.e) {
        if (start === -1) start = i;
      } else if (start !== -1) {
        end = i;
        break;
      }
    }
    return start === -1 ? [0, 0] : [start, end];
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  /**
   * Render a slice of block.text [textStart, textEnd) as HTML, wrapping each token
   * in a span and emitting any inter-token chars (punctuation, whitespace) as plain
   * text. Token offsets in the slice are global (block.tokens index).
   */
  function renderRange(block, startTokenIdx, endTokenIdx, cssClass, blockIdx, textStart, textEnd) {
    const parts = [];
    let cursor = textStart;
    for (let i = startTokenIdx; i < endTokenIdx; i++) {
      const tok = block.tokens[i];
      if (tok.s > cursor) parts.push(escapeHtml(block.text.slice(cursor, tok.s)));
      let cls = cssClass;
      if (tok.b) cls += ' is-bold';
      if (tok.i) cls += ' is-italic';
      parts.push(`<span class="${cls}" data-block="${blockIdx}" data-token="${i}">${escapeHtml(tokenText(block, tok))}</span>`);
      cursor = tok.e;
    }
    if (cursor < textEnd) parts.push(escapeHtml(block.text.slice(cursor, textEnd)));
    return parts.join('');
  }

  async function fetchJson(url) {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`${url} → ${res.status}`);
    return res.json();
  }

  // ── Main load + render ──

  async function loadAndRender() {
    const container = document.getElementById('readerContent');
    const titleEl = document.getElementById('readerTitle');
    if (!container) return;

    try {
      const pageData = await fetchJson(
        `${BACKEND}/books2/${BOOK}/page?page=${PAGE}&orig_lang=${TGT}&target_lang=${TRN}`
      );
      const pairs = pageData.blocks || [];
      if (!pairs.length) throw new Error('empty page');

      // Pick title (first h1) and subtitle (next h2/h3) for the phone header.
      let titleText = '';
      for (const pair of pairs) {
        if (pair.orig.style === 'h1') { titleText = pair.orig.text; break; }
      }
      titleEl.textContent = titleText.length > 22
        ? titleText.slice(0, 20) + '…'
        : (titleText || 'Reading');

      // Build HTML. Each block is rendered fully (one row per sentence-pair for p/quote/li,
      // one row total for header styles). Cap total rows for the compact demo view.
      let html = '';
      let rowCount = 0;
      const sentenceRows = []; // {blockIdx, sentIdx, origRange:[s,e], transRange:[s,e]}

      for (let bIdx = 0; bIdx < pairs.length && rowCount < MAX_RENDERED_ROWS; bIdx++) {
        const { orig, trans } = pairs[bIdx];
        const style = orig.style;
        const isHeader = style === 'h1' || style === 'h2' || style === 'h3';

        if (isHeader) {
          // Render header block as a single centered chapter/subchapter row.
          const origCls = style === 'h1' ? 'reader__chapter' : 'reader__subchapter';
          const transCls = style === 'h1' ? 'reader__chapter-trans' : 'reader__subchapter-trans';
          html += `<div class="${origCls}">${escapeHtml(orig.text)}</div>`;
          html += `<div class="${transCls}">${escapeHtml(trans.text)}</div>`;
          rowCount++;
          continue;
        }

        // Paragraph / quote / list / idea / desc — split into sentence rows.
        const sentCount = Math.min(orig.sentences.length, trans.sentences.length);
        for (let sIdx = 0; sIdx < sentCount && rowCount < MAX_RENDERED_ROWS; sIdx++) {
          const origRange = tokenRangeForSentence(orig, sIdx);
          const transRange = tokenRangeForSentence(trans, sIdx);
          const origSent = orig.sentences[sIdx];
          const transSent = trans.sentences[sIdx];
          html += `<div class="reader__pair" data-row="${rowCount}">`;
          html += `<p class="reader__en" data-line="${rowCount}">${renderRange(orig, origRange[0], origRange[1], 'reader__word', bIdx, origSent.s, origSent.e)}</p>`;
          html += `<p class="reader__trans" data-line="${rowCount}">${renderRange(trans, transRange[0], transRange[1], 'reader__trans-word', bIdx, transSent.s, transSent.e)}</p>`;
          html += `</div>`;
          sentenceRows.push({ blockIdx: bIdx, sentIdx: sIdx, origRange, transRange });
          rowCount++;
        }
      }

      container.innerHTML = html;

      // Fetch alignments (best-effort — animation works without them too).
      let alignments = null;
      try {
        const alignData = await fetchJson(
          `${BACKEND}/books2/${BOOK}/align?page=${PAGE}&orig_lang=${TGT}&target_lang=${TRN}`
        );
        alignments = alignData.alignments;
      } catch (e) {
        console.warn('ReaderDemo: align unavailable', e);
      }

      // Show listen indicator and start animation.
      const listenBtn = document.querySelector<HTMLElement>('.reader__listen');
      if (listenBtn) listenBtn.style.display = '';
      startFingerAnimation(sentenceRows, alignments);
    } catch (e) {
      console.error('ReaderDemo: failed to load book data', e);
    }
  }

  // ── Animation (finger tapping word-by-word with mapping highlights) ──

  function startFingerAnimation(sentenceRows, alignments) {
    const lines = document.querySelectorAll<HTMLElement>('#readerContent .reader__en[data-line]');
    const transLines = document.querySelectorAll<HTMLElement>('#readerContent .reader__trans[data-line]');
    const container = document.getElementById('readerContent');
    const finger = document.getElementById('readerFinger');
    const reader = document.getElementById('readerRoot');
    if (!lines.length || !container || !sentenceRows.length) return;

    const WORD_DELAY = 300;
    const LINE_PAUSE = 500;
    const TAP_HIGHLIGHT_DURATION = 1800;

    function pickTapWordIndices(words) {
      const indices = [];
      let nextEligible = 3;
      for (let i = nextEligible; i < words.length; i++) {
        if (i < nextEligible) continue;
        const wordText = words[i].textContent || '';
        if (wordText.length >= 5) {
          indices.push(i);
          nextEligible = i + 5 + Math.floor(Math.random() * 2);
        }
      }
      return indices;
    }

    function positionFinger(wordEl) {
      const rect = wordEl.getBoundingClientRect();
      const readerRect = reader.getBoundingClientRect();
      const maxTop = readerRect.height * 0.85;
      const top = Math.min(rect.top - readerRect.top + rect.height * 0.5, maxTop);
      const left = Math.max(0, Math.min(
        rect.left - readerRect.left + rect.width / 2 - 6,
        readerRect.width - 40
      ));
      finger.style.top = top + 'px';
      finger.style.left = left + 'px';
    }

    function scrollToLine(line) {
      const pair = line.closest('.reader__pair');
      if (!pair) return;
      const pairBottom = pair.offsetTop + pair.offsetHeight - container.offsetTop;
      const visibleBottom = container.scrollTop + container.clientHeight;
      if (pairBottom > visibleBottom) {
        const top = pair.offsetTop - container.offsetTop - 20;
        container.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      }
    }

    /**
     * Given a tap on an orig word, find which trans token spans should be highlighted.
     * Token indices in alignments are global within the block.
     */
    function getAlignedTransTokenIdxs(rowIdx, origWordPos) {
      if (!alignments) return [];
      const row = sentenceRows[rowIdx];
      if (!row) return [];
      const pairs = alignments[row.blockIdx]?.[row.sentIdx];
      if (!pairs) return [];
      const origGlobal = row.origRange[0] + origWordPos;
      return pairs
        .filter(p => p[0] === origGlobal)
        .map(p => p[1]);
    }

    let lineIdx = 0;

    function readLine() {
      const line = lines[lineIdx];
      const transLine = transLines[lineIdx];
      const words = line.querySelectorAll<HTMLElement>('.reader__word');
      const transWords = transLine ? transLine.querySelectorAll<HTMLElement>('.reader__trans-word') : [];
      const tapWordIndices = pickTapWordIndices(words);
      const row = sentenceRows[lineIdx];

      line.classList.add('is-reading');
      scrollToLine(line);

      let wordIdx = 0;
      let tapping = false;

      function moveToWord() {
        if (wordIdx >= words.length) {
          finger.classList.remove('is-visible');
          setTimeout(() => {
            line.classList.remove('is-reading');
            lineIdx++;
            if (lineIdx >= sentenceRows.length) {
              lineIdx = 0;
              container.scrollTo({ top: 0, behavior: 'smooth' });
              setTimeout(readLine, 1000);
            } else {
              readLine();
            }
          }, LINE_PAUSE);
          return;
        }

        const wordEl = words[wordIdx];
        positionFinger(wordEl);
        finger.classList.add('is-visible');

        if (tapWordIndices.includes(wordIdx) && !tapping) {
          tapping = true;
          // Map this orig word's position-in-sentence to global token idx, then alignments.
          const transTokenIdxs = getAlignedTransTokenIdxs(lineIdx, wordIdx);
          const transWordPositions = row
            ? transTokenIdxs
                .map(globalIdx => globalIdx - row.transRange[0])
                .filter(pos => pos >= 0 && pos < transWords.length)
            : [];
          setTimeout(() => {
            finger.classList.add('is-tapping');
            setTimeout(() => finger.classList.remove('is-tapping'), 500);
            setTimeout(() => {
              wordEl.classList.add('is-tapped');
              for (const pos of transWordPositions) {
                transWords[pos]?.classList.add('is-trans-highlighted');
              }
            }, 250);
            setTimeout(() => {
              wordEl.classList.remove('is-tapped');
              for (const pos of transWordPositions) {
                transWords[pos]?.classList.remove('is-trans-highlighted');
              }
              tapping = false;
              wordIdx++;
              moveToWord();
            }, 250 + TAP_HIGHLIGHT_DURATION);
          }, 1100);
          return;
        }

        wordIdx++;
        setTimeout(moveToWord, WORD_DELAY);
      }

      moveToWord();
    }

    // Start only when the phone scrolls into view.
    const demoEl = document.querySelector('.reader-demo');
    if (!demoEl || !('IntersectionObserver' in window)) {
      readLine();
      return;
    }
    const io = new IntersectionObserver((entries, obs) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          obs.disconnect();
          readLine();
          break;
        }
      }
    }, { threshold: 0.35 });
    io.observe(demoEl);
  }

  loadAndRender();
</script>
