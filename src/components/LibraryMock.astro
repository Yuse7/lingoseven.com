---
// LibraryMock, static phone screen showing the in-app book catalog, for store
// screenshots. Mirrors the real app catalog: header with profile/search, a big
// "Upload your own book" CTA, Catalog/All books tabs, and horizontally-scrolling
// shelves (World bestsellers, Short stories, Golden collection) built from real
// S3 cover art. UI chrome is localized to the listing language, rendered in
// English server-side, re-localized client-side from the URL `ui` param (see
// screenshotMocks.ts). Cover ids are language-independent. Sets __shotReady once
// the visible covers have loaded.
import { mockUi } from '../data/screenshotMocks';
const cover = (id: string) => `https://lingo7.s3.eu-central-1.amazonaws.com/covers/250x250/${id}.webp`;
const m = mockUi('en');
---

<div class="lib-demo">
  <div class="lib-demo__phone-wrap">
    <img src="/images/phone-clean.svg" alt="" class="lib-demo__shell" />
    <div class="lib-demo__frame">
      <div class="lib-screen">
        <div class="lib-screen__head">
          <span class="lib-screen__title">{m.libTitle}</span>
          <div class="lib-screen__actions">
            <span class="lib-iconbtn" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#5b6577" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
            </span>
            <span class="lib-iconbtn" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#5b6577" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </span>
          </div>
        </div>

        <div class="lib-screen__scroll">
          <button class="lib-upload">
            <span class="lib-upload__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#0f2417" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </span>
            <span class="lib-upload__label">{m.upload}</span>
          </button>

          <div class="lib-tabs">
            {m.tabs.map((t, i) => <span class={`lib-tab ${i === 0 ? 'is-active' : ''}`}>{t}</span>)}
          </div>

          {m.sections.map((sec) => (
            <div class="lib-section">
              <div class="lib-section__head">
                <span class="lib-section__title">{sec.title}</span>
                {sec.sub && <span class="lib-section__sub">{sec.sub}</span>}
              </div>
              <div class="lib-shelf">
                {sec.ids.map((id) => (
                  <img class="lib-shelf__cover" src={cover(id)} alt="" width="92" height="130" loading="eager" />
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="lib-screen__nav">
          {m.nav.map((label, i) => (
            <span class={`lib-nav ${i === 0 ? 'is-active' : ''}`}>
              <svg viewBox="0 0 24 24"><path d="M4 19V5h6v14H4zm10 0V5h6v14h-6z"/></svg>
              <span class="lib-nav__label">{label}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .lib-demo { display: flex; justify-content: center; align-items: center; }
  .lib-demo__phone-wrap { position: relative; display: flex; flex-direction: column; align-items: center; }
  .lib-demo__shell { position: absolute; width: 332px; height: 645px; top: -2px; left: -6px; z-index: 20; pointer-events: none; }
  .lib-demo__frame { width: 320px; height: 640px; background: #fff; border-radius: 36px; overflow: hidden; position: relative; }

  .lib-screen {
    width: 100%; height: 100%; background: #f6f7f9; display: flex; flex-direction: column;
    font-family: 'Inter', sans-serif; overflow: hidden;
  }

  .lib-screen__head {
    display: flex; align-items: center; justify-content: space-between;
    background: #fff; padding: 16px 16px 12px; border-bottom: 1px solid #eef0f3; flex-shrink: 0;
  }
  .lib-screen__title { font-size: 22px; font-weight: 800; color: #1a1a2e; letter-spacing: -0.4px; }
  .lib-screen__actions { display: flex; gap: 8px; }
  .lib-iconbtn { width: 34px; height: 34px; border-radius: 50%; background: #f0f2f5; display: inline-flex; align-items: center; justify-content: center; }
  .lib-iconbtn svg { width: 18px; height: 18px; }

  .lib-screen__scroll { flex: 1; overflow: hidden; padding: 12px 0 4px; display: flex; flex-direction: column; gap: 13px; }

  .lib-upload {
    margin: 0 16px; padding: 12px 16px; border: none; border-radius: 14px; background: #4ade80;
    display: flex; align-items: center; justify-content: center; gap: 9px;
    font-family: inherit; font-size: 14px; font-weight: 800; color: #0f2417;
    box-shadow: 0 6px 16px rgba(74,222,128,0.35);
  }
  .lib-upload__icon { display: inline-flex; }
  .lib-upload__icon svg { width: 18px; height: 18px; }

  .lib-tabs { display: flex; gap: 8px; margin: 0 16px; padding: 4px; background: #eceef2; border-radius: 12px; }
  .lib-tab { flex: 1; text-align: center; padding: 8px 0; border-radius: 9px; font-size: 12px; font-weight: 700; color: #7a8395; }
  .lib-tab.is-active { background: #fff; color: #1a1a2e; box-shadow: 0 1px 3px rgba(20,30,50,0.1); }

  .lib-section { display: flex; flex-direction: column; gap: 9px; }
  .lib-section__head { display: flex; align-items: baseline; gap: 8px; padding: 0 16px; }
  .lib-section__title { font-size: 15px; font-weight: 800; color: #1a1a2e; }
  .lib-section__sub { font-size: 11px; font-weight: 600; color: #8b93a1; white-space: nowrap; }

  .lib-shelf { display: flex; gap: 11px; padding: 0 16px; overflow: hidden; }
  .lib-shelf__cover {
    width: 84px; height: 119px; flex-shrink: 0; border-radius: 9px; object-fit: cover;
    background: #e9edf2; box-shadow: 0 4px 12px rgba(20,30,50,0.14);
  }

  .lib-screen__nav {
    display: flex; justify-content: space-around; align-items: center; background: #fff;
    border-top: 1px solid #eef0f3; padding: 8px 4px 10px; flex-shrink: 0;
  }
  .lib-nav { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 8px; font-weight: 600; color: #aab1bd; }
  .lib-nav svg { width: 18px; height: 18px; fill: #aab1bd; stroke: #aab1bd; }
  .lib-nav.is-active { color: #f97316; }
  .lib-nav.is-active svg { fill: #f97316; stroke: #f97316; }
</style>

<script>
  import { mockUi } from '../data/screenshotMocks';

  const root = document.querySelector('.lib-demo');
  if (root) {
    const ui = new URLSearchParams(location.search).get('ui') || 'en';
    const m = mockUi(ui);
    const set = (sel, txt) => { const el = root.querySelector(sel); if (el && txt != null) el.textContent = txt; };

    set('.lib-screen__title', m.libTitle);
    set('.lib-upload__label', m.upload);
    root.querySelectorAll('.lib-tab').forEach((el, i) => { if (m.tabs[i]) el.textContent = m.tabs[i]; });
    root.querySelectorAll('.lib-section').forEach((sec, i) => {
      const s = m.sections[i];
      if (!s) return;
      const t = sec.querySelector('.lib-section__title'); if (t) t.textContent = s.title;
      const sub = sec.querySelector('.lib-section__sub'); if (sub) sub.textContent = s.sub;
    });
    root.querySelectorAll('.lib-nav__label').forEach((el, i) => { if (m.nav[i]) el.textContent = m.nav[i]; });

    const ready = () => { (window as any).__shotReady = true; };
    if (document.readyState === 'complete') ready();
    else window.addEventListener('load', ready);
    setTimeout(ready, 6000);
  }
</script>
