---
interface Props {
  targetLangName: string;
  targetLangNamePrep?: string;
  targetLangNameGen?: string;
  translations: Record<string, any>;
}
const { targetLangName, targetLangNamePrep = '', targetLangNameGen = '', translations } = Astro.props;

function t(key: string): string {
  const val = translations[key] || key;
  return val
    .replace(/{targetLang}/g, targetLangName)
    .replace(/{targetLangPrep}/g, targetLangNamePrep || targetLangName)
    .replace(/{targetLangGen}/g, targetLangNameGen || targetLangName);
}

// Like t(), but highlights the target-language name in the accent (green) color.
function tAccent(key: string): string {
  const val = translations[key] || key;
  return val
    .replace(/{targetLang}/g, `<span class="hero-lang-accent">${targetLangName}</span>`)
    .replace(/{targetLangPrep}/g, `<span class="hero-lang-accent">${targetLangNamePrep || targetLangName}</span>`)
    .replace(/{targetLangGen}/g, `<span class="hero-lang-accent">${targetLangNameGen || targetLangName}</span>`);
}
---

<section class="hero hero-split">
  <div class="container">
    <div class="hero-split-content">
      <div class="hero-text">
        <div class="hero-pill">
          <span class="hero-pill-dot"></span>
          {t('learn_hero_pill')}
        </div>
        <h1 class="hero-title-modern" set:html={tAccent('hero_title')}></h1>
        <div class="hero-badges">
          <a href="#features" class="hero-badge badge-green" data-highlight-color="rgba(74, 222, 128, 0.22)">{t('features_slider_tag')}</a>
          <a href="#audio" class="hero-badge badge-amber" data-highlight-color="rgba(251, 191, 36, 0.22)">{t('audio_tag')}</a>
          <a href="#adaptation" class="hero-badge badge-purple" data-highlight-color="rgba(165, 180, 252, 0.22)">{t('library_super_visual_easy')}</a>
        </div>
        <div class="hero-cta">
          <a href="https://apps.apple.com/app/id6471030440" class="btn btn-primary btn-large">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
            <div class="btn-text">
              <span class="btn-small">{t('download_on')}</span>
              <span class="btn-big">{t('app_store')}</span>
            </div>
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.doublereading" class="btn btn-outline btn-large">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.24-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.56.69.56 1.19s-.22.92-.56 1.19l-2.11 1.24-2.5-2.5 2.5-2.5 2.11 1.38M6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49z" />
            </svg>
            <div class="btn-text">
              <span class="btn-small">{t('get_it_on')}</span>
              <span class="btn-big">{t('google_play')}</span>
            </div>
          </a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/pic.png" alt="Lingo7, language learning app with parallel reading" class="hero-mascot-split" width="600" height="785" fetchpriority="high" decoding="async">
      </div>
    </div>
  </div>
</section>

<style>
  /* Injected via set:html, so it must be global to take effect.
     Flowing gradient (gradient-flow keyframe lives in global.css). */
  :global(.hero-title-modern .hero-lang-accent) {
    background: linear-gradient(100deg, #86efac, #4ade80, #22d3ee, #4ade80, #86efac);
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradient-flow 7s ease infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero-title-modern .hero-lang-accent) {
      animation: none;
    }
  }

  .hero-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 12px;
    margin-bottom: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.18s ease, filter 0.18s ease, box-shadow 0.18s ease;
  }

  .hero-badge:hover {
    transform: translateY(-2px);
    filter: brightness(1.18);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
  }

  .hero-badge:active {
    transform: translateY(0);
  }

  .hero-badge:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .hero-badge::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .badge-purple {
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
  }

  .badge-purple::before {
    background: #a5b4fc;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
  }

  .badge-amber {
    background: rgba(251, 191, 36, 0.15);
    color: #fcd34d;
  }

  .badge-amber::before {
    background: #fcd34d;
    box-shadow: 0 0 0 4px rgba(251, 191, 36, 0.15);
  }

  .badge-green {
    background: rgba(74, 222, 128, 0.15);
    color: #4ade80;
  }

  .badge-green::before {
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.15);
  }

  @media (max-width: 768px) {
    .hero-badges {
      justify-content: center;
    }
    .hero-badge {
      font-size: 0.75rem;
      padding: 7px 14px;
    }
  }
</style>

<script>
  const badges = document.querySelectorAll<HTMLAnchorElement>('.hero-badges .hero-badge');
  badges.forEach((badge) => {
    badge.addEventListener('click', () => {
      const href = badge.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const section = document.querySelector<HTMLElement>(href);
      if (!section) return;
      const target = section.querySelector<HTMLElement>(':scope > .container') || section;
      const color = badge.dataset.highlightColor;
      if (color) target.style.setProperty('--highlight-color', color);
      target.classList.remove('section-highlight');
      void target.offsetWidth; // restart animation
      target.classList.add('section-highlight');
      window.setTimeout(() => target.classList.remove('section-highlight'), 1900);
    });
  });
</script>
