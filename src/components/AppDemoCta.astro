---
// App CTA card with the live reader demo: copy + small store links + rating
// on the left, a scaled-down ReaderDemo phone on the right. Same pattern as
// the blog early CTA (BlogLayout .book-list-cta), extracted for reuse on
// compare, best-apps, home and the blog listing.
// A `{uiLang}` placeholder in `title` or `text` becomes the inline
// translation-language dropdown (same pattern as the learn pages' H2 one) and
// the ReaderDemo's own picker is turned off; without a placeholder the widget
// keeps its own picker above the phone (e.g. the localized blog listing).
// Max one per page: ReaderDemo's script binds to the first `.reader-demo`.
import InlineLangMenu from './InlineLangMenu.astro';
import InlineLangTrigger from './InlineLangTrigger.astro';
import ReaderDemo from './ReaderDemo.astro';
import StoreLinksRow from './StoreLinksRow.astro';
import { getEnabledLanguages } from '../data/languages';
import { languageNames } from '../data/languageNames';

interface Props {
  /** May carry one `{uiLang}` placeholder for the inline language dropdown. */
  title: string;
  /** Same `{uiLang}` treatment; the title's placeholder wins if both have one. */
  text: string;
  /** Language of the demo book (the language being learned). */
  targetLang?: string;
  /** Translation language shown under each sentence. */
  uiLang?: string;
}
const { title, text, targetLang = 'de', uiLang = 'en' } = Astro.props;
// A same-language pair would render a degenerate demo (book and translation
// identical), e.g. the English page of a per-language cluster; shift the
// translation side instead.
const trnLang = uiLang === targetLang ? (targetLang === 'en' ? 'es' : 'en') : uiLang;

const PLACEHOLDER = '{uiLang}';
const titleIdx = title.indexOf(PLACEHOLDER);
const textIdx = titleIdx < 0 ? text.indexOf(PLACEHOLDER) : -1;
const hasInlinePicker = titleIdx >= 0 || textIdx >= 0;

const trnLangName =
  languageNames[uiLang]?.[trnLang] ?? languageNames['en']?.[trnLang] ?? trnLang;
// The book language itself would make a degenerate pair, so it is not offered.
const dropdownLanguages = hasInlinePicker
  ? getEnabledLanguages()
      .filter((lang) => lang.code !== targetLang)
      .map((lang) => ({
        code: lang.code,
        name: languageNames[uiLang]?.[lang.code] ?? languageNames['en']?.[lang.code] ?? lang.name,
      }))
      .sort((a, b) => a.name.localeCompare(b.name, uiLang))
  : [];
---

<aside class="app-demo-cta">
  <div class="adc-copy">
    <h2 class="adc-title">
      {titleIdx >= 0
        ? <>{title.slice(0, titleIdx)}<InlineLangTrigger name={trnLangName} />{title.slice(titleIdx + PLACEHOLDER.length)}</>
        : title}
    </h2>
    <p class="adc-text">
      {textIdx >= 0
        ? <>{text.slice(0, textIdx)}<InlineLangTrigger name={trnLangName} />{text.slice(textIdx + PLACEHOLDER.length)}</>
        : text}
    </p>
    {hasInlinePicker && <InlineLangMenu languages={dropdownLanguages} current={trnLang} />}
    <StoreLinksRow />
  </div>
  <div class:list={['adc-demo', !hasInlinePicker && 'adc-demo--picker']}>
    <ReaderDemo targetLang={targetLang} uiLang={trnLang} langPicker={!hasInlinePicker} menuLang={uiLang} />
  </div>
</aside>

<script>
  import { initInlineLangPicker } from '../scripts/inlineLangPicker';
  document.querySelectorAll('.app-demo-cta').forEach((el) => initInlineLangPicker(el as HTMLElement));
</script>

<style>
  .app-demo-cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px 32px;
    align-items: center;
    max-width: 860px;
    margin: 3rem auto 0;
    padding: 24px;
    background: var(--background-card, #2a3649);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    border-radius: var(--radius, 12px);
    text-align: left;
  }

  /* Anchors the InlineLangMenu dropdown. */
  .adc-copy {
    position: relative;
  }

  /* The ReaderDemo phone is 320x640; scale it down without leaving layout gaps
     (transform keeps the layout box, the negative margins reclaim it). */
  .adc-demo {
    transform: scale(0.8);
    transform-origin: center;
    margin: -64px -32px;
  }

  /* With the widget's own 40px language picker on top the box is 680px tall. */
  .adc-demo--picker {
    margin: -68px -32px;
  }

  @media (max-width: 768px) {
    .app-demo-cta {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .adc-copy {
      justify-self: stretch;
    }
    /* At this width the widget itself renders at 260x520; keep it unscaled. */
    .adc-demo {
      transform: none;
      margin: 8px 0 0;
      max-width: 100%;
    }
  }

  /* Narrow phones: give the card's content the padding back. */
  @media (max-width: 480px) {
    .app-demo-cta {
      padding: 16px;
    }
  }

  .adc-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--text, rgba(255, 255, 255, 0.9));
  }

  .adc-text {
    color: var(--text-light, rgba(255, 255, 255, 0.6));
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 16px;
  }
</style>
