---
interface Props {
  targetLangName?: string;
  translations?: Record<string, any>;
}

const { targetLangName = '', translations = {} } = Astro.props;

function t(key: string): string {
  const val = translations[key] || key;
  return val.replace(/{targetLang}/g, targetLangName);
}

const coverUrl = (id: string) => `https://lingo7.s3.eu-central-1.amazonaws.com/covers/250x250/${id}.webp`;

interface Book {
  title: string;
  author: string;
  cover: string;
  pages: number;
}

interface Category {
  id: string;
  labelKey: string;
  icon: string;
  books: Book[];
}

