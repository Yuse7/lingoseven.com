---

<section class="library-section" id="library">
  <div class="container">
    <!-- ============================================ -->
    <!-- HERO: Read ANY book in {targetLang}            -->
    <!-- ============================================ -->
    <div class="anybook-header">
      <span class="section-tag section-tag--green">{t('library_tag')}</span>
      <h2 class="anybook-title" set:html={t('library_title')}></h2>
      <p class="anybook-subtitle">{t('library_subtitle')}</p>
    </div>

    <!-- HUGE upload feature card — the centerpiece -->
    <div class="anybook-card">
      <div class="anybook-card-border"></div>
      <div class="anybook-card-glow"></div>

      <div class="anybook-card-inner">
        <!-- Visual: stack of real covers + "your book" placeholder -->
        <div class="anybook-visual" aria-hidden="true">
          <div class="anybook-stack">
            {stackCovers.map((c) => (
              <div
                class="anybook-stack-book"
                style={`transform: translate(${c.x}px, ${c.y}px) rotate(${c.rotate}deg); z-index: ${c.z};`}
              >
                <img src={coverUrl(c.id)} alt="" loading="lazy" width="140" height="210" />
              </div>
            ))}
            <!-- "Your book" — empty slot with plus -->
            <div
              class="anybook-stack-book anybook-stack-book--user"
              style="transform: translate(95px, -22px) rotate(12deg); z-index: 4;"
            >
              <div class="anybook-stack-user-inner">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
                <span>{t('library_upload_your_book_chip')}</span>
              </div>
            </div>
          </div>

          <div class="anybook-formats-row">
            <span class="format-badge format-badge--epub">EPUB</span>
            <span class="format-badge format-badge--fb2">FB2</span>
            <span class="format-badge format-badge--txt">TXT</span>
          </div>
        </div>

        <!-- Content: headline + checklist -->
        <div class="anybook-content">
          <div class="anybook-eyebrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span>{t('library_upload_eyebrow')}</span>
          </div>
          <h3 class="anybook-headline" set:html={t('library_upload_title')}></h3>
          <p class="anybook-desc">{t('library_upload_subtitle')}</p>
          <ul class="anybook-features">
            <li>
              <span class="anybook-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span set:html={t('library_upload_feat_any')}></span>
            </li>
            <li>
              <span class="anybook-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span set:html={t('library_upload_feat_read')}></span>
            </li>
            <li>
              <span class="anybook-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span set:html={t('library_upload_feat_audio')}></span>
            </li>
            <li>
              <span class="anybook-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span set:html={t('library_upload_feat_srs')}></span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- SUPER POWER #1 — adapt to your level          -->
    <!-- ============================================ -->
    <div class="super-moment super-moment--adapt">
      <div class="super-moment-inner">
        <div class="super-moment-content">
          <span class="super-moment-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            <span>{t('library_super_tag')}</span>
          </span>
          <h3 class="super-moment-title" set:html={t('library_super2_title')}></h3>
          <p class="super-moment-desc" set:html={t('library_super2_desc')}></p>
        </div>

        <div class="super-moment-visual" aria-hidden="true">
          <div class="adapt-illu">
            <div class="adapt-page adapt-page--complex">
              <span class="adapt-page-label adapt-page-label--hard">{t('library_super_visual_hard')}</span>
              <div class="adapt-page-text">
                <div class="adapt-line adapt-line--xl"></div>
                <div class="adapt-line adapt-line--xl"></div>
                <div class="adapt-line adapt-line--l"></div>
                <div class="adapt-line adapt-line--xl"></div>
                <div class="adapt-line adapt-line--m"></div>
                <div class="adapt-line adapt-line--xl"></div>
                <div class="adapt-line adapt-line--s"></div>
              </div>
            </div>

            <div class="adapt-magic">
              <svg width="48" height="32" viewBox="0 0 48 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 16h36"/>
                <path d="M32 8l8 8-8 8"/>
              </svg>
              <div class="translate-magic-sparkle translate-magic-sparkle--1">✦</div>
              <div class="translate-magic-sparkle translate-magic-sparkle--2">✦</div>
              <div class="translate-magic-sparkle translate-magic-sparkle--3">✦</div>
            </div>

            <div class="adapt-page adapt-page--simple">
              <span class="adapt-page-label adapt-page-label--easy">{t('library_super_visual_easy')}</span>
              <div class="adapt-page-text">
                <div class="adapt-line"></div>
                <div class="adapt-line adapt-line--m"></div>
                <div class="adapt-line"></div>
                <div class="adapt-line adapt-line--s"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- SUPER POWER #2 — auto-translation             -->
    <!-- ============================================ -->
    <div class="super-moment super-moment--translate">
      <div class="super-moment-inner super-moment-inner--reversed">
        <div class="super-moment-visual" aria-hidden="true">
          <div class="translate-illu">
            <div class="translate-book translate-book--src">
              <div class="translate-book-cover">
                <span class="translate-book-flag">🌐</span>
                <div class="translate-book-lines">
                  <div class="translate-book-line"></div>
                  <div class="translate-book-line translate-book-line--short"></div>
                  <div class="translate-book-line"></div>
                  <div class="translate-book-line translate-book-line--short"></div>
                </div>
              </div>
              <span class="translate-book-label">{t('library_super_visual_any')}</span>
            </div>

            <div class="translate-magic">
              <svg width="48" height="32" viewBox="0 0 48 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 16h36"/>
                <path d="M32 8l8 8-8 8"/>
              </svg>
              <div class="translate-magic-sparkle translate-magic-sparkle--1">✦</div>
              <div class="translate-magic-sparkle translate-magic-sparkle--2">✦</div>
              <div class="translate-magic-sparkle translate-magic-sparkle--3">✦</div>
            </div>

            <div class="translate-book translate-book--tgt">
              <div class="translate-book-cover">
                <span class="translate-book-flag translate-book-flag--target">✓</span>
                <div class="translate-book-lines">
                  <div class="translate-book-line"></div>
                  <div class="translate-book-line translate-book-line--short"></div>
                  <div class="translate-book-line"></div>
                  <div class="translate-book-line translate-book-line--short"></div>
                </div>
              </div>
              <span class="translate-book-label translate-book-label--target">{targetLangName}</span>
            </div>
          </div>
        </div>

        <div class="super-moment-content">
          <span class="super-moment-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            <span>{t('library_super_tag')}</span>
          </span>
          <h3 class="super-moment-title" set:html={t('library_super1_title')}></h3>
          <p class="super-moment-desc" set:html={t('library_super1_desc')}></p>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- OR: pick from our library                     -->
    <!-- ============================================ -->
    <div class="library-or-divider">
      <span class="library-or-divider-line"></span>
      <span class="library-or-divider-text">{t('library_or_browse_eyebrow')}</span>
      <span class="library-or-divider-line"></span>
    </div>

    <div class="library-or-header">
      <h3 class="library-or-title">{t('library_or_browse_title')}</h3>
      <p class="library-or-subtitle">{t('library_or_browse_desc')}</p>
    </div>

    <!-- Category tabs -->
    <div class="library-tabs" role="tablist">
      {categories.map((cat, i) => (
        <button
          class={`library-tab ${i === 0 ? 'active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-cat={cat.id}
        >
          <span class="library-tab-icon">{cat.icon}</span>
          <span class="library-tab-label">{t(cat.labelKey)}</span>
        </button>
      ))}
    </div>

    <!-- Book carousels -->
    {categories.map((cat, i) => (
      <div class={`library-carousel ${i === 0 ? 'active' : ''}`} data-cat={cat.id}>
        <div class="library-track">
          {cat.books.map((book) => (
            <div class="book-card">
              <div class="book-cover-wrap">
                <img
                  src={book.cover}
                  alt={book.title}
                  class="book-cover"
                  loading="lazy"
                  width="140"
                  height="210"
                />
              </div>
              <div class="book-info">
                <span class="book-title">{book.title}</span>
                {book.author && <span class="book-author">{book.author}</span>}
                <span class="book-pages">{book.pages} {t('library_pages')}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- CTA -->
    <div class="library-footer">
      <p class="library-total">{t('library_total')}</p>
      <div class="hero-cta">
        <a href="https://apps.apple.com/app/id6471030440" class="btn btn-primary btn-large">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="btn-text">
            <span class="btn-small">Download on</span>
            <span class="btn-big">App Store</span>
          </div>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.doublereading" class="btn btn-outline btn-large">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.24-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.56.69.56 1.19s-.22.92-.56 1.19l-2.11 1.24-2.5-2.5 2.5-2.5 2.11 1.38M6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49z"/>
          </svg>
          <div class="btn-text">
            <span class="btn-small">Get it on</span>
            <span class="btn-big">Google Play</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.library-tab');
    const carousels = document.querySelectorAll('.library-carousel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-cat');

        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        carousels.forEach((c) => {
          c.classList.toggle('active', c.getAttribute('data-cat') === cat);
        });
      });
    });
  });
</script>

<style>
  .library-section {
    padding: 110px 0 90px;
  }

  /* ====================================================== */
  /* ANY BOOK — HERO + UPLOAD CARD                          */
  /* ====================================================== */

  .anybook-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .section-tag--green {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: rgba(74, 222, 128, 0.14);
    color: #4ade80;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .anybook-title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    margin: 18px 0 16px;
    color: #fff;
    letter-spacing: -0.03em;
  }

  .anybook-title :global(.hl) {
    background: linear-gradient(120deg, #4ade80 0%, #22c55e 50%, #0ea5e9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% 200%;
    animation: hlShift 8s ease-in-out infinite;
  }

  @keyframes hlShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .anybook-subtitle {
    font-size: 18px;
    color: var(--text-light);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ----- the BIG card ----- */
  .anybook-card {
    position: relative;
    max-width: 1080px;
    margin: 0 auto 96px;
    border-radius: 28px;
    padding: 2px;
    overflow: hidden;
  }

  .anybook-card-border {
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background: linear-gradient(135deg, #4ade80 0%, #22c55e 25%, #0ea5e9 55%, #a78bfa 100%);
    background-size: 220% 220%;
    animation: borderShift 7s ease-in-out infinite;
  }

  @keyframes borderShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .anybook-card-glow {
    position: absolute;
    inset: -40px;
    border-radius: 40px;
    background:
      radial-gradient(ellipse at 25% 50%, rgba(74, 222, 128, 0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 50%, rgba(96, 165, 250, 0.14) 0%, transparent 60%);
    filter: blur(40px);
    z-index: 0;
    pointer-events: none;
  }

  .anybook-card-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 48px;
    align-items: center;
    background: linear-gradient(135deg, #1c2638 0%, #18212f 50%, #1b2638 100%);
    border-radius: 26px;
    padding: 56px 56px 56px 48px;
    min-height: 380px;
    overflow: hidden;
  }

  /* ====================================================== */
  /* SUPER POWERS — two flagship "moments" below the card   */
  /* ====================================================== */

  .super-moment {
    max-width: 1080px;
    margin: 0 auto 96px;
    position: relative;
  }

  .super-moment-inner {
