// Featured covers shown inside the "Any book" visual.
// Each fans out at its own angle to evoke an open library shelf.
const stackCovers = [
  { id: 'summary_5', rotate: -14, x: -110, y: 18, z: 1 },
  { id: 'classic_27', rotate: -6, x: -45, y: 4, z: 2 },
  { id: 'classic2_106', rotate: 4, x: 25, y: -8, z: 3 },
