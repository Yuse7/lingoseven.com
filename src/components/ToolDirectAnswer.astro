---
// GEO direct-answer block for tool pages. A 40-60 word, definitional answer to the
// tool's core question, placed right after the hero so AI answer engines can lift it.
// Tool pages live outside [uiLang] (English-only), so the copy is passed in as English:
// `lead` is the definitional first sentence (bolded for extraction), `body` the rest.
interface Props {
  lead: string;
  body: string;
}
const { lead, body } = Astro.props;
---

<div class="tool-direct-answer">
  <span class="tda-label">Quick answer</span>
  <p><strong>{lead}</strong> {body}</p>
</div>

<style>
  .tool-direct-answer {
    max-width: 760px;
    margin: 1.5rem auto 0;
    padding: 20px 24px;
    background: var(--background-alt, #232d3f);
    border-left: 3px solid var(--primary, #4ade80);
    border-radius: 8px;
    text-align: left;
  }
  .tda-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary, #4ade80);
    margin-bottom: 8px;
  }
  .tool-direct-answer p {
    margin: 0;
    color: var(--text, rgba(255, 255, 255, 0.9));
    font-size: 1.05rem;
    line-height: 1.7;
  }
</style>
