---
import { practiceWordByLang, practiceOptionsByUi, fallbackWord, fallbackOptions } from '../data/practiceExamples';

interface Props {
  targetLangName?: string;
  targetLangNamePrep?: string;
  targetLangNameGen?: string;
  targetLang?: string;
  uiLang?: string;
  translations?: Record<string, any>;
}
const { targetLangName = '', targetLangNamePrep = '', targetLangNameGen = '', targetLang = 'en', uiLang = 'en', translations = {} } = Astro.props;

function t(key: string): string {
  const val = translations[key] || key;
  return val
    .replace(/{targetLang}/g, targetLangName)
    .replace(/{targetLangPrep}/g, targetLangNamePrep || targetLangName)
    .replace(/{targetLangGen}/g, targetLangNameGen || targetLangName);
}

const word = practiceWordByLang[targetLang] ?? fallbackWord;
const opts = practiceOptionsByUi[uiLang] ?? fallbackOptions;
// SSR default order (JS shuffles on the client). 4 options: correct + 3 distractors.
const optionListSSR = [opts.correct, opts.distractors[0], opts.distractors[1], opts.distractors[2]];

// "Spell from letters": build the ORIGINAL (target) word from scrambled tiles.
// Keep the word's own casing so it stays orthographically correct.
const spellChars = Array.from(word.word);

// Everything the client controller needs, serialized once per page.
const practiceData = {
  word: word.word,
  wordSpell: word.word,
  ipa: word.ipa,
  correct: opts.correct,
  distractors: opts.distractors,
  lang: targetLang,
};
---

<!-- Spaced Repetition Practice -->
<section id="practice" class="practice-section">
    <div class="container">
        <div class="practice-header">
            <span class="section-tag section-tag--purple">{t('practice_tag')}</span>
            <h2 set:html={t('practice_title')}></h2>
            <p class="practice-subtitle">{t('practice_subtitle')}</p>
        </div>

        <div class="practice-layout">
            <!-- Exercise tabs -->
            <div class="exercise-tabs">
                <button class="ex-tab active" data-ex="0">
                    <svg class="ex-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    {t('practice_tab_choose')}
                </button>
                <button class="ex-tab" data-ex="1">
                    <svg class="ex-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                    {t('practice_tab_listen')}
                </button>
                <button class="ex-tab" data-ex="2">
                    <svg class="ex-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/><circle cx="12" cy="6" r="3"/><circle cx="12" cy="18" r="3"/></svg>
                    {t('practice_tab_spell')}
                </button>
                <button class="ex-tab" data-ex="3">
                    <svg class="ex-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    {t('practice_tab_is_correct')}
                </button>
                <button class="ex-tab" data-ex="4">
                    <svg class="ex-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
                    {t('practice_tab_pronounce')}
                </button>
                <button class="ex-tab" data-ex="5">
                    <svg class="ex-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    {t('practice_tab_recall')}
                </button>
            </div>

            <!-- Phone mockup with exercise widgets -->
            <div class="phone-mockup">
                <div class="phone-bezel">
                    <!-- Progress bar -->
                    <div class="ex-progress">
                        <div class="ex-progress-text">{t('practice_progress_text')}</div>
                        <div class="ex-progress-bar"><div class="ex-progress-fill"></div></div>
                    </div>

                    <!-- Exercise panels -->
                    <div class="ex-panel active" data-panel="0">
                        <div class="ex-card ex-card-top">
                            <div class="ex-word-main">{word.word}</div>
                            <div class="ex-freq"><span class="freq-dot"></span><span class="freq-dot"></span><span class="freq-dot active"></span><span class="freq-dot active"></span><span class="freq-dot active"></span></div>
                        </div>
                        <div class="ex-card ex-card-bottom ex-card-teal">
                            <div class="ex-label">{t('practice_label_choose_translation')}</div>
                            <div class="ex-grid-2x2 js-options">
                                {optionListSSR.map((opt) => (
                                    <div class="ex-option">{opt}</div>
                                ))}
                            </div>
                        </div>
                        <div class="ex-action-btn ex-btn-teal js-check">{t('practice_btn_check')}</div>
                    </div>

                    <div class="ex-panel" data-panel="1">
                        <div class="ex-card ex-card-top ex-card-teal">
                            <div class="ex-label">{t('practice_label_listen')}</div>
                            <div class="ex-speaker-icon js-speak" role="button" aria-label="play">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#2DCCC2" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                            </div>
                        </div>
                        <div class="ex-card ex-card-bottom ex-card-teal">
                            <div class="ex-label">{t('practice_label_choose_translation')}</div>
                            <div class="ex-grid-2x2 js-options">
                                {optionListSSR.map((opt) => (
                                    <div class="ex-option">{opt}</div>
                                ))}
                            </div>
                        </div>
                        <div class="ex-action-btn ex-btn-teal js-check">{t('practice_btn_check')}</div>
                    </div>

                    <div class="ex-panel" data-panel="2">
                        <div class="ex-card ex-card-top">
                            <div class="ex-word-sub">{opts.correct}</div>
                        </div>
                        <div class="ex-card ex-card-bottom ex-card-teal">
                            <div class="ex-label">{t('practice_label_form_word')}</div>
                            <div class="ex-spell-input js-spell-input"><span class="ex-typed"></span><span class="ex-cursor">|</span></div>
                            <div class="ex-spell-divider"></div>
                            <div class="ex-letter-bubbles js-bubbles">
                                {spellChars.map((ch) => (
                                    <span class="letter-bubble">{ch}</span>
                                ))}
                            </div>
                        </div>
                        <div class="ex-action-btn ex-btn-inactive js-skip">{t('practice_btn_skip')}</div>
                    </div>

                    <div class="ex-panel" data-panel="3">
                        <div class="ex-card ex-card-top">
                            <div class="ex-word-main">{word.word}</div>
                        </div>
                        <div class="ex-card ex-card-bottom ex-card-teal">
                            <div class="ex-label">{t('practice_label_is_correct')}</div>
                            <div class="ex-word-answer js-candidate">{opts.correct}</div>
                            <div class="ex-yesno-row">
                                <div class="ex-yesno-btn ex-btn-yes js-yes">{t('practice_btn_yes')}</div>
                                <div class="ex-yesno-btn ex-btn-no js-no">{t('practice_btn_no')}</div>
                            </div>
                        </div>
                    </div>

                    <div class="ex-panel" data-panel="4">
                        <div class="ex-card ex-card-top">
                            <div class="ex-word-main">{word.word}</div>
                            {word.ipa && <div class="ex-ipa">{word.ipa}</div>}
                        </div>
                        <div class="ex-card ex-card-bottom ex-card-teal">
                            <div class="ex-label">{t('practice_label_press_speak')}</div>
                            <div class="ex-mic-btn js-mic" role="button" aria-label="record">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
                            </div>
                            <div class="ex-wave js-wave"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
                            <div class="ex-mic-hint">{t('practice_label_better_silence')}</div>
                            <div class="ex-score js-score"></div>
                        </div>
                        <div class="ex-action-btn ex-btn-inactive js-skip">{t('practice_btn_skip')}</div>
                    </div>

                    <div class="ex-panel" data-panel="5">
                        <div class="ex-card ex-card-top">
                            <div class="ex-word-main">{word.word}</div>
                            {word.ipa && <div class="ex-ipa">{word.ipa}</div>}
                            <div class="ex-speaker-small js-speak-small" role="button" aria-label="play">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#2DCCC2" stroke-width="2" width="18" height="18"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                            </div>
                        </div>
                        <div class="ex-card ex-card-bottom ex-card-teal ex-recall-prompt">
                            <div class="ex-label js-recall-label">{t('practice_label_whats_translation')}</div>
                            <div class="ex-recall-answer js-recall-answer"></div>
                        </div>
                        <div class="ex-action-btn ex-btn-teal js-reveal">{t('practice_btn_show_translation')}</div>
                    </div>

                    <!-- Session complete flourish -->
                    <div class="ex-complete">
                        <div class="ex-complete-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="exercise-desc">
                <p class="ex-desc active" data-desc="0">{t('practice_desc_choose')}</p>
                <p class="ex-desc" data-desc="1">{t('practice_desc_listen')}</p>
                <p class="ex-desc" data-desc="2">{t('practice_desc_spell')}</p>
                <p class="ex-desc" data-desc="3">{t('practice_desc_is_correct')}</p>
                <p class="ex-desc" data-desc="4">{t('practice_desc_pronounce')}</p>
                <p class="ex-desc" data-desc="5">{t('practice_desc_recall')}</p>
            </div>
        </div>

        <script type="application/json" data-practice-data set:html={JSON.stringify(practiceData)}></script>
    </div>
</section>

<style>
    .practice-section {
        padding: 80px 0;
    }

    .practice-header {
        text-align: center;
        max-width: 640px;
        margin: 0 auto 48px;
    }

    .practice-header h2 {
        margin-top: 16px;
        margin-bottom: 16px;
    }

    .practice-subtitle {
        color: var(--text-secondary, rgba(255, 255, 255, 0.7));
        font-size: 1.1rem;
        line-height: 1.7;
    }

    .practice-layout {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 40px;
        align-items: center;
    }

    /* === Exercise tabs (left) === */
    .exercise-tabs {
        display: flex;
        flex-direction: column;
        gap: 6px;
        justify-self: end;
    }

    .ex-tab {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 14px;
        cursor: pointer;
        font-size: 0.92rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.4);
        transition: all 0.3s ease;
        white-space: nowrap;
        text-align: left;
    }

    .ex-tab:hover {
        color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.03);
    }

    .ex-tab.active {
        color: #fff;
        background: rgba(45, 204, 194, 0.08);
        border-color: rgba(45, 204, 194, 0.25);
    }

    .ex-tab-icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        opacity: 0.4;
        transition: all 0.3s ease;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ex-tab.active .ex-tab-icon {
        opacity: 1;
        stroke: #2DCCC2;
    }

    /* === Phone mockup (center) === */
    .phone-mockup {
        display: flex;
        justify-content: center;
    }

    .phone-bezel {
        width: 280px;
        min-height: 480px;
        background: #f8f8f8;
        border-radius: 36px;
        padding: 20px 16px 16px;
        box-shadow:
            0 24px 60px rgba(0, 0, 0, 0.4),
            0 0 0 2px rgba(255, 255, 255, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.3);
        display: flex;
        flex-direction: column;
        gap: 10px;
        position: relative;
    }

    /* Progress */
    .ex-progress {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 4px 4px;
    }

    .ex-progress-text {
        font-size: 0.7rem;
        color: #858693;
        white-space: nowrap;
    }

    .ex-progress-bar {
        flex: 1;
        height: 4px;
        background: #e0e0e0;
        border-radius: 2px;
        overflow: hidden;
    }

    .ex-progress-fill {
        width: 16%;
        height: 100%;
        background: #2DCCC2;
        border-radius: 2px;
        transition: width 0.4s ease;
    }

    /* Panels */
    .ex-panel {
        display: none;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        animation: fadeInPanel 0.35s ease;
    }

    .ex-panel.active {
        display: flex;
    }

    @keyframes fadeInPanel {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Cards */
    .ex-card {
        background: #fff;
        border-radius: 20px;
        padding: 20px 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 80px;
    }

    .ex-card-top {
        flex: 1;
        position: relative;
    }

    .ex-card-bottom {
        flex: 1.5;
    }

    .ex-card-teal {
        border: 3px solid #2DCCC2;
    }

    /* Word display */
    .ex-word-main {
        font-size: 1.8rem;
        font-weight: 700;
        color: #1a1a2e;
    }

    .ex-word-sub {
        font-size: 1.4rem;
        font-weight: 600;
        color: #858693;
    }

    .ex-word-answer {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 12px 0;
    }

    .ex-ipa {
        font-size: 0.85rem;
        color: #858693;
        margin-top: 4px;
    }

    .ex-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #2DCCC2;
        margin-bottom: 10px;
    }

    /* Frequency dots */
    .ex-freq {
        display: flex;
        gap: 3px;
        margin-top: 6px;
    }

    .freq-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #e0e0e0;
    }

    .freq-dot.active {
        background: #2DCCC2;
    }

    /* 2x2 Grid options */
    .ex-grid-2x2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        width: 100%;
    }

    .ex-option {
        padding: 12px 8px;
        border: 2px solid #2DCCC2;
        border-radius: 10px;
        text-align: center;
        font-size: 0.85rem;
        font-weight: 600;
        color: #2DCCC2;
        background: #fff;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
        user-select: none;
    }

    .ex-option:hover:not(.selected):not(.correct):not(.wrong) {
        background: rgba(45, 204, 194, 0.1);
    }

    .ex-option:active {
        transform: scale(0.97);
    }

    .ex-option.selected {
        background: #2DCCC2;
        color: #fff;
    }

    .ex-option.correct {
        background: #2FBE6A;
        border-color: #2FBE6A;
        color: #fff;
    }

    .ex-option.wrong {
        background: #EF5350;
        border-color: #EF5350;
        color: #fff;
    }

    .ex-grid-2x2.done .ex-option {
        cursor: default;
    }

    /* Speaker icon */
    .ex-speaker-icon {
        width: 48px;
        height: 48px;
        margin: 8px auto;
        cursor: pointer;
        border-radius: 50%;
        transition: transform 0.15s ease;
    }

    .ex-speaker-icon:hover {
        transform: scale(1.08);
    }

    .ex-speaker-icon:active {
        transform: scale(0.95);
    }

    .ex-speaker-icon.playing {
        animation: speakerPulse 0.6s ease;
    }

    @keyframes speakerPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.12); }
    }

    .ex-speaker-icon svg {
        width: 100%;
        height: 100%;
    }

    .ex-speaker-small {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        padding: 6px;
        border-radius: 50%;
        transition: transform 0.15s ease;
    }

    .ex-speaker-small:hover {
        transform: translateY(-50%) scale(1.12);
    }

    /* Spell letters */
    .ex-spell-input {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a2e;
        letter-spacing: 2px;
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ex-spell-input.correct .ex-typed {
        color: #2FBE6A;
    }

    .ex-cursor {
        color: #2DCCC2;
        animation: blink 1s step-end infinite;
    }

    @keyframes blink {
        50% { opacity: 0; }
    }

    .ex-spell-divider {
        width: 100%;
        height: 2px;
        background: #2DCCC2;
        margin: 8px 0 12px;
    }

    .ex-letter-bubbles {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .letter-bubble {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        border: 2px solid #2DCCC2;
        color: #fff;
        background: #2DCCC2;
        cursor: pointer;
        transition: opacity 0.2s ease, transform 0.1s ease, background 0.15s ease, border-color 0.15s ease;
        user-select: none;
    }

    .letter-bubble:active {
        transform: scale(0.92);
    }

    .letter-bubble.used {
        background: #f0f2f5;
        border-color: #e0e3e8;
        color: #b7bcc6;
        opacity: 0.55;
        pointer-events: none;
    }

    .letter-bubble.shake {
        background: #EF5350;
        border-color: #EF5350;
        animation: exShake 0.4s ease;
    }

    @keyframes exShake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-4px); }
        40%, 80% { transform: translateX(4px); }
    }

    /* Yes/No */
    .ex-yesno-row {
        display: flex;
        gap: 10px;
        width: 100%;
    }

    .ex-yesno-btn {
        flex: 1;
        padding: 12px;
        border-radius: 10px;
        text-align: center;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
        user-select: none;
    }

    .ex-yesno-btn:active {
        transform: scale(0.97);
    }

    .ex-btn-yes {
        background: #2DCCC2;
        color: #fff;
        border: 2px solid #2DCCC2;
    }

    .ex-btn-no {
        background: #fff;
        color: #858693;
        border: 2px solid #e0e0e0;
    }

    .ex-yesno-btn.correct {
        background: #2FBE6A;
        border-color: #2FBE6A;
        color: #fff;
    }

    .ex-yesno-btn.wrong {
        background: #EF5350;
        border-color: #EF5350;
        color: #fff;
    }

    .ex-word-answer.correct {
        color: #2FBE6A;
    }

    .ex-word-answer.wrong {
        color: #EF5350;
    }

    /* Microphone */
    .ex-mic-btn {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #2DCCC2;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 12px auto;
        box-shadow: 0 4px 16px rgba(45, 204, 194, 0.3);
        cursor: pointer;
        transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.1s ease;
    }

    .ex-mic-btn:active {
        transform: scale(0.95);
    }

    .ex-mic-btn.recording {
        background: #E8B65A;
        box-shadow: 0 4px 16px rgba(232, 182, 90, 0.4);
        animation: micPulse 1s ease-in-out infinite;
    }

    .ex-mic-btn.scored {
        background: #2FBE6A;
        box-shadow: 0 4px 16px rgba(47, 190, 106, 0.35);
    }

    @keyframes micPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(232, 182, 90, 0.4); }
        50% { box-shadow: 0 0 0 14px rgba(232, 182, 90, 0); }
    }

    .ex-mic-btn svg {
        width: 28px;
        height: 28px;
    }

    .ex-mic-hint {
        font-size: 0.75rem;
        color: #858693;
        font-style: italic;
    }

    /* Recording waveform */
    .ex-wave {
        display: none;
        align-items: flex-end;
        justify-content: center;
        gap: 3px;
        height: 22px;
        margin: 2px 0 6px;
    }

    .ex-wave.on {
        display: flex;
    }

    .ex-wave span {
        width: 3px;
        height: 6px;
        background: #E8B65A;
        border-radius: 2px;
        animation: exWave 0.8s ease-in-out infinite;
    }

    .ex-wave span:nth-child(2) { animation-delay: 0.1s; }
    .ex-wave span:nth-child(3) { animation-delay: 0.2s; }
    .ex-wave span:nth-child(4) { animation-delay: 0.3s; }
    .ex-wave span:nth-child(5) { animation-delay: 0.15s; }
    .ex-wave span:nth-child(6) { animation-delay: 0.25s; }
    .ex-wave span:nth-child(7) { animation-delay: 0.05s; }

    @keyframes exWave {
        0%, 100% { height: 6px; }
        50% { height: 20px; }
    }

    /* Pronunciation score */
    .ex-score {
        display: none;
        font-size: 1.3rem;
        font-weight: 800;
        margin-top: 6px;
    }

    .ex-score.show {
        display: block;
        animation: fadeInPanel 0.3s ease;
    }

    .ex-score.good { color: #2FBE6A; }
    .ex-score.ok { color: #E8B65A; }

    /* Recall answer reveal */
    .ex-recall-answer {
        display: none;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a2e;
    }

    .ex-recall-answer.show {
        display: block;
        animation: fadeInPanel 0.3s ease;
    }

    /* Recall prompt */
    .ex-recall-prompt {
        flex: 1;
        justify-content: center;
    }

    /* Action buttons */
    .ex-action-btn {
        padding: 14px;
        border-radius: 14px;
        text-align: center;
        font-size: 0.9rem;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        user-select: none;
        transition: opacity 0.2s ease, transform 0.1s ease;
    }

    .ex-action-btn:active {
        transform: scale(0.98);
    }

    .ex-action-btn.disabled {
        opacity: 0.5;
        pointer-events: none;
    }

    .ex-action-btn.shake {
        animation: exShake 0.4s ease;
    }

    .ex-btn-teal {
        background: #2DCCC2;
    }

    .ex-btn-inactive {
        background: transparent;
        border: 2px solid #CACBE1;
        color: #CACBE1;
    }

    /* Session complete flourish */
    .ex-complete {
        position: absolute;
        inset: 0;
        border-radius: 36px;
        background: rgba(248, 248, 248, 0.94);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
    }

    .ex-complete.show {
        opacity: 1;
    }

    .ex-complete-check {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: #2FBE6A;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(47, 190, 106, 0.4);
        animation: popIn 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28);
    }

    .ex-complete-check svg {
        width: 44px;
        height: 44px;
    }

    @keyframes popIn {
        from { transform: scale(0.3); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    /* === Description (right) === */
    .exercise-desc {
        justify-self: start;
        min-height: 60px;
        display: flex;
        align-items: center;
    }

    .ex-desc {
        color: var(--text-secondary, rgba(255, 255, 255, 0.7));
        font-size: 1rem;
        line-height: 1.6;
        max-width: 280px;
        margin: 0;
        display: none;
    }

    .ex-desc.active {
        display: block;
        animation: fadeInPanel 0.35s ease;
    }

    /* === Responsive === */
    @media (max-width: 1024px) {
        .practice-layout {
            grid-template-columns: 1fr auto;
            gap: 32px;
        }

        .exercise-desc {
            display: none;
        }

        .exercise-tabs {
            justify-self: stretch;
        }
    }

    @media (max-width: 768px) {
        .practice-section {
            padding: 48px 0;
        }

        .practice-layout {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .phone-mockup {
            order: -1;
        }

        .phone-bezel {
            width: 260px;
            min-height: 420px;
            padding: 16px 12px 12px;
        }

        .exercise-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .ex-tab {
            padding: 10px 14px;
            font-size: 0.82rem;
        }
    }

    /* Narrow phones: the nowrap tabs alone are wider than the screen, so let
       them stack and wrap, and let the phone shrink with the viewport. */
    @media (max-width: 480px) {
        .practice-layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .exercise-tabs {
            grid-template-columns: minmax(0, 1fr);
        }

        .ex-tab {
            white-space: normal;
        }

        .phone-bezel {
            width: min(260px, 100%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ex-panel,
        .ex-desc.active,
        .ex-score.show,
        .ex-recall-answer.show,
        .ex-complete-check {
            animation: none;
        }

        .letter-bubble.shake,
        .ex-action-btn.shake {
            animation: none;
        }
    }
</style>

<script>
  interface PracticeData {
    word: string;
    wordSpell: string;
    ipa: string;
    correct: string;
    distractors: string[];
    lang: string;
  }

  const root = document.querySelector<HTMLElement>('.practice-section');
  if (root) initPractice(root);

  function initPractice(root: HTMLElement) {
    const dataEl = root.querySelector('[data-practice-data]');
    let pd: PracticeData;
    try {
      pd = JSON.parse(dataEl?.textContent || '{}');
    } catch {
      return;
    }
    if (!pd.word) return;

    const tabs = Array.from(root.querySelectorAll<HTMLElement>('.ex-tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.ex-panel'));
    const descs = Array.from(root.querySelectorAll<HTMLElement>('.ex-desc'));
    const fill = root.querySelector<HTMLElement>('.ex-progress-fill');
    const phone = root.querySelector<HTMLElement>('.phone-bezel');
    const complete = root.querySelector<HTMLElement>('.ex-complete');

    const ORDER = [0, 1, 2, 3, 4, 5];
    let pos = 0;
    let interacted = false;
    let showcase: number | undefined;
    let pending: number | undefined;

    function shuffle<T>(arr: T[]): T[] {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function speak(text: string, el?: HTMLElement | null) {
      if (el) {
        el.classList.remove('playing');
        void el.offsetWidth;
        el.classList.add('playing');
      }
      try {
        const S = (window as any).speechSynthesis;
        if (!S) return;
        const u = new SpeechSynthesisUtterance(text);
        u.lang = pd.lang;
        u.rate = 0.9;
        S.cancel();
        S.speak(u);
      } catch {
        /* no voice available — visual pulse only */
      }
    }

    function clearPending() {
      if (pending) {
        clearTimeout(pending);
        pending = undefined;
      }
    }

    function stopShowcase() {
      if (showcase) {
        clearInterval(showcase);
        showcase = undefined;
      }
    }

    function startShowcase() {
      if (interacted || showcase) return;
      showcase = window.setInterval(() => {
        pos = (pos + 1) % ORDER.length;
        showPanel(ORDER[pos]);
      }, 3800);
    }

    function firstInteract() {
      if (interacted) return;
      interacted = true;
      stopShowcase();
    }

    function setProgress() {
      if (fill) fill.style.width = Math.round(((pos + 1) / ORDER.length) * 100) + '%';
    }

    function showPanel(i: number) {
      tabs.forEach((t, k) => t.classList.toggle('active', k === i));
      panels.forEach((p, k) => p.classList.toggle('active', k === i));
      descs.forEach((d, k) => d.classList.toggle('active', k === i));
      setProgress();
      resetPanel(i);
    }

    function gotoExercise(i: number) {
      clearPending();
      pos = ORDER.indexOf(i);
      if (pos < 0) pos = 0;
      showPanel(i);
    }

    function advance() {
      clearPending();
      pos = (pos + 1) % ORDER.length;
      if (pos === 0) {
        celebrate();
        return;
      }
      showPanel(ORDER[pos]);
    }

    function celebrate() {
      complete?.classList.add('show');
      pending = window.setTimeout(() => {
        complete?.classList.remove('show');
        pos = 0;
        showPanel(ORDER[0]);
      }, 1150);
    }

    function afterFeedback() {
      clearPending();
      pending = window.setTimeout(advance, 1050);
    }

    // ---- per-panel reset + wiring ----
    function resetPanel(i: number) {
      if (i === 0) resetChoice(0, false);
      else if (i === 1) resetChoice(1, true);
      else if (i === 2) resetSpell();
      else if (i === 3) resetIsCorrect();
      else if (i === 4) resetPronounce();
      else if (i === 5) resetRecall();
    }

    // 0 = choose translation, 1 = listen & choose
    // NOTE: reuse the server-rendered option elements (they carry Astro's scoped
    // style attribute). Recreating them with createElement would drop the scope
    // and leave them unstyled.
    function resetChoice(panelIdx: number, listen: boolean) {
      const panel = panels[panelIdx];
      const grid = panel.querySelector<HTMLElement>('.js-options');
      const check = panel.querySelector<HTMLElement>('.js-check');
      if (!grid || !check) return;

      const optionEls = Array.from(grid.querySelectorAll<HTMLElement>('.ex-option'));
      const options = shuffle([pd.correct, ...pd.distractors]);
      grid.classList.remove('done');
      let selected: HTMLElement | null = null;

      optionEls.forEach((el, idx) => {
        const text = options[idx];
        el.textContent = text;
        el.className = 'ex-option';
        if (text === pd.correct) el.dataset.correct = '1';
        else delete el.dataset.correct;
        el.onclick = () => {
          if (grid.classList.contains('done')) return;
          firstInteract();
          optionEls.forEach((o) => o.classList.remove('selected'));
          el.classList.add('selected');
          selected = el;
        };
      });

      check.onclick = () => {
        if (grid.classList.contains('done')) return;
        firstInteract();
        if (!selected) {
          check.classList.add('shake');
          setTimeout(() => check.classList.remove('shake'), 400);
          return;
        }
        grid.classList.add('done');
        const correctEl = grid.querySelector<HTMLElement>('[data-correct="1"]');
        correctEl?.classList.add('correct');
        selected.classList.remove('selected');
        if (selected !== correctEl) selected.classList.add('wrong');
        afterFeedback();
      };

      if (listen) {
        const sp = panel.querySelector<HTMLElement>('.js-speak');
        if (sp) sp.onclick = () => { firstInteract(); speak(pd.word, sp); };
      }
    }

    // 2 = form the word from scrambled letters.
    // Reuse the server-rendered letter tiles (one per character of the word) so
    // they keep Astro's scoped styling; just relabel/shuffle and rewire them.
    function resetSpell() {
      const panel = panels[2];
      const input = panel.querySelector<HTMLElement>('.js-spell-input');
      const bubbles = panel.querySelector<HTMLElement>('.js-bubbles');
      const skip = panel.querySelector<HTMLElement>('.js-skip');
      const typed = input?.querySelector<HTMLElement>('.ex-typed');
      if (!input || !bubbles || !skip || !typed) return;

      const letters = Array.from(pd.wordSpell);
      let built = 0;

      input.classList.remove('correct');
      typed.textContent = '';

      const bubbleEls = Array.from(bubbles.querySelectorAll<HTMLElement>('.letter-bubble'));
      const shuffled = shuffle(letters);
      bubbles.classList.remove('done');

      bubbleEls.forEach((b, idx) => {
        const ch = shuffled[idx];
        b.textContent = ch;
        b.className = 'letter-bubble';
        b.onclick = () => {
          firstInteract();
          if (b.classList.contains('used') || bubbles.classList.contains('done')) return;
          if (ch === letters[built]) {
            b.classList.add('used');
            typed.textContent = (typed.textContent || '') + ch;
            built++;
            if (built === letters.length) {
              bubbles.classList.add('done');
              input.classList.add('correct');
              afterFeedback();
            }
          } else {
            b.classList.add('shake');
            setTimeout(() => b.classList.remove('shake'), 400);
          }
        };
      });

      skip.onclick = () => {
        firstInteract();
        if (bubbles.classList.contains('done')) return;
        bubbles.classList.add('done');
        typed.textContent = letters.join('');
        bubbleEls.forEach((x) => x.classList.add('used'));
        afterFeedback();
      };
    }

    // 3 = is this translation correct?
    function resetIsCorrect() {
      const panel = panels[3];
      const cand = panel.querySelector<HTMLElement>('.js-candidate');
      const yes = panel.querySelector<HTMLElement>('.js-yes');
      const no = panel.querySelector<HTMLElement>('.js-no');
      if (!cand || !yes || !no) return;

      const showCorrect = Math.random() < 0.5;
      const candidate = showCorrect
        ? pd.correct
        : pd.distractors[Math.floor(Math.random() * pd.distractors.length)];
      cand.textContent = candidate;
      cand.className = 'ex-word-answer js-candidate';
      yes.className = 'ex-yesno-btn ex-btn-yes js-yes';
      no.className = 'ex-yesno-btn ex-btn-no js-no';

      let done = false;
      const answer = (saidYes: boolean, btn: HTMLElement) => {
        firstInteract();
        if (done) return;
        done = true;
        const right = saidYes === showCorrect;
        btn.classList.add(right ? 'correct' : 'wrong');
        cand.classList.add(showCorrect ? 'correct' : 'wrong');
        afterFeedback();
      };
      yes.onclick = () => answer(true, yes);
      no.onclick = () => answer(false, no);
    }

    // 4 = pronounce (simulated scoring — no backend on the site)
    function resetPronounce() {
      const panel = panels[4];
      const mic = panel.querySelector<HTMLElement>('.js-mic');
      const skip = panel.querySelector<HTMLElement>('.js-skip');
      const score = panel.querySelector<HTMLElement>('.js-score');
      const wave = panel.querySelector<HTMLElement>('.js-wave');
      if (!mic || !skip || !score || !wave) return;

      mic.className = 'ex-mic-btn js-mic';
      score.className = 'ex-score js-score';
      score.textContent = '';
      wave.className = 'ex-wave js-wave';
      let done = false;

      mic.onclick = () => {
        firstInteract();
        if (done) return;
        done = true;
        speak(pd.word);
        mic.classList.add('recording');
        wave.classList.add('on');
        pending = window.setTimeout(() => {
          mic.classList.remove('recording');
          wave.classList.remove('on');
          mic.classList.add('scored');
          const val = 88 + Math.floor(Math.random() * 10); // 88–97
          score.textContent = val + '%';
          score.classList.add('show', val >= 90 ? 'good' : 'ok');
          afterFeedback();
        }, 1600);
      };

      skip.onclick = () => {
        firstInteract();
        if (done) return;
        done = true;
        advance();
      };
    }

    // 5 = recall (reveal the translation)
    function resetRecall() {
      const panel = panels[5];
      const reveal = panel.querySelector<HTMLElement>('.js-reveal');
      const answer = panel.querySelector<HTMLElement>('.js-recall-answer');
      const label = panel.querySelector<HTMLElement>('.js-recall-label');
      const speaker = panel.querySelector<HTMLElement>('.js-speak-small');
      if (!reveal || !answer) return;

      answer.textContent = '';
      answer.classList.remove('show');
      reveal.classList.remove('disabled');
      if (label) label.style.display = '';

      let done = false;
      reveal.onclick = () => {
        firstInteract();
        if (done) return;
        done = true;
        answer.textContent = pd.correct;
        answer.classList.add('show');
        if (label) label.style.display = 'none';
        reveal.classList.add('disabled');
        afterFeedback();
      };

      if (speaker) speaker.onclick = () => { firstInteract(); speak(pd.word, speaker); };
    }

    // ---- tabs, hover, visibility ----
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        firstInteract();
        gotoExercise(i);
      });
    });

    phone?.addEventListener('mouseenter', () => { if (!interacted) stopShowcase(); });
    phone?.addEventListener('mouseleave', () => { if (!interacted) startShowcase(); });

    let io: IntersectionObserver | null = null;
    if (typeof IntersectionObserver === 'function') {
      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) startShowcase();
            else stopShowcase();
          });
        },
        { threshold: 0.25 }
      );
      io.observe(root);
    }

    // init: reset the first panel, then let the showcase run (via observer/fallback)
    gotoExercise(ORDER[0]);
    if (!io) startShowcase();
  }
</script>
