---
// AudioDemo — phone widget with real audio playback and word-by-word highlighting.
// Uses the books2 V2 API: /page for block+token offsets, /audio for TTS + transcript.
// Transcript is per-block start times (number[][]), aligned 1:1 with block.tokens.
interface Props {
  targetLang?: string;
  uiLang?: string;
}
const { targetLang = 'de', uiLang = 'en' } = Astro.props;
---

<div class="audio-demo" data-target-lang={targetLang} data-ui-lang={uiLang}>
  <div class="audio-demo__phone-wrap">
    <img src="/images/phone-clean.svg" alt="" class="audio-demo__shell" />
    <div class="audio-demo__frame">
      <div class="audio-reader" id="audioReaderRoot">
        <!-- Header -->
        <div class="audio-reader__header">
          <span class="audio-reader__back">&#8249;</span>
          <span class="audio-reader__title" id="audioReaderTitle">Loading&hellip;</span>
          <button class="audio-reader__listen is-active" id="audioPlayBtn" style="display:none">
            <span class="audio-reader__eq">
              <span class="audio-reader__eq-bar"></span>
              <span class="audio-reader__eq-bar"></span>
              <span class="audio-reader__eq-bar"></span>
              <span class="audio-reader__eq-bar"></span>
            </span>
            Listening
          </button>
        </div>

        <!-- Audio progress bar -->
        <div class="audio-reader__progress">
          <div class="audio-reader__progress-fill" id="audioProgress"></div>
        </div>

        <!-- Content (filled dynamically) -->
        <div class="audio-reader__content" id="audioReaderContent">
          <div class="audio-reader__loading" id="audioLoading">Loading...</div>
        </div>

        <!-- Page footer -->
        <div class="audio-reader__footer">
          <span class="audio-reader__page">&#8249;</span>
          <span class="audio-reader__page">1 / 30</span>
          <span class="audio-reader__page">&#8250;</span>
        </div>

        <!-- Mute/unmute banner -->
        <button class="audio-reader__mute-banner" id="audioMuteBtn" title="Unmute audio">
          <svg id="audioMuteIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <line x1="23" y1="9" x2="17" y2="15"/>
            <line x1="17" y1="9" x2="23" y2="15"/>
          </svg>
          <span id="audioMuteLabel">Try the audio</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Phone wrapper */
  .audio-demo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .audio-demo__phone-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .audio-demo__shell {
    position: absolute;
    width: 332px;
    height: 645px;
    top: -2px;
    left: -6px;
    z-index: 20;
    pointer-events: none;
  }

  .audio-demo__frame {
    width: 320px;
    height: 640px;
    background: #fff;
    border-radius: 36px;
    overflow: hidden;
    position: relative;
  }

  /* Reader layout */
  .audio-reader {
    width: 100%;
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .audio-reader__header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
  }

  .audio-reader__back {
    font-size: 20px;
    color: #f97316;
    font-weight: 600;
    line-height: 1;
  }

  .audio-reader__title {
    font-size: 11px;
    color: #333;
    font-weight: 500;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .audio-reader__listen {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: none;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    background: #e5e7eb;
    color: #666;
    transition: all 0.3s;
  }
  .audio-reader__listen.is-active {
    background: #f97316;
    color: #fff;
  }

  .audio-reader__eq {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 12px;
  }
  .audio-reader__eq-bar {
    width: 2px;
    background: #fff;
    border-radius: 1px;
    animation: audio-eq-bounce 1s ease-in-out infinite;
  }
  .audio-reader__eq-bar:nth-child(1) { height: 4px; animation-delay: 0s; }
  .audio-reader__eq-bar:nth-child(2) { height: 8px; animation-delay: 0.15s; }
  .audio-reader__eq-bar:nth-child(3) { height: 5px; animation-delay: 0.3s; }
  .audio-reader__eq-bar:nth-child(4) { height: 10px; animation-delay: 0.45s; }

  @keyframes audio-eq-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  /* Progress bar */
  .audio-reader__progress {
    height: 3px;
    background: #f0f0f0;
    flex-shrink: 0;
  }
  .audio-reader__progress-fill {
    height: 100%;
    width: 0%;
    background: #f97316;
    transition: width 0.2s linear;
  }

  /* Content area */
  .audio-reader__content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 14px 14px 20px;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    pointer-events: none;
  }
  .audio-reader__content::-webkit-scrollbar { display: none; }

  /* Sentence pair styles — use :global() for dynamically injected elements */
  :global(.audio-reader__chapter) {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  :global(.audio-reader__chapter-trans) {
    font-size: 11px;
    color: #999;
    text-align: center;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  :global(.audio-reader__subchapter) {
    font-size: 12px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 2px;
  }
  :global(.audio-reader__subchapter-trans) {
    font-size: 10px;
    color: #999;
    text-align: center;
    margin-bottom: 14px;
    font-style: italic;
  }

  :global(.audio-reader__pair) { margin-bottom: 10px; }

  :global(.audio-reader__en) {
    font-size: 12px;
    line-height: 1.5;
    color: #1a1a2e;
    margin-bottom: 2px;
    transition: background 0.3s, color 0.3s;
    padding: 2px 4px;
    margin: 0 -4px 2px;
    border-radius: 4px;
  }
  :global(.audio-reader__en.is-reading) {
    background: rgba(249, 115, 22, 0.06);
    border-radius: 4px;
  }

  :global(.audio-reader__word.is-spoken) {
    background: rgba(249, 115, 22, 0.25);
    color: #c2410c;
    border-radius: 3px;
    padding: 1px 2px;
    margin: -1px -2px;
  }

  :global(.audio-reader__trans) {
    font-size: 11px;
    line-height: 1.4;
    color: #aaa;
    padding: 0 4px;
  }

  /* Footer */
  .audio-reader__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid #eee;
    flex-shrink: 0;
  }
  .audio-reader__page { font-size: 11px; color: #999; }

  /* Mute banner */
  .audio-reader__mute-banner {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 12;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 10px;
    border: none;
    background: var(--primary, #4ade80);
    color: #1a2332;
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, transform 0.1s, color 0.2s;
  }
  .audio-reader__mute-banner:hover {
    background: #3fc96e;
  }
  .audio-reader__mute-banner:active {
    transform: translateX(-50%) scale(0.97);
  }
  .audio-reader__mute-banner.is-unmuted {
    background: #f97316;
    color: #fff;
  }
  .audio-reader__mute-banner.is-unmuted:hover {
    background: #ea580c;
  }
  .audio-reader__mute-banner svg {
    flex-shrink: 0;
  }

  /* EQ bars paused state */
  .audio-reader__eq-bar.is-paused {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .audio-demo__frame {
      width: 260px;
      height: 520px;
      border-radius: 30px;
    }
    .audio-demo__shell {
      width: 272px;
      height: 530px;
      left: -5px;
      top: -2px;
    }
    .audio-reader__mute-banner {
      bottom: 34px;
      font-size: 10px;
      padding: 6px 12px;
    }
  }
</style>

<script>
  const BACKEND = 'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api';
  const BOOK = 'summary_11_A';
  const PAGE = 0;
  const MAX_RENDERED_ROWS = 8;

  const audioRoot = document.querySelector<HTMLElement>('.audio-demo');
  const TGT = audioRoot?.dataset.targetLang || 'de';
  const TRN = audioRoot?.dataset.uiLang || 'en';

  // ── Helpers (V2 page format) ──

  function tokenText(block, tok) {
    return block.text.slice(tok.s, tok.e);
  }

  function tokenRangeForSentence(block, sentIdx) {
    const sent = block.sentences[sentIdx];
    if (!sent) return [0, 0];
    let start = -1;
    let end = block.tokens.length;
    for (let i = 0; i < block.tokens.length; i++) {
      const t = block.tokens[i];
      if (t.s >= sent.s && t.e <= sent.e) {
        if (start === -1) start = i;
      } else if (start !== -1) {
        end = i;
        break;
      }
    }
    return start === -1 ? [0, 0] : [start, end];
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  /**
   * Render a slice of block.text [textStart, textEnd) as HTML, wrapping each token
   * in a span and emitting any inter-token chars (punctuation, whitespace) as plain
   * text. Token offsets in the slice are global (block.tokens index).
   */
  function renderRange(block, startTokenIdx, endTokenIdx, cssClass, blockIdx, textStart, textEnd) {
    const parts = [];
    let cursor = textStart;
    for (let i = startTokenIdx; i < endTokenIdx; i++) {
      const tok = block.tokens[i];
      if (tok.s > cursor) parts.push(escapeHtml(block.text.slice(cursor, tok.s)));
      parts.push(`<span class="${cssClass}" data-block="${blockIdx}" data-token="${i}">${escapeHtml(tokenText(block, tok))}</span>`);
      cursor = tok.e;
    }
    if (cursor < textEnd) parts.push(escapeHtml(block.text.slice(cursor, textEnd)));
    return parts.join('');
  }

  async function fetchJson(url) {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`${url} → ${res.status}`);
    return res.json();
  }

  /** Poll /audio until status=ready, returning {audio_url, transcript_url, duration}. */
  async function fetchAudioReady() {
    const url = `${BACKEND}/books2/${BOOK}/audio?page=${PAGE}&orig_lang=${TGT}`;
    for (let i = 0; i < 20; i++) {
      const data = await fetchJson(url);
      if (data.status === 'ready') return data;
      await new Promise(r => setTimeout(r, 3000));
    }
    throw new Error('Audio generation timed out');
  }

  // ── DOM refs ──

  const container = document.getElementById('audioReaderContent');
  const titleEl = document.getElementById('audioReaderTitle');
  const progressEl = document.getElementById('audioProgress');
  const muteBtn = document.getElementById('audioMuteBtn');
  const muteIcon = document.getElementById('audioMuteIcon');
  const muteLabel = document.getElementById('audioMuteLabel');
  const playBtn = document.getElementById('audioPlayBtn');

  const ICON_MUTED = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>';
  const ICON_UNMUTED = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>';

  // ── State ──

  let audio = null;
  let playbackRate = 1;
  let isMuted = true;
  let wordTimings = [];   // [{ time, spanEl, sentenceEl }]
  let sentenceEls = [];   // unique sentence/header elements (for is-reading + scrolling)
  let currentWordIdx = -1;
  let currentSentenceEl = null;
  let animFrameId = null;
  let audioFailed = false;

  // ── Main ──

  async function init() {
    try {
      const pageData = await fetchJson(
        `${BACKEND}/books2/${BOOK}/page?page=${PAGE}&orig_lang=${TGT}&target_lang=${TRN}`
      );
      const pairs = pageData.blocks || [];
      if (!pairs.length) throw new Error('empty page');

      // Pick title for phone header.
      let titleText = '';
      for (const pair of pairs) {
        if (pair.orig.style === 'h1') { titleText = pair.orig.text; break; }
      }
      titleEl.textContent = titleText.length > 22
        ? titleText.slice(0, 20) + '…'
        : (titleText || 'Listening');

      renderContent(pairs);

      // Try to load audio + transcript.
      await loadAudio(pairs);
    } catch (e) {
      console.error('AudioDemo: failed to load data', e);
      audioFailed = true;
      startFallbackKaraoke();
    }
  }

  /**
   * Render up to MAX_RENDERED_ROWS rows from blocks. Every token gets a span with
   * data-block + data-token so we can later attach transcript timings.
   */
  function renderContent(pairs) {
    let html = '';
    let rowCount = 0;
    sentenceEls = [];

    for (let bIdx = 0; bIdx < pairs.length && rowCount < MAX_RENDERED_ROWS; bIdx++) {
      const { orig, trans } = pairs[bIdx];
      const style = orig.style;
      const isHeader = style === 'h1' || style === 'h2' || style === 'h3';

      if (isHeader) {
        const origCls = style === 'h1' ? 'audio-reader__chapter' : 'audio-reader__subchapter';
        const transCls = style === 'h1' ? 'audio-reader__chapter-trans' : 'audio-reader__subchapter-trans';
        html += `<div class="audio-reader__pair">`;
        html += `<div class="${origCls} audio-reader__en" data-line="${rowCount}">${renderRange(orig, 0, orig.tokens.length, 'audio-reader__word', bIdx, 0, orig.text.length)}</div>`;
        html += `<div class="${transCls}">${escapeHtml(trans.text)}</div>`;
        html += `</div>`;
        rowCount++;
        continue;
      }

      const sentCount = Math.min(orig.sentences.length, trans.sentences.length);
      for (let sIdx = 0; sIdx < sentCount && rowCount < MAX_RENDERED_ROWS; sIdx++) {
        const origRange = tokenRangeForSentence(orig, sIdx);
        const transRange = tokenRangeForSentence(trans, sIdx);
        const origSent = orig.sentences[sIdx];
        const transSent = trans.sentences[sIdx];
        html += `<div class="audio-reader__pair">`;
        html += `<p class="audio-reader__en" data-line="${rowCount}">${renderRange(orig, origRange[0], origRange[1], 'audio-reader__word', bIdx, origSent.s, origSent.e)}</p>`;
        html += `<p class="audio-reader__trans">${renderRange(trans, transRange[0], transRange[1], 'audio-reader__trans-word', bIdx, transSent.s, transSent.e)}</p>`;
        html += `</div>`;
        rowCount++;
      }
    }

    container.innerHTML = html;
    sentenceEls = Array.from(container.querySelectorAll<HTMLElement>('.audio-reader__en[data-line]'));
  }

  async function loadAudio(pairs) {
    let audioInfo;
    try {
      audioInfo = await fetchAudioReady();
    } catch (e) {
      console.warn('AudioDemo: audio unavailable, using fallback', e);
      audioFailed = true;
      startFallbackKaraoke();
      return;
    }

    // Load transcript JSON (per-block array of token start times).
    let transcriptData;
    try {
      const res = await fetch(audioInfo.transcript_url);
      transcriptData = await res.json();
    } catch (e) {
      console.warn('AudioDemo: transcript fetch failed', e);
      audioFailed = true;
      startFallbackKaraoke();
      return;
    }

    buildWordTimings(transcriptData);

    audio = new Audio();
    audio.crossOrigin = 'anonymous';
    audio.muted = true;
    audio.preload = 'auto';
    audio.playbackRate = playbackRate;

    audio.addEventListener('error', () => {
      console.warn('AudioDemo: audio element failed, using fallback');
      audioFailed = true;
      startFallbackKaraoke();
    });

    audio.addEventListener('canplaythrough', () => {
      if (!audioFailed) startAudioPlayback();
    }, { once: true });

    audio.addEventListener('ended', () => {
      cancelAnimationFrame(animFrameId);
      clearHighlights();
      progressEl.style.width = '0%';
      currentWordIdx = -1;
      currentSentenceEl = null;
      container.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => {
        audio.currentTime = 0;
        audio.play().catch(() => {});
        syncLoop();
      }, 1500);
    });

    audio.src = audioInfo.audio_url;

    setTimeout(() => {
      if (!audioFailed && audio.readyState < 3) {
        audioFailed = true;
        startFallbackKaraoke();
      }
    }, 5000);
  }

  /**
   * Walk every rendered word span in document order, attach the matching transcript
   * timing via the span's data-block + data-token attrs. Spans whose timing is missing
   * (e.g. trans-side highlights or punctuation-only) are skipped.
   */
  function buildWordTimings(transcriptData) {
    const transcript = transcriptData.transcript || [];
    wordTimings = [];

    const spans = container.querySelectorAll<HTMLElement>('.audio-reader__word');
    spans.forEach(span => {
      const blockIdx = parseInt(span.dataset.block || '-1', 10);
      const tokenIdx = parseInt(span.dataset.token || '-1', 10);
      if (blockIdx < 0 || tokenIdx < 0) return;
      const blockTimings = transcript[blockIdx];
      if (!blockTimings) return;
      const time = blockTimings[tokenIdx];
      if (typeof time !== 'number') return;
      const sentenceEl = span.closest<HTMLElement>('.audio-reader__en');
      wordTimings.push({ time, spanEl: span, sentenceEl });
    });
  }

  function startAudioPlayback() {
    audio.play().catch(() => {});
    syncLoop();
  }

  function syncLoop() {
    if (!audio || audioFailed) return;

    const t = audio.currentTime;
    const dur = audio.duration || 1;
    progressEl.style.width = `${(t / dur) * 100}%`;

    // Find latest word whose start time has passed.
    let newWordIdx = -1;
    for (let i = wordTimings.length - 1; i >= 0; i--) {
      if (t >= wordTimings[i].time) { newWordIdx = i; break; }
    }

    if (newWordIdx !== currentWordIdx && newWordIdx >= 0) {
      if (currentWordIdx >= 0) {
        wordTimings[currentWordIdx].spanEl.classList.remove('is-spoken');
      }
      const entry = wordTimings[newWordIdx];

      if (entry.sentenceEl !== currentSentenceEl) {
        if (currentSentenceEl) currentSentenceEl.classList.remove('is-reading');
        entry.sentenceEl?.classList.add('is-reading');
        scrollIfNeeded(entry.sentenceEl);
        currentSentenceEl = entry.sentenceEl;
      }

      entry.spanEl.classList.add('is-spoken');
      currentWordIdx = newWordIdx;
    }

    // We only render ~8 rows; once the last rendered word has passed, loop early
    // instead of waiting for the full-page audio to finish.
    if (currentWordIdx === wordTimings.length - 1 && wordTimings[currentWordIdx]) {
      const lastTime = wordTimings[currentWordIdx].time;
      if (t > lastTime + 2) {
        cancelAnimationFrame(animFrameId);
        audio.pause();
        clearHighlights();
        progressEl.style.width = '0%';
        currentWordIdx = -1;
        currentSentenceEl = null;
        container.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => {
          audio.currentTime = 0;
          audio.play().catch(() => {});
          syncLoop();
        }, 1500);
        return;
      }
    }

    animFrameId = requestAnimationFrame(syncLoop);
  }

  function scrollIfNeeded(sentenceEl) {
    const pair = sentenceEl?.closest<HTMLElement>('.audio-reader__pair');
    if (!pair) return;
    const pairBottom = pair.offsetTop + pair.offsetHeight - container.offsetTop;
    const visibleBottom = container.scrollTop + container.clientHeight;
    if (pairBottom > visibleBottom) {
      const top = pair.offsetTop - container.offsetTop - 20;
      container.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }
  }

  function clearHighlights() {
    wordTimings.forEach(w => w.spanEl.classList.remove('is-spoken'));
    sentenceEls.forEach(s => s.classList.remove('is-reading'));
  }

  // ── Mute toggle ──

  muteBtn.addEventListener('click', () => {
    if (!audio) return;
    isMuted = !isMuted;
    audio.muted = isMuted;
    if (!isMuted) audio.play().catch(() => {});
    muteBtn.classList.toggle('is-unmuted', !isMuted);
    muteIcon.innerHTML = isMuted ? ICON_MUTED : ICON_UNMUTED;
    muteLabel.textContent = isMuted ? 'Try the audio' : 'Sound on';
    playBtn.style.display = isMuted ? 'none' : '';
  });

  // ── External speed control ──

  document.addEventListener('audiodemo:setspeed', (e) => {
    const detail = (e as CustomEvent).detail;
    const speed = detail && typeof detail.speed === 'number' ? detail.speed : 1;
    playbackRate = speed;
    if (audio) audio.playbackRate = speed;
  });

  // ── Fallback: timer-based karaoke ──

  function startFallbackKaraoke() {
    const lines = Array.from(container.querySelectorAll<HTMLElement>('.audio-reader__en[data-line]'));
    if (!lines.length) return;

    muteBtn.style.display = 'none';
    if (progressEl.parentElement) progressEl.parentElement.style.display = 'none';

    playBtn.textContent = '';
    const eq = document.createElement('span');
    eq.className = 'audio-reader__eq';
    eq.innerHTML = '<span class="audio-reader__eq-bar"></span><span class="audio-reader__eq-bar"></span><span class="audio-reader__eq-bar"></span><span class="audio-reader__eq-bar"></span>';
    playBtn.prepend(eq);
    playBtn.append(document.createTextNode(' Listening…'));

    const WORD_DELAY = 230;
    const LINE_PAUSE = 400;
    let lineIdx = 0;

    function readLine() {
      const line = lines[lineIdx];
      if (!line) return;
      const words = line.querySelectorAll<HTMLElement>('.audio-reader__word');
      line.classList.add('is-reading');
      scrollIfNeeded(line);

      let wordIdx = 0;
      function nextWord() {
        if (wordIdx > 0) words[wordIdx - 1].classList.remove('is-spoken');
        if (wordIdx < words.length) {
          words[wordIdx].classList.add('is-spoken');
          wordIdx++;
          setTimeout(nextWord, WORD_DELAY);
        } else {
          setTimeout(() => {
            words.forEach(w => w.classList.remove('is-spoken'));
            line.classList.remove('is-reading');
            lineIdx = (lineIdx + 1) % lines.length;
            if (lineIdx === 0) {
              container.scrollTo({ top: 0, behavior: 'smooth' });
              setTimeout(readLine, 1000);
            } else {
              readLine();
            }
          }, LINE_PAUSE);
        }
      }
      nextWord();
    }

    setTimeout(readLine, 1500);
  }

  // ── Start ──

  init();
</script>
