---
// AudioDemo, phone widget with real audio playback and word-by-word highlighting
// Loads book content + audio via backend API, syncs word highlighting to audio transcript timings
interface Props {
  targetLang?: string;
  uiLang?: string;
  /** Screenshot mode: freeze on a representative still frame instead of animating. */
  still?: boolean;
}
const { targetLang = 'de', uiLang = 'en', still = false } = Astro.props;
---

<div class="audio-demo" data-target-lang={targetLang} data-ui-lang={uiLang} data-still={still ? '1' : undefined}>
  <div class="audio-demo__phone-wrap">
    <img src="/images/phone-clean.svg" alt="" class="audio-demo__shell" />
    <div class="audio-demo__frame">
      <div class="audio-reader" id="audioReaderRoot">
        <!-- Header -->
        <div class="audio-reader__header">
          <span class="audio-reader__back">&#8249;</span>
          <span class="audio-reader__title" id="audioReaderTitle">Loading&hellip;</span>
          <button class="audio-reader__listen is-active" id="audioPlayBtn" style="display:none">
            <span class="audio-reader__eq">
              <span class="audio-reader__eq-bar"></span>
              <span class="audio-reader__eq-bar"></span>
              <span class="audio-reader__eq-bar"></span>
              <span class="audio-reader__eq-bar"></span>
            </span>
            Listening
          </button>
        </div>

        <!-- Audio progress bar -->
        <div class="audio-reader__progress">
          <div class="audio-reader__progress-fill" id="audioProgress"></div>
        </div>

        <!-- Content (filled dynamically) -->
        <div class="audio-reader__content" id="audioReaderContent">
          <div class="audio-reader__loading" id="audioLoading">Loading...</div>
        </div>

        <!-- Page footer -->
        <div class="audio-reader__footer">
          <span class="audio-reader__page">&#8249;</span>
          <span class="audio-reader__page">1 / 30</span>
          <span class="audio-reader__page">&#8250;</span>
        </div>

        <!-- Mute/unmute banner -->
        <button class="audio-reader__mute-banner" id="audioMuteBtn" title="Unmute audio">
          <svg id="audioMuteIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <line x1="23" y1="9" x2="17" y2="15"/>
            <line x1="17" y1="9" x2="23" y2="15"/>
          </svg>
          <span id="audioMuteLabel">Try the audio</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Phone wrapper */
  .audio-demo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .audio-demo__phone-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .audio-demo__shell {
    position: absolute;
    width: 332px;
    height: 645px;
    top: -2px;
    left: -6px;
    z-index: 20;
    pointer-events: none;
  }

  .audio-demo__frame {
    width: 320px;
    height: 640px;
    background: #fff;
    border-radius: 36px;
    overflow: hidden;
    position: relative;
  }

  /* Reader layout */
  .audio-reader {
    width: 100%;
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .audio-reader__header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
  }

  .audio-reader__back {
    font-size: 20px;
    color: #f97316;
    font-weight: 600;
    line-height: 1;
  }

  .audio-reader__title {
    font-size: 11px;
    color: #333;
    font-weight: 500;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .audio-reader__listen {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: none;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    background: #e5e7eb;
    color: #666;
    transition: all 0.3s;
  }
  .audio-reader__listen.is-active {
    background: #f97316;
    color: #fff;
  }

  .audio-reader__eq {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 12px;
  }
  .audio-reader__eq-bar {
    width: 2px;
    background: #fff;
    border-radius: 1px;
    animation: audio-eq-bounce 1s ease-in-out infinite;
  }
  .audio-reader__eq-bar:nth-child(1) { height: 4px; animation-delay: 0s; }
  .audio-reader__eq-bar:nth-child(2) { height: 8px; animation-delay: 0.15s; }
  .audio-reader__eq-bar:nth-child(3) { height: 5px; animation-delay: 0.3s; }
  .audio-reader__eq-bar:nth-child(4) { height: 10px; animation-delay: 0.45s; }

  @keyframes audio-eq-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  /* Progress bar */
  .audio-reader__progress {
    height: 3px;
    background: #f0f0f0;
    flex-shrink: 0;
  }
  .audio-reader__progress-fill {
    height: 100%;
    width: 0%;
    background: #f97316;
    transition: width 0.2s linear;
  }

  /* Content area */
  .audio-reader__content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 14px 14px 20px;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    pointer-events: none;
  }
  .audio-reader__content::-webkit-scrollbar { display: none; }

  /* Sentence pair styles, use :global() for dynamically injected elements */
  :global(.audio-reader__chapter) {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  :global(.audio-reader__chapter-trans) {
    font-size: 11px;
    color: #999;
    text-align: center;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  :global(.audio-reader__subchapter) {
    font-size: 12px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 2px;
  }
  :global(.audio-reader__subchapter-trans) {
    font-size: 10px;
    color: #999;
    text-align: center;
    margin-bottom: 14px;
    font-style: italic;
  }

  :global(.audio-reader__pair) { margin-bottom: 10px; }

  :global(.audio-reader__en) {
    font-size: 12px;
    line-height: 1.5;
    color: #1a1a2e;
    margin-bottom: 2px;
    transition: background 0.3s, color 0.3s;
    padding: 2px 4px;
    margin: 0 -4px 2px;
    border-radius: 4px;
  }
  :global(.audio-reader__en.is-reading) {
    background: rgba(249, 115, 22, 0.06);
    border-radius: 4px;
  }

  :global(.audio-reader__word.is-spoken) {
    background: rgba(249, 115, 22, 0.25);
    color: #c2410c;
    border-radius: 3px;
    padding: 1px 2px;
    margin: -1px -2px;
  }

  :global(.audio-reader__trans) {
    font-size: 11px;
    line-height: 1.4;
    color: #aaa;
    padding: 0 4px;
  }

  /* Footer */
  .audio-reader__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid #eee;
    flex-shrink: 0;
  }
  .audio-reader__page { font-size: 11px; color: #999; }

  /* Mute banner */
  .audio-reader__mute-banner {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 12;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 10px;
    border: none;
    background: var(--primary, #4ade80);
    color: #1a2332;
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, transform 0.1s, color 0.2s;
  }
  .audio-reader__mute-banner:hover {
    background: #3fc96e;
  }
  .audio-reader__mute-banner:active {
    transform: translateX(-50%) scale(0.97);
  }
  .audio-reader__mute-banner.is-unmuted {
    background: #f97316;
    color: #fff;
  }
  .audio-reader__mute-banner.is-unmuted:hover {
    background: #ea580c;
  }
  .audio-reader__mute-banner svg {
    flex-shrink: 0;
  }

  /* EQ bars paused state */
  .audio-reader__eq-bar.is-paused {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .audio-demo__frame {
      width: 260px;
      height: 520px;
      border-radius: 30px;
    }
    .audio-demo__shell {
      width: 272px;
      height: 530px;
      left: -5px;
      top: -2px;
    }
    .audio-reader__mute-banner {
      bottom: 34px;
      font-size: 10px;
      padding: 6px 12px;
    }
  }
</style>

<script>
  const BACKEND = 'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api';
  const BOOK = 'summary_11_A2';
  const audioRoot = document.querySelector<HTMLElement>('.audio-demo');
  const TGT = audioRoot?.dataset.targetLang || 'de';
  const TRN = audioRoot?.dataset.uiLang || 'en';
  // Screenshot mode: render one clean "playing" frame and signal readiness via
  // window.__shotReady, skip the audio load/playback entirely.
  const STILL = audioRoot?.dataset.still === '1';

  // Fetch JSON from the v2 backend. /page and /align block until ready on a
  // cache miss; /audio returns status='generating' and is polled separately.
  async function fetchJson(url, retries = 2) {
    let lastErr;
    for (let i = 0; i <= retries; i++) {
      try {
        const res = await fetch(url);
        if (res.ok) return await res.json();
        lastErr = new Error(`Backend ${res.status}`);
      } catch (e) { lastErr = e; }
      if (i < retries) await new Promise(r => setTimeout(r, 1500));
    }
    throw lastErr;
  }

  // ── Helpers ──

  // Group a v2 block's tokens by sentence using its pre-split sentence ranges.
  // Each entry: { words, text, tokenOffset } where tokenOffset is the index of
  // the sentence's first token within the block, the index space the audio
  // transcript (transcript[blockIdx][tokenIdx]) also uses.
  function blockToSentences(block) {
    const sents = block.sentences || [];
    const groups = sents.map(() => ({ words: [], text: '', tokenOffset: -1 }));
    for (let ti = 0; ti < block.tokens.length; ti++) {
      const t = block.tokens[ti];
      let si = 0;
      for (let j = 0; j < sents.length; j++) {
        if (t.s >= sents[j].s && t.e <= sents[j].e) { si = j; break; }
      }
      const g = groups[si];
      if (!g) continue;
      if (g.tokenOffset < 0) g.tokenOffset = ti;
      g.words.push(block.text.substring(t.s, t.e));
    }
    for (let si = 0; si < sents.length; si++) {
      groups[si].text = block.text.substring(sents[si].s, sents[si].e).trim();
    }
    return groups;
  }

  // Collapse a header block's sentence groups into a single line carrying its
  // block index + first token offset (for audio sync).
  function makeLine(groups, blockIdx, text) {
    const words = [];
    let tokenOffset = -1;
    for (const g of groups) {
      if (tokenOffset < 0) tokenOffset = g.tokenOffset;
      words.push(...g.words);
    }
    return { words, text, blockIdx, tokenOffset: tokenOffset < 0 ? 0 : tokenOffset };
  }

  /** Parse one side ('orig' | 'trans') of a v2 page into title/subtitle lines + sentences. */
  function parseSide(page, side) {
    let titleLine = null;
    let subtitleLine = null;
    const sentences = []; // { words, text, blockIdx, tokenOffset }
    for (let bi = 0; bi < page.blocks.length; bi++) {
      const block = page.blocks[bi][side];
      const groups = blockToSentences(block);
      const style = block.style;
      if (style === 'h1' || style === 'h2' || style === 'h3') {
        const line = makeLine(groups, bi, block.text.trim());
        if (style === 'h1' && !titleLine) titleLine = line;
        else if (!subtitleLine) subtitleLine = line;
        continue;
      }
      for (let si = 0; si < groups.length; si++) {
        sentences.push({ words: groups[si].words, text: groups[si].text, blockIdx: bi, tokenOffset: groups[si].tokenOffset });
      }
    }
    return { titleLine, subtitleLine, sentences };
  }

  // ── DOM refs ──

  const container = document.getElementById('audioReaderContent');
  const titleEl = document.getElementById('audioReaderTitle');
  const progressEl = document.getElementById('audioProgress');
  const muteBtn = document.getElementById('audioMuteBtn');
  const muteIcon = document.getElementById('audioMuteIcon');
  const muteLabel = document.getElementById('audioMuteLabel');
  const playBtn = document.getElementById('audioPlayBtn');

  // SVG paths for mute icons
  const ICON_MUTED = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>';
  const ICON_UNMUTED = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>';

  // ── State ──

  let audio = null;
  let playbackRate = 1;
  let isMuted = true;
  let wordTimings = [];   // flat array of { time, sentenceIdx, wordIdx }
  let allWordSpans = [];  // flat array of span elements matching wordTimings
  let sentenceEls = [];   // .audio-reader__en elements
  let currentWordIdx = -1;
  let currentSentenceIdx = -1;
  let animFrameId = null;
  let audioFailed = false;
  let lineMeta = [];      // parallel to sentenceEls: { blockIdx, tokenOffset } for audio sync

  // ── Main ──

  async function init() {
    // Bail if the widget was removed before init (e.g. screenshot page drops the
    // unused widget), avoids needless backend fetches.
    if (!audioRoot || !container) return;
    try {
      // v2: one call returns orig (spoken lang) + trans (ui lang) paired, with
      // sentences already split server-side and orig/trans counts guaranteed equal.
      const page = await fetchJson(
        `${BACKEND}/books2/${BOOK}/page?page=0&orig_lang=${TGT}&target_lang=${TRN}`
      );
      const tgtData = parseSide(page, 'orig');
      const trnData = parseSide(page, 'trans');

      // Set title
      const titleText = tgtData.titleLine ? tgtData.titleLine.text : '';
      titleEl.textContent = titleText.length > 22 ? titleText.slice(0, 20) + '\u2026' : titleText;

      // Render content
      renderContent(tgtData, trnData);

      // Screenshot mode: freeze on a clean "playing" frame, skip audio load.
      if (STILL) {
        freezeStill();
        return;
      }

      // Try to load audio and transcript
      await loadAudio();
    } catch (e) {
      console.error('AudioDemo: failed to load data', e);
      // Fall back to timer-based karaoke
      audioFailed = true;
      startFallbackKaraoke();
    }
  }

  // Render the spoken-side words as <span> tokens (one per v2 token) so audio
  // timings can be attached per token; the translation side is plain text.
  function renderWords(words) {
    return words.map(w => `<span class="audio-reader__word">${w}</span>`).join(' ');
  }

  function renderContent(tgtData, trnData) {
    let html = '';
    let lineIdx = 0;
    lineMeta = [];

    if (tgtData.titleLine) {
      html += `<div class="audio-reader__pair">`;
      html += `<div class="audio-reader__chapter audio-reader__en" data-line="${lineIdx}">${renderWords(tgtData.titleLine.words)}</div>`;
      html += `<div class="audio-reader__chapter-trans">${trnData.titleLine ? trnData.titleLine.text : ''}</div>`;
      html += `</div>`;
      lineMeta.push({ blockIdx: tgtData.titleLine.blockIdx, tokenOffset: tgtData.titleLine.tokenOffset });
      lineIdx++;
    }
    if (tgtData.subtitleLine) {
      html += `<div class="audio-reader__pair">`;
      html += `<div class="audio-reader__subchapter audio-reader__en" data-line="${lineIdx}">${renderWords(tgtData.subtitleLine.words)}</div>`;
      html += `<div class="audio-reader__subchapter-trans">${trnData.subtitleLine ? trnData.subtitleLine.text : ''}</div>`;
      html += `</div>`;
      lineMeta.push({ blockIdx: tgtData.subtitleLine.blockIdx, tokenOffset: tgtData.subtitleLine.tokenOffset });
      lineIdx++;
    }

    const maxSentences = Math.min(tgtData.sentences.length, trnData.sentences.length, 8);
    for (let i = 0; i < maxSentences; i++) {
      const s = tgtData.sentences[i];
      html += `<div class="audio-reader__pair">`;
      html += `<p class="audio-reader__en" data-line="${lineIdx}">${renderWords(s.words)}</p>`;
      html += `<p class="audio-reader__trans">${trnData.sentences[i].text}</p>`;
      html += `</div>`;
      lineMeta.push({ blockIdx: s.blockIdx, tokenOffset: s.tokenOffset });
      lineIdx++;
    }

    container.innerHTML = html;
    sentenceEls = Array.from(container.querySelectorAll('.audio-reader__en[data-line]'));
  }

  async function loadAudio() {
    let audioUrl;
    let transcriptData;

    // v2 /audio returns status='generating' while TTS runs; poll until ready,
    // then read the transcript JSON it points to.
    try {
      const apiUrl = `${BACKEND}/books2/${BOOK}/audio?page=0&orig_lang=${TGT}`;
      let apiData = await fetchJson(apiUrl);
      for (let i = 0; i < 12 && apiData.status !== 'ready'; i++) {
        await new Promise(r => setTimeout(r, 3000));
        apiData = await fetchJson(apiUrl);
      }
      if (apiData.status !== 'ready' || !apiData.audio_url) {
        throw new Error('Audio generation timed out');
      }
      audioUrl = apiData.audio_url;
      const tRes = await fetch(apiData.transcript_url);
      if (!tRes.ok) throw new Error('transcript fetch failed');
      transcriptData = await tRes.json();
    } catch (e2) {
      console.warn('AudioDemo: audio unavailable, using fallback', e2);
      audioFailed = true;
      startFallbackKaraoke();
      return;
    }

    // Build word timings from transcript
    buildWordTimings(transcriptData);

    // Create audio element
    audio = new Audio();
    audio.crossOrigin = 'anonymous';
    audio.muted = true;
    audio.preload = 'auto';
    audio.playbackRate = playbackRate;

    audio.addEventListener('error', () => {
      console.warn('AudioDemo: audio failed to load, using fallback');
      audioFailed = true;
      startFallbackKaraoke();
    });

    audio.addEventListener('canplaythrough', () => {
      if (!audioFailed) startAudioPlayback();
    }, { once: true });

    audio.addEventListener('ended', () => {
      // Loop: reset and replay
      cancelAnimationFrame(animFrameId);
      clearHighlights();
      progressEl.style.width = '0%';
      currentWordIdx = -1;
      currentSentenceIdx = -1;
      container.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => {
        audio.currentTime = 0;
        audio.play().catch(() => {});
        syncLoop();
      }, 1500);
    });

    // Audio URL is always the S3 direct URL
    audio.src = audioUrl;

    // Timeout: if audio doesn't load in 5s, fall back
    setTimeout(() => {
      if (!audioFailed && audio.readyState < 3) {
        audioFailed = true;
        startFallbackKaraoke();
      }
    }, 5000);
  }

  /**
   * Map the v2 transcript to rendered word spans. The transcript is
   * transcript[blockIdx][tokenIdx] = start time (seconds); each rendered line
   * carries its blockIdx + first-token offset (lineMeta), and its word spans are
   * exactly the block's tokens in order, so timings line up one-to-one.
   */
  function buildWordTimings(transcriptData) {
    const transcript = transcriptData.transcript || [];

    wordTimings = [];
    allWordSpans = [];

    sentenceEls.forEach((sentEl, sIdx) => {
      const meta = lineMeta[sIdx] || { blockIdx: -1, tokenOffset: 0 };
      const blockTimes = transcript[meta.blockIdx] || [];
      const spans = Array.from(sentEl.querySelectorAll('.audio-reader__word'));
      spans.forEach((span, wIdx) => {
        const ti = meta.tokenOffset + wIdx;
        const time = ti < blockTimes.length ? blockTimes[ti] : null;
        wordTimings.push({ time, sentenceIdx: sIdx, wordIdx: wIdx });
        allWordSpans.push(span);
      });
    });
  }

  function startAudioPlayback() {
    audio.play().catch(() => {});
    syncLoop();
  }

  function stopAndReset() {
    cancelAnimationFrame(animFrameId);
    clearHighlights();
    progressEl.style.width = '0%';
    currentWordIdx = -1;
    currentSentenceIdx = -1;

    // Reset mute state
    isMuted = true;
    if (audio) {
      audio.muted = true;
    }
    muteBtn.classList.remove('is-unmuted');
    muteIcon.innerHTML = ICON_MUTED;
    muteLabel.textContent = 'Try the audio';
    playBtn.style.display = 'none';

    // Scroll to top then restart muted playback with highlighting
    container.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => {
      if (audio) {
        audio.currentTime = 0;
        audio.play().catch(() => {});
        syncLoop();
      } else {
        startFallbackKaraoke();
      }
    }, 1500);
  }

  function syncLoop() {
    if (!audio || audioFailed) return;

    const t = audio.currentTime;
    const dur = audio.duration || 1;

    // Update progress bar
    progressEl.style.width = `${(t / dur) * 100}%`;

    // Find current word based on audio time
    let newWordIdx = -1;
    for (let i = wordTimings.length - 1; i >= 0; i--) {
      if (wordTimings[i].time !== null && t >= wordTimings[i].time) {
        newWordIdx = i;
        break;
      }
    }

    if (newWordIdx !== currentWordIdx && newWordIdx >= 0) {
      // Clear previous word highlight
      if (currentWordIdx >= 0 && allWordSpans[currentWordIdx]) {
        allWordSpans[currentWordIdx].classList.remove('is-spoken');
      }

      const entry = wordTimings[newWordIdx];

      // Sentence changed
      if (entry.sentenceIdx !== currentSentenceIdx) {
        if (currentSentenceIdx >= 0 && sentenceEls[currentSentenceIdx]) {
          sentenceEls[currentSentenceIdx].classList.remove('is-reading');
        }
        sentenceEls[entry.sentenceIdx].classList.add('is-reading');
        scrollIfNeeded(entry.sentenceIdx);
        currentSentenceIdx = entry.sentenceIdx;
      }

      // Highlight current word
      allWordSpans[newWordIdx].classList.add('is-spoken');
      currentWordIdx = newWordIdx;

    }

    // Check if we've passed the last rendered word, loop early
    // (audio covers the full page but we only render ~8 sentences)
    if (currentWordIdx === wordTimings.length - 1 && wordTimings[currentWordIdx]?.time !== null) {
      const lastWordTime = wordTimings[currentWordIdx].time;
      if (t > lastWordTime + 2) {
        // All rendered text has been read, loop now instead of waiting for full audio
        cancelAnimationFrame(animFrameId);
        audio.pause();
        clearHighlights();
        progressEl.style.width = '0%';
        currentWordIdx = -1;
        currentSentenceIdx = -1;
        container.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => {
          audio.currentTime = 0;
          audio.play().catch(() => {});
          syncLoop();
        }, 1500);
        return;
      }
    }

    animFrameId = requestAnimationFrame(syncLoop);
  }

  function scrollIfNeeded(idx) {
    const pair = sentenceEls[idx]?.closest('.audio-reader__pair');
    if (!pair) return;
    const pairBottom = pair.offsetTop + pair.offsetHeight - container.offsetTop;
    const visibleBottom = container.scrollTop + container.clientHeight;
    if (pairBottom > visibleBottom) {
      const top = pair.offsetTop - container.offsetTop - 20;
      container.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }
  }

  function clearHighlights() {
    allWordSpans.forEach(s => s.classList.remove('is-spoken'));
    sentenceEls.forEach(s => s.classList.remove('is-reading'));
  }

  function pauseEqBars(paused) {
    const bars = playBtn.querySelectorAll('.audio-reader__eq-bar');
    bars.forEach(b => b.classList.toggle('is-paused', paused));
  }

  // ── Mute toggle ──

  muteBtn?.addEventListener('click', () => {
    if (!audio) return;
    isMuted = !isMuted;
    audio.muted = isMuted;
    // Re-trigger play() within user gesture context to satisfy browser autoplay policy
    if (!isMuted) {
      audio.play().catch(() => {});
    }
    muteBtn.classList.toggle('is-unmuted', !isMuted);
    muteIcon.innerHTML = isMuted ? ICON_MUTED : ICON_UNMUTED;
    muteLabel.textContent = isMuted ? 'Try the audio' : 'Sound on';
    // Show "Listening" button only when unmuted
    playBtn.style.display = isMuted ? 'none' : '';
  });

  // ── External speed control ──

  document.addEventListener('audiodemo:setspeed', (e) => {
    const detail = (e as CustomEvent).detail;
    const speed = detail && typeof detail.speed === 'number' ? detail.speed : 1;
    playbackRate = speed;
    if (audio) audio.playbackRate = speed;
  });

  // ── Fallback: timer-based karaoke (same as ReaderDemo) ──

  function startFallbackKaraoke() {
    if (!sentenceEls.length) return;

    // Hide mute button and progress bar since there's no audio
    muteBtn.style.display = 'none';
    progressEl.parentElement.style.display = 'none';

    // Change button text
    playBtn.textContent = '';
    const eq = document.createElement('span');
    eq.className = 'audio-reader__eq';
    eq.innerHTML = '<span class="audio-reader__eq-bar"></span><span class="audio-reader__eq-bar"></span><span class="audio-reader__eq-bar"></span><span class="audio-reader__eq-bar"></span>';
    playBtn.prepend(eq);
    playBtn.append(document.createTextNode(' Listening\u2026'));

    const WORD_DELAY = 230;
    const LINE_PAUSE = 400;
    let lineIdx = 0;

    function readLine() {
      const line = sentenceEls[lineIdx];
      if (!line) return;
      const words = line.querySelectorAll('.audio-reader__word');
      line.classList.add('is-reading');
      scrollIfNeeded(lineIdx);

      let wordIdx = 0;
      function nextWord() {
        if (wordIdx > 0) words[wordIdx - 1].classList.remove('is-spoken');
        if (wordIdx < words.length) {
          words[wordIdx].classList.add('is-spoken');
          wordIdx++;
          setTimeout(nextWord, WORD_DELAY);
        } else {
          setTimeout(() => {
            words.forEach(w => w.classList.remove('is-spoken'));
            line.classList.remove('is-reading');
            lineIdx = (lineIdx + 1) % sentenceEls.length;
            if (lineIdx === 0) {
              container.scrollTo({ top: 0, behavior: 'smooth' });
              setTimeout(readLine, 1000);
            } else {
              readLine();
            }
          }, LINE_PAUSE);
        }
      }
      nextWord();
    }

    setTimeout(readLine, 1500);
  }

  // ── Screenshot still frame ──

  function freezeStill() {
    // Show the active "Listening" pill, hide the interactive mute CTA.
    muteBtn.style.display = 'none';
    playBtn.style.display = '';
    progressEl.style.width = '38%';

    // Highlight a sentence + one spoken word to read as "playing now".
    const lineEls = Array.from(container.querySelectorAll('.audio-reader__en[data-line]'));
    const li = Math.min(1, lineEls.length - 1);
    const line = lineEls[li];
    if (line) {
      line.classList.add('is-reading');
      const words = line.querySelectorAll('.audio-reader__word');
      const wi = Math.min(2, words.length - 1);
      if (words[wi]) words[wi].classList.add('is-spoken');
    }
    (window as any).__shotReady = true;
  }

  // ── Start ──

  init();
</script>
