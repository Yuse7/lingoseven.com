---
interface Props {
  targetLangName?: string;
  targetLangNamePrep?: string;
  targetLangNameGen?: string;
  translations?: Record<string, any>;
  /** Extra language-specific FAQ items (HTML allowed in answer). Appended after the standard items. */
  extraFaq?: Array<{ question: string; answer: string }>;
}
const { targetLangName = '', targetLangNamePrep = '', targetLangNameGen = '', translations = {}, extraFaq = [] } = Astro.props;

function t(key: string): string {
  const val = translations[key] || key;
  return val
    .replace(/{targetLang}/g, targetLangName)
    .replace(/{targetLangPrep}/g, targetLangNamePrep || targetLangName)
    .replace(/{targetLangGen}/g, targetLangNameGen || targetLangName);
}

const items = [1, 2, 3, 4, 5];
---

<!-- Polyglot Secrets -->
<section id="faq" class="faq">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">{t('faq2_tag')}</span>
            <h2 set:html={t('faq2_title')}></h2>
            <p>{t('faq2_subtitle')}</p>
        </div>
        <div class="faq-list">
            {items.map((i) => (
                <div class="faq-item">
                    <button class="faq-question">
                        <span>{t(`faq2_item${i}_question`)}</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p set:html={t(`faq2_item${i}_principle`)}></p>
                        <p set:html={t(`faq2_item${i}_how`)}></p>
                    </div>
                </div>
            ))}
            {extraFaq.map((f) => (
                <div class="faq-item">
                    <button class="faq-question">
                        <span>{f.question}</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p set:html={f.answer}></p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
