---
// Quiet in-flow app mention for tool pages. Replaces the old green promo card
// with large store buttons. Mirrors the ToolDirectAnswer visual pattern
// (small label + one paragraph) so the app pitch reads as part of the page,
// not a banner. Store links are plain text links plus the rating line
// (StoreLinksRow); the pitch is carried by the live ReaderDemo phone next to
// the text (same widget as the learn pages and blog posts).
// A `{uiLang}` placeholder in `lead` or `body` becomes the inline
// translation-language dropdown (same as AppDemoCta) and the ReaderDemo's own
// picker is turned off; without a placeholder the widget keeps its picker.
// Max one per page: ReaderDemo's script binds to the first `.reader-demo`.
import InlineLangMenu from './InlineLangMenu.astro';
import InlineLangTrigger from './InlineLangTrigger.astro';
import ReaderDemo from './ReaderDemo.astro';
import StoreLinksRow from './StoreLinksRow.astro';
import { getEnabledLanguages } from '../data/languages';
import { languageNames } from '../data/languageNames';

interface Props {
  /** Bolded first sentence, contextual to the tool. May carry one `{uiLang}`. */
  lead: string;
  /** Rest of the paragraph. Same `{uiLang}` treatment; the lead's placeholder wins. */
  body: string;
  /** Language of the demo book; per-language tool pages pass their code. */
  targetLang?: string;
  /** Translation language shown under each sentence. */
  uiLang?: string;
}
const { lead, body, targetLang = 'de', uiLang = 'en' } = Astro.props;
// A same-language pair would render a degenerate demo (book and translation
// identical), e.g. /tools/flashcards/english; shift the translation side.
const trnLang = uiLang === targetLang ? (targetLang === 'en' ? 'es' : 'en') : uiLang;

const PLACEHOLDER = '{uiLang}';
const leadIdx = lead.indexOf(PLACEHOLDER);
const bodyIdx = leadIdx < 0 ? body.indexOf(PLACEHOLDER) : -1;
const hasInlinePicker = leadIdx >= 0 || bodyIdx >= 0;

const trnLangName =
  languageNames[uiLang]?.[trnLang] ?? languageNames['en']?.[trnLang] ?? trnLang;
// The book language itself would make a degenerate pair, so it is not offered.
const dropdownLanguages = hasInlinePicker
  ? getEnabledLanguages()
      .filter((lang) => lang.code !== targetLang)
      .map((lang) => ({
        code: lang.code,
        name: languageNames[uiLang]?.[lang.code] ?? languageNames['en']?.[lang.code] ?? lang.name,
      }))
      .sort((a, b) => a.name.localeCompare(b.name, uiLang))
  : [];
---

<aside class="tool-app-note">
  <div class="tan-copy">
    <span class="tan-label">Put it into practice</span>
    <p>
      <strong>
        {leadIdx >= 0
          ? <>{lead.slice(0, leadIdx)}<InlineLangTrigger name={trnLangName} />{lead.slice(leadIdx + PLACEHOLDER.length)}</>
          : lead}
      </strong>
      {bodyIdx >= 0
        ? <>{body.slice(0, bodyIdx)}<InlineLangTrigger name={trnLangName} />{body.slice(bodyIdx + PLACEHOLDER.length)}</>
        : body}
    </p>
    {hasInlinePicker && <InlineLangMenu languages={dropdownLanguages} current={trnLang} />}
    <StoreLinksRow />
  </div>
  <div class:list={['tan-demo', !hasInlinePicker && 'tan-demo--picker']}>
    <ReaderDemo targetLang={targetLang} uiLang={trnLang} langPicker={!hasInlinePicker} menuLang={uiLang} />
  </div>
</aside>

<script>
  import { initInlineLangPicker } from '../scripts/inlineLangPicker';
  document.querySelectorAll('.tool-app-note').forEach((el) => initInlineLangPicker(el as HTMLElement));
</script>

<style>
  .tool-app-note {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px 28px;
    align-items: center;
    max-width: 760px;
    margin: 3rem auto 0;
    padding: 20px 24px;
    background: var(--background-alt, #232d3f);
    border-left: 3px solid var(--primary, #4ade80);
    border-radius: 8px;
    text-align: left;
  }

  /* Anchors the InlineLangMenu dropdown. */
  .tan-copy {
    position: relative;
  }

  /* The ReaderDemo phone is 320x640; scale it down without leaving layout gaps
     (transform keeps the layout box, the negative margins reclaim it). */
  .tan-demo {
    transform: scale(0.72);
    transform-origin: center;
    margin: -90px -45px;
  }

  /* With the widget's own 40px language picker on top the box is 680px tall. */
  .tan-demo--picker {
    margin: -95px -45px;
  }

  @media (max-width: 768px) {
    .tool-app-note {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .tan-copy {
      justify-self: stretch;
    }
    /* At this width the widget itself renders at 260x520; keep it unscaled. */
    .tan-demo {
      transform: none;
      margin: 8px 0 0;
    }
  }
  .tan-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary, #4ade80);
    margin-bottom: 8px;
  }
  .tool-app-note p {
    margin: 0;
    color: var(--text, rgba(255, 255, 255, 0.9));
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .tan-copy :global(.store-links-row) {
    margin-top: 12px;
  }
</style>
