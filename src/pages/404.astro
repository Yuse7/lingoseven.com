---
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages serves dist/404.html with a real 404 status for any unknown URL.
const title = 'Page not found | Lingo7';
const description =
  'This page does not exist. Explore the Lingo7 blog, free language tools, and app comparisons instead.';
---

<BaseLayout title={title} description={description} lang="en" noindex={true}>
  <script is:inline>
    // Pretty referral links /go/{code} and book links /b/{id} have no static
    // page on GitHub Pages and land here; hand them to the real page. The
    // Cloudflare redirect rule does the same before the request reaches
    // GitHub Pages; this is the fallback while the rule is absent.
    (function () {
      var m = location.pathname.match(/^\/go\/([a-z0-9-]{1,32})\/?$/i);
      if (m) return location.replace('/go/?p=' + m[1].toLowerCase());
      var b = location.pathname.match(/^\/b\/(pg\d{1,7})\/?$/i);
      if (b) {
        // Same shape as the Cloudflare rules: the whole query string rides along.
        var q = location.search.replace(/^\?/, '');
        location.replace('/b/?id=' + b[1].toLowerCase() + (q ? '&' + q : ''));
      }
    })();
  </script>
  <section class="nf">
    <div class="container">
      <p class="nf-code">404</p>
      <h1>Page not found</h1>
      <p class="nf-text">
        The page you are looking for does not exist or has moved. Here is where to go next:
      </p>
      <div class="nf-links">
        <a href="/" class="nf-link">Home</a>
        <a href="/en/blog/" class="nf-link">Blog</a>
        <a href="/tools/" class="nf-link">Free tools</a>
        <a href="/best-apps-to-read-books-in/" class="nf-link">Best reading apps</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: 160px 0 120px;
    text-align: center;
  }

  .nf-code {
    font-size: 4rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 8px;
  }

  .nf h1 {
    margin-bottom: 12px;
  }

  .nf-text {
    color: var(--text-light);
    margin-bottom: 28px;
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .nf-link {
    padding: 10px 20px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    transition: border-color 0.2s;
  }

  .nf-link:hover {
    border-color: var(--primary);
  }
</style>
