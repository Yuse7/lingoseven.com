---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolDirectAnswer from '../../components/ToolDirectAnswer.astro';

// Public affiliate program page (indexable). Terms live on the same page under
// the #terms anchor. The application form posts JSON to the backend affiliate
// endpoint; `website` is a hidden honeypot that must stay empty for humans.
// English-only for v1 (no [uiLang] localization yet). See
// docs/marketing/referral-program.md.

const APPLY_URL =
  'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api/affiliate/apply';

const canonicalUrl = 'https://lingoseven.com/partners/';
const title = 'Lingo7 Affiliate Program | Earn 50% for Life';
const description =
  'Join the Lingo7 affiliate program and earn 50% of every payment from readers you refer, for as long as they stay subscribed. Monthly payouts, no minimum, PayPal or bank transfer.';

const steps = [
  {
    n: '1',
    name: 'Apply',
    desc: 'Send us your channel or audience. We review and reply, usually within a few days.',
  },
  {
    n: '2',
    name: 'Get your link',
    desc: 'You receive a tracked link and a partner dashboard to watch clicks, referrals, and earnings.',
  },
  {
    n: '3',
    name: 'Earn 50% for life',
    desc: 'Every payment from a reader you refer pays you 50%, for as long as they stay subscribed.',
  },
];

const facts = [
  {
    k: 'Commission',
    v: '50% of every payment, for the lifetime of the subscription',
  },
  { k: 'Attribution', v: 'Last click, 30-day window' },
  {
    k: 'Payouts',
    v: 'Monthly, NET-30, no minimum, by PayPal or bank transfer',
  },
  { k: 'Refunds', v: 'Deducted from your next payout' },
  {
    k: 'In-app purchases',
    v: 'Tracked on iOS and Android (most reading apps pay nothing here)',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: canonicalUrl,
    description,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Lingo7',
      url: 'https://lingoseven.com/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://lingoseven.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Affiliate Program',
        item: canonicalUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <section class="partners">
    <div class="container">
      <header class="partners-head">
        <p class="partners-eyebrow">Affiliate program</p>
        <h1>Lingo7 Affiliate Program</h1>
        <p class="partners-intro">
          Earn 50% of every payment from readers you refer, for as long as they
          stay subscribed. Payouts are monthly with no minimum, by PayPal or
          bank transfer.
        </p>
        <div class="partners-cta">
          <a class="btn-primary" href="#apply">Apply now</a>
          <a class="btn-ghost" href="#terms">Read the terms</a>
        </div>
      </header>

      <ToolDirectAnswer
        lead={`The Lingo7 affiliate program pays 50% of every payment from readers you refer, for as long as they stay subscribed.`}
        body={`Payouts are monthly with no minimum, by PayPal or bank transfer. In-app purchases on iOS and Android are tracked, so you earn on sales that most reading apps never pay for.`}
      />

      <div class="partners-section">
        <h2>How it works</h2>
        <div class="steps-grid">
          {
            steps.map((s) => (
              <div class="step-card">
                <span class="step-n">{s.n}</span>
                <span class="step-name">{s.name}</span>
                <span class="step-desc">{s.desc}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="partners-section">
        <h2>Program facts</h2>
        <table class="facts-table">
          <tbody>
            {
              facts.map((f) => (
                <tr>
                  <th scope="row">{f.k}</th>
                  <td>{f.v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="partners-section" id="apply">
        <h2>Apply to the program</h2>
        <p class="section-intro">
          Tell us where your audience is. We reply by email, usually within a few
          days.
        </p>

        <form class="apply-form" id="apply-form" novalidate>
          <label class="field">
            <span class="field-label">Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="field">
            <span class="field-label">Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="field">
            <span class="field-label">Channel or profile URL</span>
            <input
              type="url"
              name="channel_url"
              placeholder="https://"
              required
            />
          </label>

          <label class="field">
            <span class="field-label">About your audience</span>
            <textarea
              name="audience_note"
              rows="4"
              placeholder="Who reads or watches you, roughly how many, and which languages they learn."
            ></textarea>
          </label>

          {/* Honeypot: hidden from humans, bots tend to fill it. */}
          <div class="hp-field" aria-hidden="true">
            <label>
              Website
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <button type="submit" class="btn-primary" id="apply-submit">
            Submit application
          </button>

          <p class="form-status" id="form-status" role="status" hidden></p>
        </form>

        <div class="form-success" id="form-success" hidden>
          <h3>Application received</h3>
          <p>
            Thank you. We have your details and will reply by email. If you do
            not hear back, write to <a href="mailto:support@lingoseven.com"
              >support@lingoseven.com</a
            >.
          </p>
        </div>
      </div>

      <div class="partners-section terms" id="terms">
        <h2>Terms</h2>
        <ol class="terms-list">
          <li>Commission is 50% of the gross payment amount.</li>
          <li>
            It continues for the lifetime of the subscription, as long as the
            referred reader keeps paying.
          </li>
          <li>
            Refunds and chargebacks are clawed back from your next payout.
          </li>
          <li>
            Self-referrals and bidding on Lingo7 brand terms in paid search are
            not allowed.
          </li>
          <li>We may pause a partner for suspected fraud.</li>
          <li>These terms can change with 30 days notice.</li>
          <li>
            Questions: <a href="mailto:support@lingoseven.com"
              >support@lingoseven.com</a
            >.
          </li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ APPLY_URL }}>
  (function () {
    var form = document.getElementById('apply-form');
    var submit = document.getElementById('apply-submit');
    var status = document.getElementById('form-status');
    var success = document.getElementById('form-success');
    if (!form) return;

    function showStatus(msg) {
      status.textContent = msg;
      status.hidden = false;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      status.hidden = true;

      var data = {
        name: form.elements['name'].value.trim(),
        email: form.elements['email'].value.trim(),
        channel_url: form.elements['channel_url'].value.trim(),
        audience_note: form.elements['audience_note'].value.trim(),
        website: form.elements['website'].value,
      };

      if (!data.name || !data.email || !data.channel_url) {
        showStatus('Please fill in your name, email, and channel URL.');
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Sending...';

      fetch(APPLY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (r) {
          if (!r.ok) throw new Error('bad status');
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })
        .catch(function () {
          submit.disabled = false;
          submit.textContent = 'Submit application';
          showStatus(
            'Something went wrong sending your application. Please check your connection and try again.'
          );
        });
    });
  })();
</script>

<style>
  .partners {
    padding: 120px 0 80px;
  }

  .partners-head {
    max-width: 720px;
    margin: 0 auto 8px;
    text-align: center;
  }

  .partners-eyebrow {
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }

  .partners-head h1 {
    font-size: 2.4rem;
    margin-bottom: 16px;
  }

  .partners-intro {
    color: var(--text-light);
    line-height: 1.6;
    font-size: 1.1rem;
  }

  .partners-cta {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius);
    background: var(--primary);
    color: #0f172a;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
  }

  .btn-primary:hover {
    background: var(--primary-dark);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .btn-ghost:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .partners-section {
    max-width: 760px;
    margin: 56px auto 0;
    scroll-margin-top: 96px;
  }

  .partners-section h2 {
    font-size: 1.6rem;
    margin-bottom: 20px;
  }

  .section-intro {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .step-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 20px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .step-n {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--primary);
    color: #0f172a;
    font-weight: 800;
  }

  .step-name {
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .step-desc {
    color: var(--text-light);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .facts-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .facts-table th,
  .facts-table td {
    text-align: left;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    line-height: 1.5;
  }

  .facts-table tr:last-child th,
  .facts-table tr:last-child td {
    border-bottom: none;
  }

  .facts-table th {
    color: var(--text);
    font-weight: 700;
    width: 34%;
    white-space: nowrap;
  }

  .facts-table td {
    color: var(--text-light);
  }

  .apply-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-label {
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .apply-form input,
  .apply-form textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--text);
    font-size: 1rem;
    font-family: inherit;
  }

  .apply-form input:focus,
  .apply-form textarea:focus {
    outline: none;
    border-color: var(--primary);
  }

  .apply-form textarea {
    resize: vertical;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .apply-form .btn-primary {
    align-self: flex-start;
  }

  .form-status {
    margin: 0;
    color: #fca5a5;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .form-success {
    background: var(--background-card);
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    padding: 28px;
  }

  .form-success h3 {
    color: var(--primary);
    margin-bottom: 10px;
  }

  .form-success p {
    color: var(--text-light);
    line-height: 1.6;
    margin: 0;
  }

  .terms-list {
    margin: 0;
    padding-left: 20px;
    color: var(--text-light);
  }

  .terms-list li {
    line-height: 1.6;
    margin-bottom: 12px;
  }

  a {
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .partners {
      padding: 96px 0 56px;
    }

    .partners-head h1 {
      font-size: 1.8rem;
    }

    .facts-table th {
      width: auto;
      white-space: normal;
    }

    .facts-table th,
    .facts-table td {
      display: block;
      padding: 12px 16px;
    }

    .facts-table th {
      padding-bottom: 4px;
      border-bottom: none;
    }
  }
</style>
