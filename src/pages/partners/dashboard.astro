---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Partner cabinet (noindex, excluded from the sitemap in astro.config.mjs).
// Token comes from ?t= or localStorage('l7_partner_token'). All rendering is
// client-side against GET /api/affiliate/portal?token=... See
// docs/marketing/referral-program.md.

const PORTAL_URL =
  'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api/affiliate/portal';

const title = 'Partner Dashboard | Lingo7';
const description = 'Your Lingo7 affiliate dashboard.';
---

<BaseLayout title={title} description={description} lang="en" noindex={true}>
  <section class="dash">
    <div class="container">
      <div class="dash-loading" id="dash-loading">Loading your dashboard...</div>

      <div class="dash-error" id="dash-error" hidden>
        <h1>This link is not valid</h1>
        <p>
          The dashboard link looks incorrect or has expired. Please use the link
          we sent you, or write to <a href="mailto:support@lingoseven.com"
            >support@lingoseven.com</a
          >.
        </p>
      </div>

      <div class="dash-body" id="dash-body" hidden>
        <header class="dash-head">
          <div>
            <p class="dash-eyebrow">Partner dashboard</p>
            <h1 id="partner-name"></h1>
            <p class="dash-status" id="partner-status"></p>
          </div>
        </header>

        <div class="dash-link" id="link-card">
          <span class="dash-link-label">Your link</span>
          <div class="dash-link-row">
            <input type="text" id="partner-link" readonly />
            <button type="button" class="btn-primary" id="copy-btn"
              >Copy</button
            >
          </div>
        </div>

        <div class="dash-promos" id="promos-card" hidden>
          <span class="dash-link-label">Your promo codes</span>
          <ul class="promo-list" id="promo-list"></ul>
        </div>

        <div class="cards-grid" id="cards-grid"></div>

        <div class="dash-section">
          <h2 id="activity-title">Activity</h2>
          <ul class="events-list" id="events-list"></ul>
          <p class="dash-empty" id="events-empty" hidden>No activity yet.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ PORTAL_URL }}>
  (function () {
    var TOKEN_KEY = 'l7_partner_token';

    var loading = document.getElementById('dash-loading');
    var errorBox = document.getElementById('dash-error');
    var body = document.getElementById('dash-body');

    function showError() {
      loading.hidden = true;
      body.hidden = true;
      errorBox.hidden = false;
    }

    // Resolve the token: URL ?t= wins and is persisted; otherwise localStorage.
    var url = new URL(window.location.href);
    var urlToken = url.searchParams.get('t');
    var token = urlToken || '';
    try {
      if (urlToken) {
        localStorage.setItem(TOKEN_KEY, urlToken);
      } else {
        token = localStorage.getItem(TOKEN_KEY) || '';
      }
    } catch (e) {
      // localStorage may be blocked; fall back to the URL token only.
    }

    if (!token) {
      showError();
      return;
    }

    // Refund rows are stored negative, so the sign goes in front of the $.
    function money(cents) {
      var n = typeof cents === 'number' ? cents : 0;
      return (n < 0 ? '-' : '') + '$' + (Math.abs(n) / 100).toFixed(2);
    }

    function esc(s) {
      var d = document.createElement('div');
      d.textContent = s == null ? '' : String(s);
      return d.innerHTML;
    }

    var KIND_LABELS = { monthly: 'Monthly', yearly: 'Yearly', trial: 'Trial' };
    var STATUS_LABELS = {
      accrued: 'Accrued',
      paid: 'Paid',
      reversed: 'Reversed',
    };

    var LANG_NAMES = null;
    try {
      LANG_NAMES = new Intl.DisplayNames(['en'], { type: 'language' });
    } catch (e) {
      // Old browser without Intl.DisplayNames: language codes stay as codes.
    }

    // 'es' -> 'Spanish'. Falls back to the uppercased code when the runtime has
    // no name for it (it then echoes the code back).
    function langName(code) {
      var raw = String(code || '').trim();
      if (!raw) return '';
      if (LANG_NAMES) {
        try {
          var name = LANG_NAMES.of(raw);
          if (name && name.toLowerCase() !== raw.toLowerCase()) return name;
        } catch (e) {}
      }
      return raw.toUpperCase();
    }

    // The pair is '<learning>-<native>', so the reader's own language leads:
    // 'es-ru' reads "Russian -> Spanish". Returns ready HTML (names escaped),
    // or '' for a row that carries no pair.
    function pairLabel(pair) {
      var parts = String(pair || '').split('-');
      if (parts.length !== 2 || !parts[0] || !parts[1]) return '';
      return esc(langName(parts[1])) + ' &rarr; ' + esc(langName(parts[0]));
    }

    // How the reader behind an activation arrived. A backend that predates the
    // split (before 2026-08-15) sends no `source`, and the row keeps the one
    // label it always had rather than guessing.
    function activationLabel(source) {
      if (source === 'link') return 'Activated via link';
      if (source === 'code') return 'Promo code entered';
      return 'Promo code activated';
    }

    // A refund keeps its own row with negative amounts. It is dimmed and
    // labeled, never hidden.
    function isRefund(p) {
      var type = String(p.event_type || '').toUpperCase();
      return type.indexOf('_REFUND') >= 0 || type === 'CANCELLATION';
    }

    // Day + time in the visitor's own locale. Falls back to the plain day for a
    // ledger row written before `ts` joined the contract.
    function timeLabel(ts, fallbackDay) {
      var ms = ts ? Date.parse(ts) : NaN;
      if (isNaN(ms)) return fallbackDay || '';
      try {
        return new Date(ms).toLocaleString(undefined, {
          dateStyle: 'medium',
          timeStyle: 'short',
        });
      } catch (e) {
        // Old browser without dateStyle/timeStyle: its default format will do.
        return new Date(ms).toLocaleString();
      }
    }

    // Position on the feed. A row with no `ts` only knows its day, so it sorts
    // from the start of that day.
    function sortKey(ts, fallbackDay) {
      var ms = ts ? Date.parse(ts) : NaN;
      if (isNaN(ms) && fallbackDay) ms = Date.parse(fallbackDay + 'T00:00:00Z');
      return isNaN(ms) ? 0 : ms;
    }

    // Copy `text` and flash "Copied" on `btn` for 1.6s. `input`, when given, is a
    // real field to select for the execCommand fallback; without one we use a
    // throwaway field, since that fallback can only copy a selection.
    function copyText(text, btn, input) {
      var temp = null;
      var field = input;
      if (!field) {
        temp = document.createElement('input');
        temp.value = text;
        temp.setAttribute('readonly', '');
        temp.style.position = 'fixed';
        temp.style.top = '-1000px';
        document.body.appendChild(temp);
        field = temp;
      }
      field.select();
      var done = function () {
        btn.textContent = 'Copied';
        setTimeout(function () {
          btn.textContent = 'Copy';
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        try {
          document.execCommand('copy');
        } catch (e) {}
        done();
      }
      if (temp) temp.parentNode.removeChild(temp);
    }

    fetch(PORTAL_URL + '?token=' + encodeURIComponent(token))
      .then(function (r) {
        if (!r.ok) throw new Error('bad status');
        return r.json();
      })
      .then(function (d) {
        render(d);
      })
      .catch(function () {
        showError();
      });

    function render(d) {
      var partner = d.partner || {};
      var totals = d.totals || {};
      var purchases = d.purchases || [];
      // Added 2026-08-07; a backend that predates it sends no activations.
      var activations = d.activations || [];
      // Added 2026-08-26; a backend that predates it sends no payouts.
      var payouts = d.payouts || [];
      var promos = d.promos || [];

      document.getElementById('partner-name').textContent =
        partner.name || 'Partner';

      var statusEl = document.getElementById('partner-status');
      if (partner.status && partner.status !== 'active') {
        statusEl.textContent = 'Status: ' + partner.status;
      } else {
        statusEl.hidden = true;
      }

      // A partner may have promo codes only, with no referral link: then the whole
      // link card goes away instead of showing an empty field.
      if (partner.link) {
        var linkInput = document.getElementById('partner-link');
        linkInput.value = partner.link;

        var copyBtn = document.getElementById('copy-btn');
        copyBtn.addEventListener('click', function () {
          copyText(linkInput.value, copyBtn, linkInput);
        });
      } else {
        document.getElementById('link-card').hidden = true;
      }

      if (promos.length) {
        var promoList = document.getElementById('promo-list');
        promoList.innerHTML = promos
          .map(function (p) {
            var days = Number(p.duration_days) || 0;
            var uses = Number(p.redemptions) || 0;
            var meta = [];
            if (days) meta.push(days === 1 ? '1 day free' : days + ' days free');
            meta.push(uses === 1 ? '1 use' : uses + ' uses');
            if (!p.is_active) meta.push('Inactive');
            return (
              '<li class="promo-row' +
              (p.is_active ? '' : ' is-inactive') +
              '"><code class="promo-code">' +
              esc(p.code) +
              '</code><span class="promo-meta">' +
              esc(meta.join(' · ')) +
              '</span><button type="button" class="promo-copy">Copy</button></li>'
            );
          })
          .join('');

        promoList.addEventListener('click', function (e) {
          var btn = e.target.closest && e.target.closest('.promo-copy');
          if (!btn) return;
          var codeEl = btn.parentNode.querySelector('.promo-code');
          copyText(codeEl ? codeEl.textContent : '', btn);
        });

        document.getElementById('promos-card').hidden = false;
      }

      var cards = [{ label: 'Clicks (30d)', value: totals.clicks_30d || 0 }];
      // Installs are split by how the reader arrived (added 2026-08-15). A
      // backend that predates the split sends only the combined number, and
      // then the card reads as it always did.
      if (totals.attributions_link === undefined) {
        cards.push({
          label: 'Referred installs',
          value: totals.attributions || 0,
        });
      } else {
        cards.push({
          label: 'Link installs',
          value: totals.attributions_link || 0,
        });
        cards.push({
          label: 'Code redemptions',
          value: totals.attributions_promo || 0,
        });
      }
      cards.push({
        label: 'Pending payout',
        value: money(totals.pending_payout_cents),
      });
      cards.push({ label: 'Paid to date', value: money(totals.paid_cents) });
      document.getElementById('cards-grid').innerHTML = cards
        .map(function (c) {
          return (
            '<div class="stat-card"><span class="stat-value">' +
            esc(c.value) +
            '</span><span class="stat-label">' +
            esc(c.label) +
            '</span></div>'
          );
        })
        .join('');

      // One feed, newest first: promo activations, payments and the transfers
      // that settled them, interleaved.
      var feed = activations
        .map(function (a) {
          var langs = pairLabel(a.pair);
          return {
            at: sortKey(a.ts, null),
            html:
              '<li class="event-row is-activation"><span class="event-date">' +
              esc(timeLabel(a.ts, null)) +
              '</span><span class="event-type">' +
              esc(activationLabel(a.source)) +
              (a.email ? ' · ' + esc(a.email) : '') +
              (langs ? ' · ' + langs : '') +
              '</span></li>',
          };
        })
        .concat(
          purchases.map(function (p) {
            var refund = isRefund(p);
            var details = [
              esc(KIND_LABELS[p.kind] || 'Subscription'),
              esc(money(p.amount_cents)),
            ];
            if (p.email) details.push(esc(p.email));
            var langs = pairLabel(p.pair);
            if (langs) details.push(langs);

            return {
              at: sortKey(p.ts, p.date),
              html:
                '<li class="event-row' +
                (refund ? ' is-refund' : '') +
                '"><span class="event-date">' +
                esc(timeLabel(p.ts, p.date)) +
                '</span><span class="event-type">' +
                details.join(' · ') +
                '</span><span class="event-amount">your cut ' +
                esc(money(p.commission_cents)) +
                '</span><span class="event-status">' +
                esc(
                  refund ? 'Refund' : STATUS_LABELS[p.status] || p.status || '',
                ) +
                '</span></li>',
            };
          }),
        )
        .concat(
          // A transfer carries no time of day: the admin states the day the
          // money left, so the row sorts from the start of that day.
          payouts.map(function (p) {
            return {
              at: sortKey(null, p.paid_at),
              html:
                '<li class="event-row is-payout"><span class="event-date">' +
                esc(timeLabel(null, p.paid_at)) +
                '</span><span class="event-type">Payout</span>' +
                '<span class="event-amount">' +
                esc(money(p.amount_cents)) +
                '</span></li>',
            };
          }),
        );

      var eventsList = document.getElementById('events-list');
      if (feed.length) {
        feed.sort(function (a, b) {
          return b.at - a.at;
        });
        // The feed mixes three different things, so the title splits the count:
        // gift activations of the promo code, actual payments, and the money
        // sent to the partner. One number here once read as "7 activations"
        // while the code showed "6 uses".
        var titleParts = [];
        if (activations.length) {
          titleParts.push(
            activations.length +
              (activations.length === 1 ? ' activation' : ' activations'),
          );
        }
        if (purchases.length) {
          titleParts.push(
            purchases.length +
              (purchases.length === 1 ? ' purchase' : ' purchases'),
          );
        }
        if (payouts.length) {
          titleParts.push(
            payouts.length + (payouts.length === 1 ? ' payout' : ' payouts'),
          );
        }
        document.getElementById('activity-title').textContent =
          'Activity · ' + titleParts.join(' · ');
        eventsList.innerHTML = feed
          .map(function (item) {
            return item.html;
          })
          .join('');
      } else {
        eventsList.hidden = true;
        document.getElementById('events-empty').hidden = false;
      }

      loading.hidden = true;
      body.hidden = false;
    }
  })();
</script>

<style>
  .dash {
    padding: 120px 0 80px;
    min-height: 60vh;
  }

  .dash-loading,
  .dash-empty {
    color: var(--text-light);
  }

  .dash-loading {
    text-align: center;
    padding: 40px 0;
  }

  .dash-error {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .dash-error h1 {
    font-size: 1.8rem;
    margin-bottom: 12px;
  }

  .dash-error p {
    color: var(--text-light);
    line-height: 1.6;
  }

  .dash-body {
    max-width: 860px;
    margin: 0 auto;
  }

  .dash-eyebrow {
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin-bottom: 6px;
  }

  .dash-head h1 {
    font-size: 2rem;
  }

  .dash-status {
    color: var(--text-light);
    margin-top: 6px;
  }

  .dash-link {
    margin: 28px 0;
    padding: 20px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .dash-link-label {
    display: block;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .dash-link-row {
    display: flex;
    gap: 10px;
  }

  .dash-link-row input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
  }

  .btn-primary {
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius);
    background: var(--primary);
    color: #0f172a;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .btn-primary:hover {
    background: var(--primary-dark);
  }

  .dash-promos {
    margin: 28px 0;
    padding: 20px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .promo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .promo-list :global(.promo-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .promo-list :global(.promo-row.is-inactive) {
    opacity: 0.55;
  }

  .promo-list :global(.promo-code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .promo-list :global(.promo-meta) {
    flex: 1;
    color: var(--text-light);
    font-size: 0.85rem;
  }

  .promo-list :global(.promo-copy) {
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    font-weight: 600;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .promo-list :global(.promo-copy:hover) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    margin-bottom: 40px;
  }

  /* Cards, table rows and event rows are injected via innerHTML, so they miss
     Astro's scoped attribute — style them through :global() (site pattern for
     dynamic widget DOM). */
  .cards-grid :global(.stat-card) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cards-grid :global(.stat-value) {
    color: var(--text);
    font-size: 1.6rem;
    font-weight: 800;
  }

  .cards-grid :global(.stat-label) {
    color: var(--text-light);
    font-size: 0.85rem;
  }

  .dash-section {
    margin-top: 40px;
  }

  .dash-section h2 {
    font-size: 1.4rem;
    margin-bottom: 16px;
  }

  .events-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .events-list :global(.event-row) {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: var(--background-card);
    border-bottom: 1px solid var(--border);
  }

  .events-list :global(.event-row:last-child) {
    border-bottom: none;
  }

  /* A refund stays on the list, quieter than the purchase it claws back. */
  .events-list :global(.event-row.is-refund) {
    opacity: 0.55;
  }

  /* An activation moves no money, so it carries no amount column. The green dot
     tells it apart from a payment at a glance. */
  .events-list :global(.event-row.is-activation .event-type::before) {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--primary);
    vertical-align: middle;
  }

  /* A payout is money leaving us, not coming in, so it gets its own amber dot
     instead of the activation's green one. */
  .events-list :global(.event-row.is-payout .event-type::before) {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: #f97316;
    vertical-align: middle;
  }

  .events-list :global(.event-date) {
    color: var(--text-light);
    font-size: 0.85rem;
    min-width: 148px;
  }

  .events-list :global(.event-type) {
    color: var(--text);
    font-weight: 600;
    flex: 1;
  }

  .events-list :global(.event-amount) {
    color: var(--primary);
    font-weight: 700;
  }

  .events-list :global(.event-status) {
    color: var(--text-light);
    font-size: 0.85rem;
    text-transform: capitalize;
  }

  a {
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .dash {
      padding: 96px 0 56px;
    }

    .dash-head h1 {
      font-size: 1.6rem;
    }

    .events-list :global(.event-row) {
      flex-wrap: wrap;
      gap: 8px 14px;
    }

    .promo-list :global(.promo-row) {
      flex-wrap: wrap;
      gap: 8px 12px;
    }
  }
</style>
