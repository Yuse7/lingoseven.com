---
// Affiliate redirect page: /go/?p={code} (docs/marketing/referral-program.md).
// Logs the click on the backend, then forwards to the store. Android carries
// the code through the Play install referrer; on iOS the button tap copies a
// pasteboard token that the app reads on first launch. Desktop shows a QR code
// pointing back to this same URL, so the phone that scans it runs the full
// attribution flow. Deliberately not localized (utility page, noindex,
// excluded from the sitemap in astro.config.mjs).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lingo7</title>
    <style>
      [hidden] {
        display: none !important;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        background: #f7f6f3;
        color: #1f2328;
      }
      main {
        max-width: 100%;
      }
      .card {
        text-align: center;
        padding: 2rem 1.5rem;
        max-width: 22rem;
        box-sizing: border-box;
      }
      .logo {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
      }
      p {
        margin: 0 0 1.25rem;
        color: #4b5563;
      }
      .store-btn {
        display: inline-block;
        padding: 0.85rem 1.6rem;
        border-radius: 0.75rem;
        background: #1f2328;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
      }
      .qr-box {
        width: 12rem;
        height: 12rem;
        margin: 0 auto 1rem;
        padding: 0.5rem;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
      }
      .qr-box svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .copy-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        align-items: center;
        font-size: 0.9rem;
      }
      .copy-row code {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        padding: 0.35rem 0.6rem;
        overflow-wrap: anywhere;
      }
      .copy-btn {
        padding: 0.35rem 0.8rem;
        border: 1px solid #1f2328;
        border-radius: 0.5rem;
        background: #1f2328;
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="card">
        <div class="logo">Lingo7</div>
        <p id="msg">Taking you to the store&hellip;</p>
        <a id="ios-btn" class="store-btn" hidden href="https://apps.apple.com/app/id6471030440">
          Get Lingo7 in the App Store
        </a>
        <div id="qr-wrap" hidden>
          <div id="qr-box" class="qr-box"></div>
          <p class="copy-row">
            <code id="link-text"></code>
            <button id="copy-btn" class="copy-btn" type="button">Copy</button>
          </p>
        </div>
        <noscript>
          <p>
            <a href="https://apps.apple.com/app/id6471030440">App Store</a>
            &middot;
            <a href="https://play.google.com/store/apps/details?id=com.doublereading">Google Play</a>
          </p>
        </noscript>
      </div>
    </main>
    <script is:inline>
      (function () {
        var API = 'https://backend-cb6yl.ondigitalocean.app/dev-backend4/api/affiliate/click';
        var PLAY = 'https://play.google.com/store/apps/details?id=com.doublereading';
        var APPSTORE = 'https://apps.apple.com/app/id6471030440';

        var raw = new URLSearchParams(location.search).get('p') || '';
        var code = /^[a-z0-9-]{1,32}$/i.test(raw) ? raw.toLowerCase() : null;
        var ua = navigator.userAgent;
        var platform = /android/i.test(ua)
          ? 'android'
          : /iphone|ipad|ipod/i.test(ua)
            ? 'ios'
            : 'web';

        if (!code) {
          location.replace('/');
          return;
        }

        if (platform === 'web') {
          // Desktop: no store to redirect to. Show a QR code with this same
          // /go/ URL, so the phone that scans it gets proper attribution.
          // No direct store links here: installs that bypass /go/ on the
          // phone would lose the partner code.
          document.getElementById('msg').textContent =
            'Lingo7 is a mobile app. Scan the code with your phone, or send yourself the link:';
          var prettyLink = 'https://lingoseven.com/go/' + code;
          document.getElementById('link-text').textContent = 'lingoseven.com/go/' + code;
          var copyBtn = document.getElementById('copy-btn');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            copyBtn.addEventListener('click', function () {
              navigator.clipboard.writeText(prettyLink).then(function () {
                copyBtn.textContent = 'Copied';
              }, function () {});
            });
          } else {
            copyBtn.hidden = true;
          }
          var wrap = document.getElementById('qr-wrap');
          var lib = document.createElement('script');
          lib.src = '/js/qrcode.min.js';
          lib.onload = function () {
            var qr = qrcode(0, 'M');
            qr.addData('https://lingoseven.com/go/?p=' + code);
            qr.make();
            document.getElementById('qr-box').innerHTML = qr.createSvgTag({
              cellSize: 4,
              margin: 16,
              scalable: true,
              title: 'Get Lingo7',
            });
            wrap.hidden = false;
          };
          lib.onerror = function () {
            // No QR, but the store links still work.
            document.getElementById('qr-box').hidden = true;
            wrap.hidden = false;
          };
          document.head.appendChild(lib);
        }

        var timeout = new Promise(function (resolve) {
          setTimeout(function () {
            resolve(null);
          }, 1200);
        });
        var click = fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: code, platform: platform }),
          keepalive: true,
        })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .catch(function () {
            return null;
          });

        Promise.race([click, timeout]).then(function (resp) {
          var token = resp && resp.token ? String(resp.token) : null;

          if (platform === 'android') {
            location.replace(PLAY + '&referrer=' + encodeURIComponent('lingo7ref=' + code));
            return;
          }

          if (platform === 'ios') {
            var btn = document.getElementById('ios-btn');
            document.getElementById('msg').textContent = 'One tap to continue:';
            btn.hidden = false;
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              var done = function () {
                location.href = APPSTORE;
              };
              if (token && navigator.clipboard && navigator.clipboard.writeText) {
                var id = token.indexOf('l7r:') === 0 ? token.slice(4) : token;
                navigator.clipboard
                  .writeText('https://lingoseven.com/go/#l7r=' + id)
                  .then(done, done);
              } else {
                done();
              }
            });
          }
        });
      })();
    </script>
  </body>
</html>
