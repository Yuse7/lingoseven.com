---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDemoCta from '../../components/AppDemoCta.astro';
import { getLanguageByCode, getEnabledLanguages } from '../../data/languages';
import { codeToSlug } from '../../data/languageSlugs';
import { appsForLanguage, featLabel, AS_OF, type ReadingApp } from '../../data/readingApps';

// One static page per enabled language that has a URL slug.
export function getStaticPaths() {
  return getEnabledLanguages()
    .filter((l) => codeToSlug[l.code])
    .map((l) => ({ params: { lang: codeToSlug[l.code] }, props: { code: l.code } }));
}

const { code } = Astro.props;
const lang = getLanguageByCode(code)!;
const name = lang.name;
const slug = codeToSlug[code];

// Apps that actually support this language, ranked by fit for reading real books.
const apps = appsForLanguage(code);
const top = apps[0];
const others = apps.slice(1);
const n = apps.length;

// Feature columns for the comparison table (order matters).
const COLS: { key: keyof ReadingApp['feats']; label: string }[] = [
  { key: 'importBooks', label: 'Read your own books' },
  { key: 'parallel', label: 'Parallel translation' },
  { key: 'audio', label: 'Synced audio' },
  { key: 'srs', label: 'Vocabulary trainer' },
  { key: 'speaking', label: 'Speaking practice' },
];

const canonicalUrl = `https://lingoseven.com/best-apps-to-read-books-in/${slug}/`;
const title = `Best Apps to Read Books in ${name} (2026) | Lingo7`;
const description =
  `The best apps to read books in ${name}, ranked and compared for 2026: parallel translation, audio, vocabulary tools and language coverage. Honest side-by-side comparison.`;

// GEO direct answer: 40 to 60 words, definitional first sentence, names the pick + count.
const otherNames = others.map((a) => a.name);
const directAnswer =
  `The best apps to read books in ${name} are parallel-reading apps that show the original text beside a translation, with audio and a way to save new words. ` +
  `Ranked for ${name}, ${top.name} leads for reading full books you choose` +
  (otherNames.length
    ? `, followed by ${otherNames.slice(0, 3).join(', ')}. Each fits a different reader; the comparison below is honest about the trade-offs.`
    : `. The comparison below is honest about what it does and does not do.`);

const learnUrl = `/en/learn/${slug}/`;
const bestBooksUrl = `/en/blog/best-books-to-learn-${slug}-through-reading/`;

// Other-language cross-links (every other enabled language).
const otherLangs = getEnabledLanguages()
  .filter((l) => l.code !== code && codeToSlug[l.code])
  .map((l) => ({ name: l.name, flag: l.flag, slug: codeToSlug[l.code] }))
  .sort((a, b) => a.name.localeCompare(b.name));

const faq = [
  {
    question: `What is the best app to read books in ${name}?`,
    answer:
      `For reading full books in ${name} with the original and a translation side by side, ${top.name} is the most complete option: ${top.tagline} ` +
      (top.slug === 'lingo7'
        ? `It reads any book you upload, not just a fixed catalog, and sends tapped words to a spaced-repetition trainer, across ${top.languages.length} languages.`
        : ``) +
      ` The right pick still depends on whether you want to read your own books or a fixed catalog, and whether you need audio, which the table above lays out.`,
  },
  {
    question: `Can you learn ${name} just by reading?`,
    answer:
      `Reading does a lot of the work: it builds vocabulary and grammatical intuition through repeated exposure in real context. It is most effective when the text is slightly above your level, you can check meaning instantly (tap a word or read a parallel translation), and you add listening. Pair reading with a little speaking practice and it covers most of the skills you need in ${name}.`,
  },
  {
    question: `Are there apps to read your own books in ${name}?`,
    answer:
      apps.some((a) => a.feats.importBooks === true)
        ? `Yes. ${apps
            .filter((a) => a.feats.importBooks === true)
            .map((a) => a.name)
            .join(' and ')} let you import your own files (for example EPUB or PDF) and read them in ${name} with translation support, rather than being limited to a built-in catalog. Most other reading apps only offer their own fixed library of stories.`
        : `Most reading apps for ${name} offer a fixed catalog of graded stories rather than letting you import your own files. If reading a specific book matters to you, check the "Read your own books" column above before choosing.`,
  },
  {
    question: `What is the best free app to read in ${name}?`,
    answer:
      `Most of these apps have a free tier and a paid upgrade. ${top.name} has a free tier, so you can start reading in ${name} at no cost and decide later. Free tiers usually limit how much of the catalog you can open or add ads; the paid plans remove those limits. Prices are in the table above (as of ${AS_OF}).`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Best apps to read books in ${name}`,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: apps.length,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: a.url,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Best apps to read books',
        item: 'https://lingoseven.com/best-apps-to-read-books-in/',
      },
      { '@type': 'ListItem', position: 3, name, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="bapp">
    <div class="container">
      <header class="bapp-head">
        <p class="bapp-eyebrow"><a href="/best-apps-to-read-books-in/">Best apps to read books</a></p>
        <h1>Best apps to read books in <span>{name}</span> <span class="bapp-year">(2026)</span></h1>
      </header>

      <p class="bapp-answer">{directAnswer}</p>

      <ol class="bapp-list">
        {
          apps.map((a, i) => (
            <li class="bapp-card">
              <span class="bapp-rank">{i + 1}</span>
              <div class="bapp-card-body">
                <div class="bapp-card-top">
                  <h2 class="bapp-name">{a.name}</h2>
                  {a.slug === 'lingo7' && <span class="bapp-badge">Best for reading full books</span>}
                </div>
                <p class="bapp-tagline">{a.tagline}</p>
                <ul class="bapp-facts">
                  <li><strong>Reading:</strong> {a.catalog}</li>
                  <li><strong>Audio:</strong> {featLabel(a.feats.audio)}</li>
                  <li><strong>Languages:</strong> {a.languageNote}</li>
                  <li><strong>Price:</strong> {a.pricing}</li>
                </ul>
                <p class="bapp-verdict"><strong>Best for:</strong> {a.bestFor}</p>
                {a.slug !== 'lingo7' && (
                  <a class="bapp-ext" href={a.url} target="_blank" rel="noopener nofollow">Visit {a.name} &rarr;</a>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="bapp-table-wrap">
        <h2>{name} reading apps compared</h2>
        <p class="bapp-table-note">Feature comparison, as of {AS_OF}.</p>
        <div class="bapp-table-scroll">
          <table class="bapp-table">
            <thead>
              <tr>
                <th scope="col">App</th>
                {COLS.map((c) => <th scope="col">{c.label}</th>)}
                <th scope="col">Languages</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {
                apps.map((a) => (
                  <tr class={a.slug === 'lingo7' ? 'bapp-row-us' : ''}>
                    <th scope="row">{a.name}</th>
                    {COLS.map((c) => (
                      <td data-v={featLabel(a.feats[c.key])}>{featLabel(a.feats[c.key])}</td>
                    ))}
                    <td>{a.languageNote}</td>
                    <td>{a.priceShort}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <AppDemoCta
        title={`Read real books in ${name}, free to start`}
        text={`Lingo7 lets you read any book in ${name}, the built-in catalog or your own upload, with the ` +
          `original and a sentence-by-sentence {uiLang} translation side by side, native-narrated audio, and ` +
          `a tap to send new words to a review deck. Free to start.`}
        targetLang={code}
      />

      <div class="bapp-explainer">
        <h2>How we ranked these {name} reading apps</h2>
        <p>
          This list is about one job: <strong>reading real books in {name}</strong>. We ranked each app on
          how well it does that, in this order: whether you can read the <strong>book you actually want</strong>
          (your own upload, not just a fixed catalog), whether it shows a <strong>parallel translation</strong>
          so you rarely stall, whether it has <strong>audio</strong> to read and listen at once, whether it
          turns reading into <strong>vocabulary</strong> you keep, and how many languages it covers.
        </p>
        <p>
          Every fact in the table is checked against each app's own store listing and site (as of {AS_OF}); we
          link out so you can verify. This guide is published by Lingo7, so treat our own entry with healthy
          skepticism and compare the columns yourself. We have tried to be accurate and fair about what every
          app does well, and where it falls short, including ours.
        </p>
        <p>
          This list only includes apps that genuinely support reading in {name}. If you already read on a
          Kindle, its bilingual dictionaries and translate feature work for any book you own, and the
          open-source reader Lute lets advanced learners import almost anything, both without a parallel
          translation or synced audio.
        </p>
      </div>

      <div class="bapp-notes">
        <h2>The short version on each app</h2>
        {
          apps.map((a) => (
            <div class="bapp-note">
              <h3>{a.name}</h3>
              <p class="bapp-note-line"><strong>Strong:</strong> {a.strengths[0]}</p>
              <p class="bapp-note-line"><strong>Limit:</strong> {a.limits[0]}</p>
            </div>
          ))
        }
      </div>

      <div class="bapp-links">
        <h2>Keep going with {name}</h2>
        <div class="bapp-links-grid">
          <a class="bapp-link" href={learnUrl}>Learn {name} by reading &rarr;</a>
          <a class="bapp-link" href={bestBooksUrl}>Best books to learn {name} &rarr;</a>
          <a class="bapp-link" href="/compare/">Compare Lingo7 with other reading apps &rarr;</a>
        </div>
      </div>

      <div class="bapp-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>

      <div class="bapp-others">
        <h2>Best apps to read books in another language</h2>
        <div class="bapp-others-grid">
          {
            otherLangs.map((o) => (
              <a class="bapp-other" href={`/best-apps-to-read-books-in/${o.slug}/`}>
                <span class="bapp-other-flag">{o.flag}</span>
                {o.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bapp { padding: 3rem 0 4rem; }
  .bapp-head { max-width: 820px; margin: 0 auto 1.2rem; text-align: center; }
  .bapp-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    font-weight: 700; margin: 0 0 0.5rem;
  }
  .bapp-eyebrow a { color: var(--primary); text-decoration: none; }
  .bapp-eyebrow a:hover { text-decoration: underline; }
  .bapp-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0; }
  .bapp-head h1 span { color: var(--primary); }
  .bapp-head h1 .bapp-year { color: var(--text-muted, #9fb0c3); font-weight: 700; }

  .bapp-answer {
    max-width: 760px; margin: 0 auto; text-align: left;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 16px; padding: 1.3rem 1.5rem;
    color: var(--text, #e8eef5); font-size: 1.05rem; line-height: 1.65;
  }

  .bapp-list { max-width: 820px; margin: 2.5rem auto 0; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .bapp-card {
    display: grid; grid-template-columns: 2.6rem 1fr; gap: 1rem; align-items: start;
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px; padding: 1.2rem 1.3rem;
  }
  .bapp-rank {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: rgba(74, 222, 128, 0.14); color: var(--primary); font-weight: 800; font-size: 1.1rem;
  }
  .bapp-card-body { min-width: 0; }
  .bapp-card-top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .bapp-name { font-size: 1.25rem; margin: 0; }
  .bapp-badge {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--primary); background: rgba(74, 222, 128, 0.12);
    border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 999px; padding: 0.2rem 0.6rem;
  }
  .bapp-tagline { color: var(--text, #e8eef5); margin: 0.5rem 0 0.7rem; line-height: 1.5; }
  .bapp-facts { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.25rem; }
  .bapp-facts li { color: var(--text-muted, #9fb0c3); font-size: 0.92rem; line-height: 1.45; }
  .bapp-facts strong { color: var(--text, #e8eef5); font-weight: 600; }
  .bapp-verdict { color: var(--text-muted, #9fb0c3); font-size: 0.92rem; margin: 0.6rem 0 0; line-height: 1.45; }
  .bapp-verdict strong { color: var(--text, #e8eef5); }
  .bapp-ext {
    display: inline-block; margin-top: 0.7rem; color: var(--primary);
    font-weight: 600; font-size: 0.9rem; text-decoration: none;
  }
  .bapp-ext:hover { text-decoration: underline; }

  .bapp-table-wrap { max-width: 900px; margin: 3rem auto 0; }
  .bapp-table-wrap h2 { font-size: 1.5rem; margin: 0 0 0.3rem; text-align: center; }
  .bapp-table-note { color: var(--text-muted, #9fb0c3); font-size: 0.85rem; text-align: center; margin: 0 0 1.2rem; }
  .bapp-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .bapp-table {
    width: 100%; border-collapse: collapse; min-width: 640px;
    font-size: 0.9rem;
  }
  .bapp-table th, .bapp-table td {
    padding: 0.7rem 0.8rem; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bapp-table thead th {
    color: var(--text-muted, #9fb0c3); font-weight: 600; font-size: 0.82rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .bapp-table tbody th[scope='row'] { text-align: left; color: var(--text, #e8eef5); font-weight: 700; }
  .bapp-table td { color: var(--text-muted, #9fb0c3); }
  .bapp-table td[data-v='Yes'] { color: var(--primary); font-weight: 700; }
  .bapp-table .bapp-row-us { background: rgba(74, 222, 128, 0.07); }
  .bapp-table .bapp-row-us th[scope='row'] { color: var(--primary); }

  .bapp-explainer, .bapp-notes, .bapp-links, .bapp-faq, .bapp-others { max-width: 820px; margin: 3rem auto 0; }
  .bapp-explainer { max-width: 760px; }
  .bapp-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .bapp-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }
  .bapp-explainer strong { color: var(--text, #e8eef5); }

  .bapp-notes h2 { font-size: 1.5rem; margin: 0 0 1.2rem; text-align: center; }
  .bapp-note {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px;
    padding: 1rem 1.2rem; margin-bottom: 0.7rem;
  }
  .bapp-note h3 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .bapp-note-line { margin: 0.2rem 0; color: var(--text-muted, #9fb0c3); font-size: 0.92rem; line-height: 1.5; }
  .bapp-note-line strong { color: var(--text, #e8eef5); }

  .bapp-links h2 { font-size: 1.3rem; margin: 0 0 1rem; text-align: center; }
  .bapp-links-grid { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
  .bapp-link {
    color: var(--primary); font-weight: 600; text-decoration: none; font-size: 0.95rem;
    border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 999px; padding: 0.5rem 1rem;
    background: rgba(74, 222, 128, 0.06);
  }
  .bapp-link:hover { background: rgba(74, 222, 128, 0.12); }

  .bapp-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .bapp-faq details {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
  }
  .bapp-faq summary { cursor: pointer; font-weight: 600; }
  .bapp-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }

  .bapp-others { text-align: center; }
  .bapp-others h2 { font-size: 1.3rem; margin: 0 0 1rem; }
  .bapp-others-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .bapp-other {
    display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;
    color: var(--text, #e8eef5); font-weight: 600; font-size: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; padding: 0.35rem 0.8rem;
    background: rgba(255, 255, 255, 0.03); transition: all 0.12s ease;
  }
  .bapp-other:hover { border-color: var(--primary); color: var(--primary); }
  .bapp-other-flag { font-size: 1rem; }

  @media (max-width: 600px) {
    .bapp-card { grid-template-columns: 2.2rem 1fr; gap: 0.7rem; padding: 1rem; }
    .bapp-answer { font-size: 1rem; }
  }
</style>
