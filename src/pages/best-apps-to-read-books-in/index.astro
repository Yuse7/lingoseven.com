---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDemoCta from '../../components/AppDemoCta.astro';
import { getEnabledLanguages } from '../../data/languages';
import { codeToSlug } from '../../data/languageSlugs';
import { rankedApps, featLabel, AS_OF, type ReadingApp } from '../../data/readingApps';

const apps = rankedApps();
const top = apps[0];

const langs = getEnabledLanguages()
  .filter((l) => codeToSlug[l.code])
  .map((l) => ({ name: l.name, flag: l.flag, slug: codeToSlug[l.code] }))
  .sort((a, b) => a.name.localeCompare(b.name));

const COLS: { key: keyof ReadingApp['feats']; label: string }[] = [
  { key: 'importBooks', label: 'Your own books' },
  { key: 'parallel', label: 'Parallel translation' },
  { key: 'audio', label: 'Synced audio' },
  { key: 'srs', label: 'Vocabulary trainer' },
  { key: 'speaking', label: 'Speaking practice' },
];

const canonicalUrl = 'https://lingoseven.com/best-apps-to-read-books-in/';
const title = 'Best Apps to Read Books in a Foreign Language (2026) | Lingo7';
const description =
  `The best apps to read books in a foreign language, compared for 2026: parallel translation, audio, imports and language coverage. Pick your language for a ranked, honest list.`;

const directAnswer =
  `The best apps to read books in a foreign language are parallel-reading apps that show the original text beside a translation, add audio, and turn the words you tap into review material. ` +
  `The strongest options are ${apps.slice(0, 3).map((a) => a.name).join(', ')}. They differ most in whether you can read your own books and how many languages they cover.`;

const faq = [
  {
    question: 'What is the best app to read books in a foreign language?',
    answer:
      `For reading full books with the original and a translation side by side, ${top.name} is the most complete: ${top.tagline} The best choice for you depends on your language and whether you want to read your own books or a fixed catalog of graded stories, which the comparison covers. Pick your language above for a ranked list.`,
  },
  {
    question: 'Can you learn a language just by reading books?',
    answer:
      'Reading builds vocabulary and grammatical intuition through repeated exposure in real context, and it is one of the most efficient ways to grow a language once you have the basics. It works best when the text is a little above your level, you can check meaning instantly with a tap or a parallel translation, and you add audio so you connect the written word to its sound.',
  },
  {
    question: 'Which reading apps let you import your own books?',
    answer:
      `${apps
        .filter((a) => a.feats.importBooks === true)
        .map((a) => a.name)
        .join(' and ')} let you import your own files, such as EPUB or PDF, and read them with translation support. Many popular reading apps only offer a fixed catalog of stories, so if reading a specific book matters, check that first.`,
  },
  {
    question: 'Are reading apps better than flashcard apps for learning a language?',
    answer:
      'They do different jobs. Flashcard apps drill isolated words; reading apps teach words in context and build the ability to actually read, which is the point. The best results come from combining them: read real content, tap the words you do not know, and let a spaced-repetition trainer review them. Some apps, including Lingo7, do both in one place.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Best apps to read books in a foreign language',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: apps.length,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: a.url,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      { '@type': 'ListItem', position: 2, name: 'Best apps to read books', item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="bhub">
    <div class="container">
      <header class="bhub-head">
        <p class="bhub-eyebrow">Free guide</p>
        <h1>Best apps to read books in a foreign language <span>(2026)</span></h1>
      </header>

      <p class="bhub-answer">{directAnswer}</p>

      <div class="bhub-table-wrap">
        <h2>Reading apps compared</h2>
        <p class="bhub-table-note">Ranked for reading real books. As of {AS_OF}.</p>
        <div class="bhub-table-scroll">
          <table class="bhub-table">
            <thead>
              <tr>
                <th scope="col">App</th>
                {COLS.map((c) => <th scope="col">{c.label}</th>)}
                <th scope="col">Languages</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {
                apps.map((a) => (
                  <tr class={a.slug === 'lingo7' ? 'bhub-row-us' : ''}>
                    <th scope="row">{a.name}</th>
                    {COLS.map((c) => (
                      <td data-v={featLabel(a.feats[c.key])}>{featLabel(a.feats[c.key])}</td>
                    ))}
                    <td>{a.languageNote}</td>
                    <td>{a.priceShort}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <AppDemoCta
        title={`Read real books in ${top.languages.length} languages, free to start`}
        text={`Lingo7 lets you read any book, the built-in catalog or your own upload, with the original and a ` +
          `sentence-by-sentence {uiLang} translation side by side, native-narrated audio, and a tap to send new ` +
          `words to a review deck.`}
      />

      <div class="bhub-langs">
        <h2>Best apps to read books in your language</h2>
        <p class="bhub-langs-intro">
          Coverage is where these apps differ most. Pick your language for a ranked list of the apps that
          actually support reading in it.
        </p>
        <div class="bhub-lang-grid">
          {
            langs.map((l) => (
              <a class="bhub-lang" href={`/best-apps-to-read-books-in/${l.slug}/`}>
                <span class="bhub-lang-flag">{l.flag}</span>
                <span class="bhub-lang-name">{l.name}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="bhub-explainer">
        <h2>How we ranked these apps</h2>
        <p>
          This guide is about one job: <strong>reading real books in a foreign language</strong>. We ranked
          each app on how well it does that, in order: whether you can read the <strong>book you actually
          want</strong> (your own upload, not just a fixed catalog), whether it shows a <strong>parallel
          translation</strong>, whether it has <strong>audio</strong> to read and listen at once, whether it
          turns reading into <strong>vocabulary you keep</strong>, and how many languages it covers. This
          guide is published by Lingo7, so compare the columns yourself. Every fact is checked against each
          app's own store listing and site as of {AS_OF}.
        </p>
        <p>
          Beyond dedicated learning apps, a general e-reader like Kindle with a bilingual dictionary, or an
          open-source reader like Lute, will let you read almost any book in almost any language, just without
          the parallel translation, graded catalog or synced audio these apps add.
        </p>
      </div>

      <div class="bhub-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>

      <p class="bhub-tool-link">
        <a href="/compare/">Compare Lingo7 with LingQ, Beelinguapp and other reading apps &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .bhub { padding: 3rem 0 4rem; }
  .bhub-head { max-width: 820px; margin: 0 auto 1.2rem; text-align: center; }
  .bhub-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; color: var(--primary); font-weight: 700; margin: 0 0 0.5rem; }
  .bhub-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0; }
  .bhub-head h1 span { color: var(--text-muted, #9fb0c3); font-weight: 700; }

  .bhub-answer {
    max-width: 760px; margin: 0 auto; text-align: left;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 16px; padding: 1.3rem 1.5rem; color: var(--text, #e8eef5); font-size: 1.05rem; line-height: 1.65;
  }

  .bhub-table-wrap { max-width: 900px; margin: 2.8rem auto 0; }
  .bhub-table-wrap h2 { font-size: 1.5rem; margin: 0 0 0.3rem; text-align: center; }
  .bhub-table-note { color: var(--text-muted, #9fb0c3); font-size: 0.85rem; text-align: center; margin: 0 0 1.2rem; }
  .bhub-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .bhub-table { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 0.9rem; }
  .bhub-table th, .bhub-table td { padding: 0.7rem 0.8rem; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .bhub-table thead th { color: var(--text-muted, #9fb0c3); font-weight: 600; font-size: 0.82rem; border-bottom: 1px solid rgba(255, 255, 255, 0.16); }
  .bhub-table tbody th[scope='row'] { text-align: left; color: var(--text, #e8eef5); font-weight: 700; }
  .bhub-table td { color: var(--text-muted, #9fb0c3); }
  .bhub-table td[data-v='Yes'] { color: var(--primary); font-weight: 700; }
  .bhub-table .bhub-row-us { background: rgba(74, 222, 128, 0.07); }
  .bhub-table .bhub-row-us th[scope='row'] { color: var(--primary); }

  .bhub-langs { max-width: 900px; margin: 3rem auto 0; text-align: center; }
  .bhub-langs h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
  .bhub-langs-intro { color: var(--text-muted, #9fb0c3); line-height: 1.6; max-width: 640px; margin: 0 auto 1.5rem; }
  .bhub-lang-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.7rem; }
  .bhub-lang {
    display: flex; align-items: center; gap: 0.6rem; text-decoration: none;
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px; padding: 0.7rem 0.9rem; transition: all 0.12s ease;
  }
  .bhub-lang:hover { border-color: var(--primary); transform: translateY(-2px); }
  .bhub-lang-flag { font-size: 1.4rem; }
  .bhub-lang-name { color: var(--text, #e8eef5); font-weight: 600; font-size: 0.95rem; text-align: left; }

  .bhub-explainer { max-width: 760px; margin: 3rem auto 0; }
  .bhub-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .bhub-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0; }
  .bhub-explainer strong { color: var(--text, #e8eef5); }

  .bhub-faq { max-width: 760px; margin: 3rem auto 0; }
  .bhub-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .bhub-faq details { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 0.7rem; }
  .bhub-faq summary { cursor: pointer; font-weight: 600; }
  .bhub-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }

  .bhub-tool-link { max-width: 760px; margin: 2.5rem auto 0; text-align: center; font-size: 0.95rem; }
  .bhub-tool-link a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .bhub-tool-link a:hover { text-decoration: underline; }
</style>
