---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { codeToSlug } from '../../../data/languageSlugs';
import { getTranslations } from '../../../utils/i18n';
import { getTargetLanguageName } from '../../../data/languageNames';

// The blog is English-only, so each post is built once, under /en/.
export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => data.locale === 'en' && !data.draft,
  );

  return posts.map((post) => ({
    params: {
      uiLang: 'en',
      slug: post.id.includes('/') ? post.id.split('/').pop()! : post.id,
    },
    props: { post, uiCode: 'en' },
  }));
}

const { post, uiCode } = Astro.props;
const { Content } = await render(post);
const translations = getTranslations(uiCode);

const slug = post.id.includes('/') ? post.id.split('/').pop()! : post.id;

// Query related posts: same category, excluding current
const allPosts = await getCollection(
  'blog',
  ({ data }) => data.locale === 'en' && !data.draft,
);
const availablePosts = allPosts.filter((p) => {
  const pSlug = p.id.includes('/') ? p.id.split('/').pop()! : p.id;
  return pSlug !== slug;
});

// Same category first, then other categories, sorted by date
const sameCat = availablePosts.filter((p) => p.data.category === post.data.category);
const otherCat = availablePosts.filter((p) => p.data.category !== post.data.category);
sameCat.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
otherCat.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const relatedRaw = [...sameCat, ...otherCat].slice(0, 3);

const categoryKeys: Record<string, string> = {
  'book-lists': 'blog_category_book_lists',
  'getting-started': 'blog_category_getting_started',
  'difficulty-guides': 'blog_category_difficulty_guides',
  'tips': 'blog_category_tips',
  'methodology': 'blog_category_methodology',
};

const relatedPosts = relatedRaw.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  slug: p.id.includes('/') ? p.id.split('/').pop()! : p.id,
  category: p.data.category,
  categoryLabel: translations[categoryKeys[p.data.category] ?? ''] ?? p.data.category,
  pubDate: p.data.pubDate,
}));

const categoryLabel = translations[categoryKeys[post.data.category] ?? ''] ?? post.data.category;

// Target language info for CTA
const targetLangName = post.data.targetLang
  ? getTargetLanguageName(post.data.targetLang, uiCode)
  : undefined;
const targetLangSlug = post.data.targetLang
  ? codeToSlug[post.data.targetLang]
  : undefined;
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  category={post.data.category}
  categoryLabel={categoryLabel}
  tags={post.data.tags}
  targetLang={post.data.targetLang}
  targetLangName={targetLangName}
  targetLangSlug={targetLangSlug}
  ogImage={post.data.ogImage}
  uiLang={uiCode}
  slug={slug}
  summary={post.data.summary}
  faq={post.data.faq}
  translations={translations}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogLayout>
