---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import AppDemoCta from '../../../components/AppDemoCta.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '../../../utils/i18n';
import { getLanguageByCode } from '../../../data/languages';
import '../../../styles/blog.css';

// The blog is English-only, so no other UI locale is built.
export function getStaticPaths() {
  return [{ params: { uiLang: 'en' }, props: { uiCode: 'en' } }];
}

const { uiCode } = Astro.props;
const translations = getTranslations(uiCode);

// All non-draft English posts, newest first
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((p) => p.data.locale === 'en')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = translations['blog_meta_title'] ?? 'Lingo7 Blog';
const description = translations['blog_meta_description'] ?? 'Language learning tips and guides';

const categoryKeys: Record<string, string> = {
  'book-lists': 'blog_category_book_lists',
  'getting-started': 'blog_category_getting_started',
  'difficulty-guides': 'blog_category_difficulty_guides',
  'tips': 'blog_category_tips',
  'methodology': 'blog_category_methodology',
};

function getCategoryLabel(cat: string): string {
  return translations[categoryKeys[cat] ?? ''] ?? cat;
}

// Get unique categories from posts
const categories = [...new Set(posts.map((p) => p.data.category))];

const allLabel = translations['blog_all_categories'] ?? 'All';
const readMoreText = translations['blog_read_more'] ?? 'Read more';
const blogTitle = translations['blog_title'] ?? 'Blog';
const ctaTitle = translations['blog_cta_title'] ?? 'Ready to start reading?';
const ctaSubtitle = translations['blog_cta_subtitle'] ?? 'Download Lingo7 and begin your language learning journey today.';
// The page is English, so the demo shows the German book translated into English.
const demoTargetLang = 'de';

function getSlugFromId(id: string): string {
  const parts = id.split('/');
  return parts[parts.length - 1];
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: 'https://lingoseven.com/en/blog/',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Lingo7',
      url: 'https://lingoseven.com',
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang={uiCode}
  canonicalUrl="https://lingoseven.com/en/blog/"
  jsonLd={jsonLd}
  translations={translations}
  uiLang={uiCode}
  blogUrl="/en/blog/"
>
  <div class="container blog-listing">
    <section class="blog-hero">
      <span class="blog-hero-pill">{blogTitle}</span>
      <h1>{title}</h1>
      <p>{description}</p>
    </section>

    <div class="blog-categories">
      <button class="blog-category-pill active" data-filter="all">{allLabel}</button>
      {categories.map((cat) => (
        <button class="blog-category-pill" data-filter={cat}>{getCategoryLabel(cat)}</button>
      ))}
    </div>

    {posts.length > 0 ? (
      <div class="blog-grid">
        {posts.map((post) => {
          const slug = getSlugFromId(post.id);
          const flag = post.data.targetLang ? getLanguageByCode(post.data.targetLang)?.flag : undefined;
          return (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              categoryLabel={getCategoryLabel(post.data.category)}
              slug={slug}
              targetLangFlag={flag}
              readMoreText={readMoreText}
            />
          );
        })}
      </div>
    ) : (
      <div class="blog-empty">
        <p>No articles yet.</p>
      </div>
    )}

    <AppDemoCta
      title={ctaTitle}
      text={ctaSubtitle}
      targetLang={demoTargetLang}
      uiLang={uiCode}
    />
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.blog-category-pill');
    const cards = document.querySelectorAll('.blog-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = (pill as HTMLElement).dataset.filter;
        cards.forEach((card) => {
          const cat = (card as HTMLElement).dataset.category;
          if (filter === 'all' || cat === filter) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
