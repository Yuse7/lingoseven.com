---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LearnHero from '../../../components/LearnHero.astro';
import FeaturesSlider from '../../../components/FeaturesSlider.astro';
import AudioSection from '../../../components/AudioSection.astro';
import PracticeSection from '../../../components/PracticeSection.astro';
import TestimonialsSlider from '../../../components/TestimonialsSlider.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import LibrarySection from '../../../components/LibrarySection.astro';
import DownloadSection from '../../../components/DownloadSection.astro';
import LearnBlogSection from '../../../components/LearnBlogSection.astro';
import { getEnabledLanguages, hasAudio } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';
import { getTranslations } from '../../../utils/i18n';
import { getTargetLanguageName, getTargetLanguagePrepositional, getTargetLanguageGenitive } from '../../../data/languageNames';
import { getPlayListing } from '../../../utils/storeListing';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  const enabled = getEnabledLanguages();
  const paths: Array<{ params: { uiLang: string; targetLang: string }; props: { targetCode: string; uiCode: string } }> = [];

  for (const target of enabled) {
    for (const ui of enabled) {
      const slug = codeToSlug[target.code];
      if (!slug) continue;
      paths.push({
        params: { uiLang: ui.code, targetLang: slug },
        props: { targetCode: target.code, uiCode: ui.code },
      });
    }
  }

  return paths;
}

const { targetCode, uiCode } = Astro.props;
const translations = getTranslations(uiCode);
const targetLangName = getTargetLanguageName(targetCode, uiCode);
const targetLangNamePrep = getTargetLanguagePrepositional(targetCode, uiCode);
const targetLangNameGen = getTargetLanguageGenitive(targetCode, uiCode);
const uiLangName = getTargetLanguageName(uiCode, uiCode);
const targetSlug = codeToSlug[targetCode];

const applyVars = (s: string) => s
  .replace(/{targetLang}/g, targetLangName)
  .replace(/{targetLangPrep}/g, targetLangNamePrep)
  .replace(/{targetLangGen}/g, targetLangNameGen);

const title = applyVars(translations['learn_meta_title'] ?? `Learn ${targetLangName}`);
const description = applyVars(translations['learn_meta_description'] ?? `Learn ${targetLangName} with Lingo7`);

const enabled = getEnabledLanguages();

// Build hreflang alternates
const hreflangAlternates = enabled.map((ui) => ({
  lang: ui.code,
  url: `https://lingoseven.com/${ui.code}/learn/${targetSlug}`,
}));
hreflangAlternates.push({
  lang: 'x-default',
  url: `https://lingoseven.com/en/learn/${targetSlug}`,
});

// Language switcher data for header/footer
const uiLanguages = enabled.map((l) => ({
  code: l.code,
  nativeName: l.nativeName,
  flag: l.flag,
  url: `/${l.code}/learn/${targetSlug}`,
}));

// Footer links to all "Learn [Language]" pages
const learnLanguageLinks = enabled.map((l) => ({
  name: getTargetLanguageName(l.code, uiCode),
  url: `/${uiCode}/learn/${codeToSlug[l.code]}`,
}));

// Strip HTML tags for JSON-LD (FAQ answers contain <strong> etc.)
function stripHtml(html: string): string {
  return html.replace(/<[^>]*>/g, '');
}

// JSON-LD structured data
const faqItems = [1, 2, 3, 4, 5].map((i) => {
  const question = applyVars(translations[`faq2_item${i}_question`] || '');
  const principle = stripHtml(applyVars(translations[`faq2_item${i}_principle`] || ''));
  const how = stripHtml(applyVars(translations[`faq2_item${i}_how`] || ''));
  return { question, answer: `${principle} ${how}` };
});

// Blog posts for this learn page
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const localeBlogPosts = allBlogPosts.filter((p) => p.data.locale === uiCode);
const enBlogPosts = allBlogPosts.filter((p) => p.data.locale === 'en');
const blogSlugsWithLocale = new Set(localeBlogPosts.map((p) => (p.id.includes('/') ? p.id.split('/').pop()! : p.id)));
const blogPosts = [
  ...localeBlogPosts,
  ...enBlogPosts.filter((p) => !blogSlugsWithLocale.has(p.id.includes('/') ? p.id.split('/').pop()! : p.id)),
];

// Prioritize posts with matching targetLang, then methodology/getting-started, then rest
const categoryPriority: Record<string, number> = {
  'methodology': 1,
  'getting-started': 2,
  'tips': 3,
  'book-lists': 4,
  'difficulty-guides': 5,
};
const targetLangPosts = blogPosts.filter((p) => p.data.targetLang === targetCode);
const generalPosts = blogPosts
  .filter((p) => !p.data.targetLang || p.data.targetLang !== targetCode)
  .sort((a, b) => (categoryPriority[a.data.category] ?? 99) - (categoryPriority[b.data.category] ?? 99));
const selectedBlogPosts = [...targetLangPosts, ...generalPosts].slice(0, 3);

const blogCategoryKeys: Record<string, string> = {
  'book-lists': 'blog_category_book_lists',
  'getting-started': 'blog_category_getting_started',
  'difficulty-guides': 'blog_category_difficulty_guides',
  'tips': 'blog_category_tips',
  'methodology': 'blog_category_methodology',
};
const learnBlogPosts = selectedBlogPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  slug: p.id.includes('/') ? p.id.split('/').pop()! : p.id,
  category: p.data.category,
  categoryLabel: translations[blogCategoryKeys[p.data.category] ?? ''] ?? p.data.category,
}));

const blogSectionTitle = applyVars(translations['learn_blog_title'] ?? 'Tips for Learning {targetLang} Through Reading');
const blogSectionSubtitle = applyVars(translations['learn_blog_subtitle'] ?? 'Expert guides and practical advice to help you read books in {targetLang}.');
const blogReadMore = translations['blog_read_more'] ?? 'Read more';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lingoseven.com" },
      { "@type": "ListItem", "position": 2, "name": `Learn ${targetLangName}`, "item": `https://lingoseven.com/${uiCode}/learn/${targetSlug}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Lingo7",
    "applicationCategory": "EducationApplication",
    "operatingSystem": "iOS, Android",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": description,
    "url": "https://lingoseven.com",
    "downloadUrl": [
      "https://apps.apple.com/app/id6471030440",
      "https://play.google.com/store/apps/details?id=com.doublereading",
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang={uiCode}
  canonicalUrl={`https://lingoseven.com/${uiCode}/learn/${targetSlug}`}
  hreflangAlternates={hreflangAlternates}
  jsonLd={jsonLd}
  translations={translations}
  uiLang={uiCode}
  uiLanguages={uiLanguages}
  learnLanguageLinks={learnLanguageLinks}
  showNav={true}
  playListing={getPlayListing(targetCode)}
>
  <LearnHero targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} translations={translations} />
  <FeaturesSlider targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} uiLangName={uiLangName} targetLang={targetCode} uiLang={uiCode} translations={translations} />
  {hasAudio(targetCode) && (
    <AudioSection targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} targetLang={targetCode} uiLang={uiCode} translations={translations} />
  )}
  <PracticeSection targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} targetLang={targetCode} uiLang={uiCode} translations={translations} />
  <LibrarySection targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} translations={translations} />
  <TestimonialsSlider targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} translations={translations} />
  <FaqAccordion targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} translations={translations} />
  <LearnBlogSection
    posts={learnBlogPosts}
    uiLang={uiCode}
    title={blogSectionTitle}
    subtitle={blogSectionSubtitle}
    readMoreText={blogReadMore}
  />
  <DownloadSection targetLangName={targetLangName} targetLangNamePrep={targetLangNamePrep} targetLangNameGen={targetLangNameGen} translations={translations} />
</BaseLayout>
