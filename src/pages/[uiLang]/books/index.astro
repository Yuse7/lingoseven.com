---
// Books hub: one card per shelf (a language you can learn by reading public
// domain books), with the first covers and the shelf size.
// Docs: docs/pd-books-pipeline.md (tiers, shelves, growth rules).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEnabledLanguages } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';
import { getTargetLanguageName } from '../../../data/languageNames';
import { getTranslations, t } from '../../../utils/i18n';
import {
  booksByLang,
  localesWithShelves,
  shelfPath,
  shelvesForLocale,
} from '../../../data/pdCatalog';

export function getStaticPaths() {
  // Only locales that own at least one shelf get a hub (wave 1: `en`).
  return localesWithShelves().map((locale) => ({
    params: { uiLang: locale },
    props: { uiCode: locale },
  }));
}

const { uiCode } = Astro.props;

// English underlay first: a locale file without the `books_*` keys would
// otherwise render the raw key names on the page (t() returns the key).
const translations = { ...getTranslations('en'), ...getTranslations(uiCode) };

const shelves = shelvesForLocale(uiCode)
  .map((shelf) => {
    const langName = getTargetLanguageName(shelf.lang, uiCode);
    const books = booksByLang(shelf.lang);
    return {
      lang: shelf.lang,
      name: langName,
      count: shelf.count || books.length,
      covers: books.slice(0, 4).filter((b) => !!b.cover).map((b) => ({ url: b.cover!, title: b.title })),
      url: shelfPath(uiCode, shelf.lang)!,
    };
  })
  .filter((shelf) => !!shelf.url)
  .sort((a, b) => b.count - a.count);

const totalBooks = shelves.reduce((sum, shelf) => sum + shelf.count, 0);

const canonicalUrl = `https://lingoseven.com/${uiCode}/books/`;
const title = t(translations, 'books_hub_meta_title');
const description = t(translations, 'books_hub_meta_description');

// hreflang only between locales that actually have a hub.
const hubLocales = localesWithShelves();
const hreflangAlternates = hubLocales.map((locale) => ({
  lang: locale,
  url: `https://lingoseven.com/${locale}/books/`,
}));
hreflangAlternates.push({
  lang: 'x-default',
  url: `https://lingoseven.com/${hubLocales.includes('en') ? 'en' : hubLocales[0]}/books/`,
});

// The switcher lists the locales this page exists in, so it never offers a
// language that would land on a 404 (Header/Footer hide it below two entries).
const enabled = getEnabledLanguages();
const uiLanguages = enabled
  .filter((l) => hubLocales.includes(l.code))
  .map((l) => ({ code: l.code, nativeName: l.nativeName, flag: l.flag, url: `/${l.code}/books/` }));

const learnLanguageLinks = enabled.map((l) => ({
  name: getTargetLanguageName(l.code, uiCode),
  url: `/${uiCode}/learn/${codeToSlug[l.code]}/`,
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: canonicalUrl,
    description,
    isPartOf: { '@type': 'WebSite', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: shelves.map((shelf, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: shelf.name,
      url: `https://lingoseven.com${shelf.url}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      { '@type': 'ListItem', position: 2, name: t(translations, 'books_nav_label'), item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang={uiCode}
  canonicalUrl={canonicalUrl}
  hreflangAlternates={hreflangAlternates}
  jsonLd={jsonLd}
  translations={translations}
  uiLang={uiCode}
  uiLanguages={uiLanguages}
  learnLanguageLinks={learnLanguageLinks}
  showNav={false}
  blogUrl={`/${uiCode}/blog/`}
>
  <section class="pd-hub">
    <div class="container">
      <header class="pd-head">
        <p class="pd-eyebrow">{t(translations, 'books_nav_label')}</p>
        <h1>{t(translations, 'books_hub_h1')}</h1>
        <p class="pd-intro">{t(translations, 'books_hub_intro')}</p>
        <p class="pd-total">{t(translations, 'books_hub_shelf_books', { count: String(totalBooks) })}</p>
      </header>

      <div class="pd-shelves">
        {shelves.map((shelf) => (
          <a class="pd-shelf" href={shelf.url}>
            <span class="pd-shelf-covers">
              {shelf.covers.map((cover) => (
                <img src={cover.url} alt="" loading="lazy" width="64" height="96" />
              ))}
            </span>
            <span class="pd-shelf-body">
              <span class="pd-shelf-name">{shelf.name}</span>
              <span class="pd-shelf-count">
                {t(translations, 'books_hub_shelf_books', { count: String(shelf.count) })}
              </span>
              <span class="pd-shelf-more">{t(translations, 'books_hub_open')} &rarr;</span>
            </span>
          </a>
        ))}
      </div>

      <p class="pd-source">{t(translations, 'books_source_note')}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .pd-hub {
    padding: 120px 0 80px;
  }

  .pd-head {
    max-width: 720px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .pd-eyebrow {
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }

  .pd-head h1 {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .pd-intro {
    color: var(--text-light);
    line-height: 1.6;
  }

  .pd-total {
    margin-top: 12px;
    color: var(--primary);
    font-weight: 600;
  }

  .pd-shelves {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .pd-shelf {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 16px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .pd-shelf:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .pd-shelf-covers {
    display: flex;
    flex-shrink: 0;
  }

  .pd-shelf-covers img {
    width: 44px;
    height: 66px;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: var(--shadow);
    background: var(--background-alt);
  }

  .pd-shelf-covers img + img {
    margin-left: -26px;
  }

  .pd-shelf-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pd-shelf-name {
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .pd-shelf-count {
    color: var(--text-light);
    font-size: 0.9rem;
  }

  .pd-shelf-more {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .pd-source {
    margin-top: 40px;
    text-align: center;
    color: var(--text-light);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .pd-hub {
      padding: 96px 0 56px;
    }

    .pd-head h1 {
      font-size: 1.7rem;
    }
  }
</style>
