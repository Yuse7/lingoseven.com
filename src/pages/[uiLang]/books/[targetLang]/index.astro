---
// One shelf: every tier-A public domain book in a language, most downloaded
// first, with a client-side CEFR filter.
// Docs: docs/pd-books-pipeline.md (tiers, shelves, growth rules).
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getEnabledLanguages } from '../../../../data/languages';
import { codeToSlug } from '../../../../data/languageSlugs';
import { getTargetLanguageName } from '../../../../data/languageNames';
import { getTranslations, t } from '../../../../utils/i18n';
import {
  CEFR_ORDER,
  authorsLine,
  bookPath,
  booksByLang,
  getShelf,
  levelLabel,
  localesWithShelves,
  readingTime,
  shelves,
  type PdBook,
} from '../../../../data/pdCatalog';

export function getStaticPaths() {
  const paths: Array<{
    params: { uiLang: string; targetLang: string };
    props: { uiCode: string; targetCode: string };
  }> = [];
  for (const shelf of shelves) {
    const slug = codeToSlug[shelf.lang];
    if (!slug) continue;
    for (const locale of shelf.locales) {
      paths.push({
        params: { uiLang: locale, targetLang: slug },
        props: { uiCode: locale, targetCode: shelf.lang },
      });
    }
  }
  return paths;
}

const { uiCode, targetCode } = Astro.props;
// English underlay: a locale missing the `books_*` keys still renders real copy.
const translations = { ...getTranslations('en'), ...getTranslations(uiCode) };

const targetSlug = codeToSlug[targetCode];
const targetLangName = getTargetLanguageName(targetCode, uiCode);
const shelf = getShelf(targetCode)!;
const shelfBooks = booksByLang(targetCode);

const vars = { targetLang: targetLangName, count: String(shelfBooks.length) };

// Level chips: only the levels this shelf actually has, in CEFR order.
const levelCounts = new Map<string, number>();
for (const book of shelfBooks) {
  const level = levelLabel(book);
  if (level) levelCounts.set(level, (levelCounts.get(level) ?? 0) + 1);
}
const levels = CEFR_ORDER.filter((level) => levelCounts.has(level));

const cards = shelfBooks.map((book: PdBook) => ({
  book,
  url: bookPath(uiCode, book)!,
  level: levelLabel(book),
  authors: authorsLine(book),
  time: readingTime(book),
}));

// "Best books to learn X" post, when one exists for this language.
const postSlug = `best-books-to-learn-${targetSlug}-through-reading`;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const hasPost = posts.some((p) => (p.id.includes('/') ? p.id.split('/').pop() : p.id) === postSlug);

const canonicalUrl = `https://lingoseven.com/${uiCode}/books/${targetSlug}/`;
const title = t(translations, 'books_shelf_meta_title', vars);
const description = t(translations, 'books_shelf_meta_description', vars);

const hreflangAlternates = shelf.locales.map((locale) => ({
  lang: locale,
  url: `https://lingoseven.com/${locale}/books/${targetSlug}/`,
}));
hreflangAlternates.push({
  lang: 'x-default',
  url: `https://lingoseven.com/${shelf.locales.includes('en') ? 'en' : shelf.locales[0]}/books/${targetSlug}/`,
});

const enabled = getEnabledLanguages();
const uiLanguages = enabled
  .filter((l) => shelf.locales.includes(l.code))
  .map((l) => ({
    code: l.code,
    nativeName: l.nativeName,
    flag: l.flag,
    url: `/${l.code}/books/${targetSlug}/`,
  }));

const learnLanguageLinks = enabled.map((l) => ({
  name: getTargetLanguageName(l.code, uiCode),
  url: `/${uiCode}/learn/${codeToSlug[l.code]}/`,
}));

const hubLocale = localesWithShelves().includes(uiCode) ? uiCode : 'en';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: canonicalUrl,
    description,
    inLanguage: targetCode,
    isPartOf: { '@type': 'WebSite', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: cards.map((card, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: card.book.title,
      url: `https://lingoseven.com${card.url}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(translations, 'books_nav_label'),
        item: `https://lingoseven.com/${hubLocale}/books/`,
      },
      { '@type': 'ListItem', position: 3, name: targetLangName, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang={uiCode}
  canonicalUrl={canonicalUrl}
  hreflangAlternates={hreflangAlternates}
  jsonLd={jsonLd}
  translations={translations}
  uiLang={uiCode}
  uiLanguages={uiLanguages}
  learnLanguageLinks={learnLanguageLinks}
  showNav={false}
  blogUrl="/en/blog/"
>
  <section class="pd-shelf-page">
    <div class="container">
      <nav class="pd-crumbs" aria-label="Breadcrumb">
        <a href={`/${hubLocale}/books/`}>{t(translations, 'books_nav_label')}</a>
        <span>/</span>
        <span>{targetLangName}</span>
      </nav>

      <header class="pd-head">
        <h1>{t(translations, 'books_shelf_h1', vars)}</h1>
        <p class="pd-intro">{t(translations, 'books_shelf_intro', vars)}</p>
        <p class="pd-links">
          <a href={`/${uiCode}/learn/${targetSlug}/`}>{t(translations, 'books_shelf_learn_link', vars)}</a>
          {hasPost && (
            <a href={`/en/blog/${postSlug}/`}>{t(translations, 'books_shelf_post_link', vars)}</a>
          )}
        </p>
      </header>

      {levels.length > 1 && (
        <div class="pd-filter" data-pd-filter>
          <span class="pd-filter-label">{t(translations, 'books_shelf_filter_label')}</span>
          <button type="button" class="pd-chip is-active" data-level="all">
            {t(translations, 'books_shelf_filter_all')}
          </button>
          {levels.map((level) => (
            <button type="button" class="pd-chip" data-level={level}>
              {level} <span class="pd-chip-count">{levelCounts.get(level)}</span>
            </button>
          ))}
        </div>
      )}

      <div class="pd-grid" data-pd-grid>
        {cards.map((card) => (
          <a class="pd-card" href={card.url} data-level={card.level ?? 'none'}>
            {card.book.cover
              ? <img class="pd-card-cover" src={card.book.cover} alt="" loading="lazy" width="120" height="180" />
              : <span class="pd-card-cover pd-card-cover--blank" aria-hidden="true">{card.book.title.slice(0, 1)}</span>}
            <span class="pd-card-body">
              <span class="pd-card-title">{card.book.title}</span>
              {card.authors && <span class="pd-card-author">{card.authors}</span>}
              <span class="pd-card-meta">
                {card.level && <span class="pd-badge">{card.level}</span>}
                {card.time && <span>{card.time}</span>}
              </span>
            </span>
          </a>
        ))}
      </div>

      <p class="pd-empty" data-pd-empty hidden>{t(translations, 'books_shelf_empty')}</p>
      <p class="pd-source">{t(translations, 'books_source_note')}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Level filter: plain DOM, no framework. Cards carry data-level, chips carry
  // the level they select; "all" clears the filter.
  const filter = document.querySelector<HTMLElement>('[data-pd-filter]');
  const grid = document.querySelector<HTMLElement>('[data-pd-grid]');
  const empty = document.querySelector<HTMLElement>('[data-pd-empty]');
  if (filter && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.pd-card'));
    filter.addEventListener('click', (event) => {
      const chip = (event.target instanceof Element ? event.target : null)?.closest<HTMLElement>('.pd-chip');
      if (!chip) return;
      const level = chip.dataset.level ?? 'all';
      filter.querySelectorAll('.pd-chip').forEach((el) => el.classList.toggle('is-active', el === chip));
      let shown = 0;
      for (const card of cards) {
        const match = level === 'all' || card.dataset.level === level;
        card.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    });
  }
</script>

<style>
  .pd-shelf-page {
    padding: 120px 0 80px;
  }

  .pd-crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 16px;
  }

  .pd-crumbs a {
    color: var(--primary);
    text-decoration: none;
  }

  .pd-head {
    max-width: 760px;
    margin-bottom: 32px;
  }

  .pd-head h1 {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .pd-intro {
    color: var(--text-light);
    line-height: 1.6;
  }

  .pd-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 16px;
  }

  .pd-links a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .pd-links a:hover {
    text-decoration: underline;
  }

  .pd-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .pd-filter-label {
    color: var(--text-light);
    font-size: 0.85rem;
    margin-right: 4px;
  }

  .pd-chip {
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background-card);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .pd-chip:hover {
    border-color: var(--primary);
  }

  .pd-chip.is-active {
    border-color: var(--primary);
    color: var(--primary);
  }

  .pd-chip-count {
    color: var(--text-light);
    font-weight: 400;
  }

  .pd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .pd-card {
    display: flex;
    gap: 14px;
    padding: 14px;
    background: var(--background-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  /* .pd-card sets display:flex, which overrides the [hidden] UA rule.
     Restore the hide explicitly so the level filter (card.hidden = true)
     actually hides cards. */
  .pd-card[hidden] {
    display: none;
  }

  .pd-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .pd-card-cover {
    width: 72px;
    height: 108px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 6px;
    background: var(--background-alt);
  }

  .pd-card-cover--blank {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-light);
  }

  .pd-card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .pd-card-title {
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }

  .pd-card-author {
    color: var(--text-light);
    font-size: 0.85rem;
  }

  .pd-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: var(--text-light);
    font-size: 0.8rem;
  }

  .pd-badge {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(74, 222, 128, 0.12);
    color: var(--primary);
    font-weight: 700;
  }

  .pd-empty,
  .pd-source {
    margin-top: 24px;
    color: var(--text-light);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .pd-shelf-page {
      padding: 96px 0 56px;
    }

    .pd-head h1 {
      font-size: 1.7rem;
    }
  }
</style>
