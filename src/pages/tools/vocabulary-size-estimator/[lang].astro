---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaButtons from '../../../components/CtaButtons.astro';
import { vocabWords, VOCAB_LANG_CODES } from '../../../data/vocabWords';
import { vocabFacts } from '../../../data/vocabFacts';
import { languageFacts } from '../../../data/languageFacts';
import { getLanguageByCode } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';

// One static page per supported language: /tools/vocabulary-size-estimator/spanish/ etc.
export function getStaticPaths() {
  return VOCAB_LANG_CODES.filter((code) => codeToSlug[code]).map((code) => ({
    params: { lang: codeToSlug[code] },
    props: { targetCode: code },
  }));
}

const { targetCode } = Astro.props;
const lang = getLanguageByCode(targetCode);
const name = lang?.name ?? targetCode;
const slug = codeToSlug[targetCode];

// All supported languages (for the "test another language" cross-link cluster).
const others = VOCAB_LANG_CODES.filter((c) => codeToSlug[c] && c !== targetCode).map((c) => {
  const l = getLanguageByCode(c);
  return { name: l?.name ?? c, flag: l?.flag ?? '', slug: codeToSlug[c] };
});

// Server-render this language's word grid (alphabetical) so the page has real,
// indexable content with JS off. The client reshuffles it on load.
const data = vocabWords[targetCode];
const items = [
  ...data.bands.flatMap((b, bi) => b.words.map((w) => ({ w, band: bi }))),
  ...data.pseudowords.map((w) => ({ w, band: -1 })),
].sort((a, b) => a.w.localeCompare(b.w, targetCode));

// Unique, language-specific vocabulary section (cognates/false friends + real
// frequency coverage). Reuses speakers/family from the shared languageFacts.
const fact = vocabFacts[targetCode];
const lf = languageFacts[targetCode];
const speakersLabel = lf
  ? lf.speakers >= 1000
    ? `${(lf.speakers / 1000).toFixed(1)}B`
    : `${Math.round(lf.speakers)}M`
  : null;

const canonicalUrl = `https://lingoseven.com/tools/vocabulary-size-estimator/${slug}/`;
const title = `How Many Words Do You Know in ${name}? Free Vocabulary Test | Lingo7`;
const description =
  `Free ${name} vocabulary size test. Check the words you know and estimate how many ${name} words you know, from beginner to near-native. Frequency-based, takes about a minute.`;

const faq = [
  {
    question: `How many words do I know in ${name}?`,
    answer:
      `This test estimates it in about a minute. You check every ${name} word you genuinely know from a list sampled across the whole frequency range — from the most common words down to rare ones. The share you know in each frequency band is scaled up to the size of that band, and the totals are added together. The list also hides made-up words; checking those lowers your score, which corrects for guessing.`,
  },
  {
    question: 'How is the vocabulary size estimate calculated?',
    answer:
      `The words come from real ${name} frequency lists, split into six bands by how common each word is. If you know 6 of 8 words in a band that represents 2,000 word families, that band contributes roughly 1,500 known words. We sum every band, then apply a guessing correction based on how many non-existent (pseudo) words you marked as known. The result is an estimate of your written vocabulary up to about 25,000 word families.`,
  },
  {
    question: 'What are the made-up words for?',
    answer:
      `About a fifth of the list are pseudowords — invented strings that follow ${name} spelling rules but are not real words. They look plausible, so if you tick them you are guessing. The test subtracts that guessing rate from your real score so the estimate stays honest. Be strict: only check a word if you actually know what it means.`,
  },
  {
    question: `How many ${name} words do you need to be fluent?`,
    answer:
      'Roughly 2,000-3,000 of the most frequent word families cover everyday conversation (around B1). To read a novel comfortably you usually need about 8,000-9,000 word families (B2-C1). Educated native speakers know somewhere around 15,000-20,000. More than the count, what matters is meeting those words repeatedly in real context.',
  },
  {
    question: 'How accurate is this vocabulary test?',
    answer:
      'It is a quick estimate, not an exam. Because it samples only a few words per frequency band, the number can swing by a few hundred to a couple of thousand. It is best read as a range and a level, and as a way to see which frequency bands you have already mastered. Reading real books is the fastest way to grow that number.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${name} Vocabulary Size Test`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: canonicalUrl,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      { '@type': 'ListItem', position: 2, name: 'Vocabulary Size Test', item: 'https://lingoseven.com/tools/vocabulary-size-estimator/' },
      { '@type': 'ListItem', position: 3, name: `${name} test`, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="vocab">
    <div class="container">
      <header class="vocab-head">
        <p class="vocab-eyebrow"><a href="/tools/vocabulary-size-estimator/">Vocabulary size test</a></p>
        <h1>How many words do you know in <span>{name}</span>?</h1>
        <p class="vocab-intro">
          Tick every {name} word below whose meaning you actually know. The list spans the whole
          frequency range — from the most common words to rare ones — and hides a few invented words
          to keep you honest. We turn your answers into an estimate of your total {name} vocabulary,
          then show you the fastest way to grow it: reading real books.
        </p>
        <p class="vocab-hint">
          Check a word only if you know what it means. Some words on the list are not real — don't
          guess.
        </p>
      </header>

      <div class="vocab-grid" id="vocab-grid">
        {items.map((it) => (
          <label class="chip" data-band={it.band}>
            <input type="checkbox" />
            <span>{it.w}</span>
          </label>
        ))}
      </div>

      <div class="vocab-actions">
        <button type="button" id="vocab-estimate" class="vocab-go">Estimate my vocabulary</button>
        <button type="button" id="vocab-reset" class="vocab-clear">Clear</button>
        <span class="vocab-count-live" id="vocab-count-live"></span>
      </div>

      <div class="vocab-result" id="vocab-result" hidden>
        <p class="result-eyebrow">Your estimated {name} vocabulary</p>
        <p class="result-number"><span id="result-count">0</span> <span class="result-unit">words</span></p>
        <p class="result-level"><span class="result-level-pill" id="result-level"></span></p>
        <p class="result-blurb" id="result-blurb"></p>

        <div class="result-bars" id="result-bars"></div>

        <p class="result-note" id="result-note" hidden></p>

        <div class="result-context">
          <div class="ctx-item"><strong>2,000-3,000</strong><span>everyday conversation</span></div>
          <div class="ctx-item"><strong>~8,000</strong><span>read novels comfortably</span></div>
          <div class="ctx-item"><strong>15,000-20,000</strong><span>educated native speaker</span></div>
        </div>
      </div>

      <div class="vocab-cta">
        <h2>Grow your {name} vocabulary the natural way — by reading</h2>
        <p>
          The fastest way past these numbers is meeting words again and again in real sentences.
          Lingo7 lets you read real books in {name} with tap-to-translate and native-narrated audio.
          Free to start.
        </p>
        <CtaButtons size="large" />
      </div>

      <div class="vocab-explainer">
        <h2>How the estimate works</h2>
        <p>
          The hardest part of measuring vocabulary is that you can't be asked about every word. So
          this test samples them. {name} words are sorted by <strong>frequency</strong> — how often
          they appear in real usage — and split into six bands, from the 600 most common words down
          to words ranked around 25,000th. You see eight words from each band.
        </p>
        <p>
          The share you know in a band is scaled up to the whole band. Know six of eight words in a
          band that stands for 2,000 word families, and you've likely got about 1,500 of them.
          Adding every band gives your estimate. Then comes the honesty check: the list also holds
          <strong>invented words</strong> that look real but aren't. The more of those you tick, the
          more the test assumes you were guessing, and it scales your score down to match.
        </p>
        <p>
          It's an estimate, not an exam — read it as a range and a level. What it's genuinely good at
          is showing <em>where</em> your {name} vocabulary thins out, and that the surest way to
          thicken it is to keep reading.
        </p>
      </div>

      {fact && (
        <div class="vocab-facts">
          <h2>About {name} vocabulary</h2>
          <p>{fact.blurb}</p>
          <p>
            In real usage, the 1,000 most common {name} words already cover about
            <strong>{fact.coverage.top1000}%</strong> of everyday text, and the top 5,000 cover
            roughly <strong>{fact.coverage.top5000}%</strong>. The rarer words beyond that are where
            vocabularies really differ — which is why this test samples them too, not just the
            common ones.
          </p>
          <div class="facts-stats">
            <div class="facts-stat"><strong>{fact.coverage.top1000}%</strong><span>text covered by the top 1,000 words</span></div>
            {speakersLabel && <div class="facts-stat"><strong>{speakersLabel}</strong><span>speakers worldwide</span></div>}
            {lf && <div class="facts-stat"><strong>{lf.family}</strong><span>language family</span></div>}
          </div>
        </div>
      )}

      <div class="vocab-others">
        <h2>Test another language</h2>
        <div class="vocab-others-grid">
          {others.map((o) => (
            <a class="vocab-other" href={`/tools/vocabulary-size-estimator/${o.slug}/`}>
              <span class="vocab-other-flag">{o.flag}</span>{o.name}
            </a>
          ))}
        </div>
      </div>

      <p class="vocab-tool-link">
        <a href="/tools/language-difficulty-ranker/">Wondering which language to learn next? Rank 50 languages by difficulty &rarr;</a>
      </p>

      {targetCode !== 'en' && (
        <p class="vocab-tool-link">
          <a href={`/tools/how-long-to-learn-a-language/${slug}/`}>How long does it take to learn {name}? See the timeline &rarr;</a>
        </p>
      )}

      <div class="vocab-faq">
        <h2>Frequently asked questions</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/json" id="vocab-data" set:html={JSON.stringify(data)} />
  <script>
    type Band = { width: number; words: string[] };
    type LangData = { bands: Band[]; pseudowords: string[] };

    const dataEl = document.getElementById('vocab-data');
    const DATA: LangData = dataEl ? JSON.parse(dataEl.textContent || '{}') : { bands: [], pseudowords: [] };

    const grid = document.getElementById('vocab-grid') as HTMLDivElement;
    const result = document.getElementById('vocab-result') as HTMLDivElement;
    const estimateBtn = document.getElementById('vocab-estimate') as HTMLButtonElement;
    const resetBtn = document.getElementById('vocab-reset') as HTMLButtonElement;
    const liveCount = document.getElementById('vocab-count-live') as HTMLSpanElement;

    function shuffle<T>(arr: T[]): T[] {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    type Item = { w: string; band: number };

    function buildItems(): Item[] {
      const items: Item[] = [];
      DATA.bands.forEach((b, bi) => b.words.forEach((w) => items.push({ w, band: bi })));
      DATA.pseudowords.forEach((w) => items.push({ w, band: -1 }));
      return shuffle(items);
    }

    function renderGrid() {
      grid.innerHTML = buildItems()
        .map((it) => `<label class="chip" data-band="${it.band}"><input type="checkbox" /><span>${it.w}</span></label>`)
        .join('');
      result.hidden = true;
      updateLive();
    }

    function checkedChips(): HTMLInputElement[] {
      return Array.from(grid.querySelectorAll<HTMLInputElement>('input:checked'));
    }

    function updateLive() {
      const n = checkedChips().length;
      liveCount.textContent = n > 0 ? `${n} selected` : '';
    }

    const fmt = (n: number) => n.toLocaleString('en-US');

    function level(n: number): { tag: string; blurb: string } {
      if (n < 750)
        return { tag: 'A1 · Beginner', blurb: "You're at the start. The first few hundred words already carry a lot of everyday meaning — keep going." };
      if (n < 1500)
        return { tag: 'A2 · Elementary', blurb: 'You can handle simple, familiar topics. Building toward the ~3,000 words that unlock real conversations.' };
      if (n < 3000)
        return { tag: 'B1 · Intermediate', blurb: 'You know enough to hold everyday conversations. Graded and simple authentic texts are within reach.' };
      if (n < 6000)
        return { tag: 'B2 · Upper-intermediate', blurb: "You're closing in on the ~8,000 words that make novels comfortable. Reading widely will get you there fastest." };
      if (n < 10000)
        return { tag: 'C1 · Advanced', blurb: 'You can read real books and follow nuanced discussion. The remaining words are rarer and best met in context.' };
      return { tag: 'C2 · Near-native', blurb: 'An exceptional vocabulary — in the range of an educated native speaker. Reading keeps even this sharp.' };
    }

    function estimate() {
      const checked = checkedChips();
      let pseudoHits = 0;
      const bandKnown = new Array(DATA.bands.length).fill(0);
      checked.forEach((input) => {
        const band = Number((input.closest('.chip') as HTMLElement).dataset.band);
        if (band === -1) pseudoHits++;
        else bandKnown[band]++;
      });
      const pseudoTotal = DATA.pseudowords.length;
      const f = pseudoTotal > 0 ? pseudoHits / pseudoTotal : 0;

      let total = 0;
      const bars = DATA.bands.map((b, i) => {
        const h = bandKnown[i] / b.words.length;
        let c = f < 1 ? (h - f) / (1 - f) : 0;
        c = Math.max(0, Math.min(1, c));
        total += c * b.width;
        return { known: bandKnown[i], of: b.words.length, pct: Math.round(c * 100) };
      });
      return { count: Math.round(total / 100) * 100, f, pseudoHits, pseudoTotal, bars };
    }

    function showResult() {
      const r = estimate();
      (document.getElementById('result-count') as HTMLElement).textContent = fmt(r.count);
      const lv = level(r.count);
      (document.getElementById('result-level') as HTMLElement).textContent = lv.tag;
      (document.getElementById('result-blurb') as HTMLElement).textContent = lv.blurb;

      const bandLabels = ['Top 600', '600-1.8k', '1.8k-4k', '4k-8k', '8k-15k', '15k-25k'];
      (document.getElementById('result-bars') as HTMLElement).innerHTML = r.bars
        .map(
          (b, i) => `
          <div class="bar-row">
            <span class="bar-label">${bandLabels[i]}</span>
            <span class="bar-track"><span class="bar-fill" style="width:${b.pct}%"></span></span>
            <span class="bar-val">${b.known}/${b.of}</span>
          </div>`
        )
        .join('');

      const note = document.getElementById('result-note') as HTMLElement;
      if (r.pseudoHits === 0) {
        note.hidden = true;
      } else {
        note.hidden = false;
        note.textContent = r.f >= 0.4
          ? `Heads up: you marked ${r.pseudoHits} of ${r.pseudoTotal} made-up words as known, so this estimate is adjusted down and is rough. Retake it and only check words you're sure of.`
          : `You marked ${r.pseudoHits} of ${r.pseudoTotal} made-up words as known, so we adjusted the score down a little to correct for guessing.`;
      }

      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    grid.addEventListener('change', updateLive);
    estimateBtn.addEventListener('click', showResult);
    resetBtn.addEventListener('click', renderGrid);

    // Shuffle client-side on load (server render is alphabetical, for indexability).
    renderGrid();
  </script>
</BaseLayout>

<style>
  .vocab { padding: 3rem 0 4rem; }
  .vocab-head { max-width: 760px; margin: 0 auto 1.5rem; text-align: center; }
  .vocab-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    font-weight: 700; margin: 0 0 0.5rem;
  }
  .vocab-eyebrow a { color: var(--primary); text-decoration: none; }
  .vocab-eyebrow a:hover { text-decoration: underline; }
  .vocab-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
  .vocab-head h1 span { color: var(--primary); }
  .vocab-intro { color: var(--text-muted, #9fb0c3); font-size: 1.05rem; line-height: 1.6; margin: 0 0 1.5rem; }
  .vocab-hint { font-size: 0.88rem; color: var(--text-muted, #9fb0c3); margin: 1rem auto 0; max-width: 560px; }

  .vocab-grid {
    display: flex; flex-wrap: wrap; gap: 0.55rem; justify-content: center;
    max-width: 820px; margin: 1.5rem auto 0;
  }
  /* Chips are injected by client JS (innerHTML), so they carry no Astro scope
     attribute. Scope under the server-rendered .vocab-grid and mark the dynamic
     part :global() so the styles still reach them. */
  .vocab-grid :global(.chip) {
    display: inline-flex; align-items: center; cursor: pointer; user-select: none;
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px;
    padding: 0.45rem 0.95rem; font-size: 1rem; line-height: 1;
    background: rgba(255, 255, 255, 0.03); transition: all 0.12s ease;
  }
  .vocab-grid :global(.chip input) { position: absolute; opacity: 0; width: 0; height: 0; }
  .vocab-grid :global(.chip:hover) { border-color: rgba(255, 255, 255, 0.32); }
  .vocab-grid :global(.chip:has(input:checked)) {
    background: var(--primary); color: #0b1220; border-color: var(--primary); font-weight: 600;
  }
  .vocab-grid :global(.chip:has(input:focus-visible)) { outline: 2px solid var(--primary); outline-offset: 2px; }

  .vocab-actions {
    display: flex; align-items: center; justify-content: center; gap: 0.8rem;
    flex-wrap: wrap; margin: 1.8rem auto 0;
  }
  .vocab-go {
    background: var(--gradient, linear-gradient(135deg, #4ade80, #22c55e)); color: #0b1220;
    border: none; border-radius: 10px; padding: 0.8rem 1.6rem; font-size: 1.02rem; font-weight: 700;
    cursor: pointer;
  }
  .vocab-go:hover { filter: brightness(1.05); }
  .vocab-clear {
    background: transparent; color: var(--text, #e8eef5);
    border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 10px;
    padding: 0.8rem 1.2rem; font-size: 1.02rem; font-weight: 600; cursor: pointer;
  }
  .vocab-clear:hover { border-color: rgba(255, 255, 255, 0.4); }
  .vocab-count-live { color: var(--text-muted, #9fb0c3); font-size: 0.92rem; font-variant-numeric: tabular-nums; }

  .vocab-result {
    max-width: 620px; margin: 2.5rem auto 0; text-align: center;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 18px; padding: 2.2rem 1.6rem;
  }
  .result-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem;
    color: var(--text-muted, #9fb0c3); margin: 0 0 0.4rem;
  }
  .result-number { margin: 0; font-size: clamp(2.6rem, 8vw, 4rem); font-weight: 800; line-height: 1; color: var(--primary); font-variant-numeric: tabular-nums; }
  .result-number .result-unit { font-size: 1.2rem; font-weight: 600; color: var(--text, #e8eef5); }
  .result-level { margin: 0.9rem 0 0; }
  .result-level-pill {
    display: inline-block; background: rgba(255, 255, 255, 0.08); border-radius: 999px;
    padding: 0.3rem 0.85rem; font-size: 0.92rem; font-weight: 600;
  }
  .result-blurb { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 1rem auto 0; max-width: 460px; }

  .result-bars { margin: 1.6rem auto 0; max-width: 420px; text-align: left; display: grid; gap: 0.5rem; }
  /* Bar rows are injected by client JS, so the dynamic parts must be :global(). */
  .result-bars :global(.bar-row) { display: grid; grid-template-columns: 4.6rem 1fr 2.2rem; align-items: center; gap: 0.6rem; }
  .result-bars :global(.bar-label) { font-size: 0.8rem; color: var(--text-muted, #9fb0c3); font-variant-numeric: tabular-nums; }
  .result-bars :global(.bar-track) { height: 8px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden; }
  .result-bars :global(.bar-fill) { display: block; height: 100%; background: var(--primary); border-radius: 999px; transition: width 0.4s ease; }
  .result-bars :global(.bar-val) { font-size: 0.8rem; color: var(--text-muted, #9fb0c3); text-align: right; font-variant-numeric: tabular-nums; }

  .result-note {
    margin: 1.4rem auto 0; max-width: 480px; font-size: 0.88rem; line-height: 1.55;
    color: #fbbf24; background: rgba(251, 191, 36, 0.08); border: 1px solid rgba(251, 191, 36, 0.22);
    border-radius: 10px; padding: 0.7rem 0.9rem;
  }

  .result-context {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem;
    margin: 1.8rem auto 0; max-width: 480px;
  }
  .ctx-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .ctx-item strong { color: var(--text, #e8eef5); font-size: 1rem; font-variant-numeric: tabular-nums; }
  .ctx-item span { color: var(--text-muted, #9fb0c3); font-size: 0.78rem; line-height: 1.3; }

  .vocab-cta {
    max-width: 760px; margin: 3rem auto 0; text-align: center;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.18);
    border-radius: 16px; padding: 2.2rem 1.5rem;
  }
  .vocab-cta h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
  .vocab-cta p { color: var(--text-muted, #9fb0c3); margin: 0 0 1.4rem; line-height: 1.6; }
  .vocab-cta :global(.cta-buttons) { justify-content: center; }

  .vocab-explainer { max-width: 760px; margin: 3rem auto 0; }
  .vocab-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .vocab-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }

  .vocab-facts { max-width: 760px; margin: 3rem auto 0; }
  .vocab-facts h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .vocab-facts p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }
  .vocab-facts strong { color: var(--text, #e8eef5); }
  .facts-stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin: 1.4rem 0 0;
  }
