---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectAnswer from '../../../components/ToolDirectAnswer.astro';
import ToolAppNote from '../../../components/ToolAppNote.astro';
import ToolsForLanguage from '../../../components/ToolsForLanguage.astro';
import { vocabWords, VOCAB_LANG_CODES } from '../../../data/vocabWords';
import { vocabFacts } from '../../../data/vocabFacts';
import { languageFacts } from '../../../data/languageFacts';
import { getLanguageByCode } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';
import { CEFR_LANG_CODES } from '../../../data/cefrTest';

// One static page per supported language: /tools/vocabulary-size-estimator/spanish/ etc.
export function getStaticPaths() {
  return VOCAB_LANG_CODES.filter((code) => codeToSlug[code]).map((code) => ({
    params: { lang: codeToSlug[code] },
    props: { targetCode: code },
  }));
}

const { targetCode } = Astro.props;
const lang = getLanguageByCode(targetCode);
const name = lang?.name ?? targetCode;
const slug = codeToSlug[targetCode];

// All supported languages (for the "test another language" cross-link cluster).
const others = VOCAB_LANG_CODES.filter((c) => codeToSlug[c] && c !== targetCode).map((c) => {
  const l = getLanguageByCode(c);
  return { name: l?.name ?? c, flag: l?.flag ?? '', slug: codeToSlug[c] };
});

// The quiz shows one word at a time, so the words no longer sit in the markup by
// themselves. They are still server-rendered, alphabetically, in the collapsed
// word list below the explainer, which keeps the page indexable with JS off.
const data = vocabWords[targetCode];
const items = [
  ...data.bands.flatMap((b, bi) => b.words.map((w) => ({ w, band: bi }))),
  ...data.pseudowords.map((w) => ({ w, band: -1 })),
].sort((a, b) => a.w.localeCompare(b.w, targetCode));
const totalItems = items.length;

// Unique, language-specific vocabulary section (cognates/false friends + real
// frequency coverage). Reuses speakers/family from the shared languageFacts.
const fact = vocabFacts[targetCode];
const lf = languageFacts[targetCode];
const speakersLabel = lf
  ? lf.speakers >= 1000
    ? `${(lf.speakers / 1000).toFixed(1)}B`
    : `${Math.round(lf.speakers)}M`
  : null;

const canonicalUrl = `https://lingoseven.com/tools/vocabulary-size-estimator/${slug}/`;
const title = `How Many Words Do You Know in ${name}? Free Vocabulary Test | Lingo7`;
const description =
  `Free ${name} vocabulary size test. Answer yes or no to ${totalItems} words, one at a time, and estimate how many ${name} words you know. Frequency-based, takes about a minute.`;

const faq = [
  {
    question: `How many words do I know in ${name}?`,
    answer:
      `This test estimates it in about a minute. You see ${totalItems} ${name} words one at a time and answer yes or no to each. The words are sampled across the whole frequency range, from the most common down to rare ones. The share you know in each frequency band is scaled up to the size of that band, and the totals are added together. Made-up words are mixed in; saying yes to those lowers your score, which corrects for guessing.`,
  },
  {
    question: 'How is the vocabulary size estimate calculated?',
    answer:
      `The words come from real ${name} frequency lists, split into six bands by how common each word is. If you say yes to 6 of the 8 words shown from a band that represents 2,000 word families, that band contributes roughly 1,500 known words. We sum every band, then apply a guessing correction based on how many non-existent (pseudo) words you claimed. The result is an estimate of your written vocabulary up to about 25,000 word families.`,
  },
  {
    question: 'What are the made-up words for?',
    answer:
      `About a fifth of the words you see are pseudowords, invented strings that follow ${name} spelling rules but are not real words. They look plausible, so if you answer yes to them you are guessing. The test subtracts that guessing rate from your real score so the estimate stays honest. Be strict: say yes only if you could explain what the word means.`,
  },
  {
    question: `How many ${name} words do you need to be fluent?`,
    answer:
      'Roughly 2,000-3,000 of the most frequent word families cover everyday conversation (around B1). To read a novel comfortably you usually need about 8,000-9,000 word families (B2-C1). Educated native speakers know somewhere around 15,000-20,000. More than the count, what matters is meeting those words repeatedly in real context.',
  },
  {
    question: 'How accurate is this vocabulary test?',
    answer:
      'It is a quick estimate, not an exam. Because it samples only a few words per frequency band, the number can swing by a few hundred to a couple of thousand. It is best read as a range and a level, and as a way to see which frequency bands you have already mastered. Reading real books is the fastest way to grow that number.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${name} Vocabulary Size Test`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: canonicalUrl,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      { '@type': 'ListItem', position: 2, name: 'Vocabulary Size Test', item: 'https://lingoseven.com/tools/vocabulary-size-estimator/' },
      { '@type': 'ListItem', position: 3, name: `${name} test`, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="vocab">
    <div class="container">
      <header class="vocab-head">
        <p class="vocab-eyebrow"><a href="/tools/vocabulary-size-estimator/">Vocabulary size test</a></p>
        <h1>How many words do you know in <span>{name}</span>?</h1>
        <p class="vocab-intro">
          Answer yes or no, one word at a time, and get an estimate of your {name} vocabulary in
          about a minute.
        </p>
      </header>

      <div class="vocab-quiz" id="vocab-quiz">
        <div class="quiz-progress">
          <span class="quiz-bar-track"><span class="quiz-bar" id="quiz-bar"></span></span>
          <span class="quiz-counter"><span id="quiz-num">1</span> / {totalItems}</span>
        </div>

        <div class="quiz-card">
          <p class="quiz-question">Do you know this word?</p>
          <p class="quiz-word" id="quiz-word" aria-live="polite">{items[0].w}</p>
          <div class="quiz-buttons">
            <button type="button" class="quiz-no" id="btn-no">No</button>
            <button type="button" class="quiz-yes" id="btn-yes">Yes</button>
          </div>
          <button type="button" class="quiz-undo" id="btn-undo" hidden>Undo</button>
        </div>

        <p class="quiz-hint">
          Answer yes only if you could say what the word means. A few made-up words are mixed in to
          keep the estimate honest.
        </p>
        <p class="quiz-keys">
          <kbd>Y</kbd> yes · <kbd>N</kbd> no · <kbd>U</kbd> undo
        </p>
        <noscript>
          <p class="quiz-noscript">
            The interactive test needs JavaScript. You can still browse the full word list below.
          </p>
        </noscript>
      </div>

      <div class="vocab-result" id="vocab-result" hidden>
        <p class="result-eyebrow">Your estimated {name} vocabulary</p>
        <p class="result-number"><span id="result-count">0</span> <span class="result-unit">words</span></p>
        <p class="result-level"><span class="result-level-pill" id="result-level"></span></p>
        <p class="result-blurb" id="result-blurb"></p>

        <div class="result-bars" id="result-bars"></div>

        <p class="result-note" id="result-note" hidden></p>

        <div class="result-context">
          <div class="ctx-item"><strong>2,000-3,000</strong><span>everyday conversation</span></div>
          <div class="ctx-item"><strong>~8,000</strong><span>read novels comfortably</span></div>
          <div class="ctx-item"><strong>15,000-20,000</strong><span>educated native speaker</span></div>
        </div>

        <p class="result-next">
          Whatever your number is today, it grows the same way: reading. Books repeat the most
          useful words until you know them. Try it right in the widget below.
        </p>

        <button type="button" class="quiz-restart" id="btn-restart">Take the test again</button>
      </div>

      <ToolAppNote
        lead={`Reading grows vocabulary faster than any word list.`}
        body={`Words stick when you meet them again and again in real sentences, which is exactly what a book does. Lingo7 lets you read real books in ${name} with {uiLang} translation on tap and native-narrated audio. Free to start.`}
        targetLang={targetCode}
      />

      <ToolDirectAnswer
        lead={`An educated native ${name} speaker knows roughly 15,000 to 20,000 word families, a B2 reader about 8,000 to 9,000, and a B1 speaker around 2,000 to 3,000.`}
        body={`This free test estimates your own ${name} vocabulary in about a minute: ${totalItems} words shown one at a time, yes or no, sampled across six frequency bands, with hidden pseudowords to correct for guessing.`}
      />

      <div class="vocab-explainer">
        <h2>How the estimate works</h2>
        <p>
          The hardest part of measuring vocabulary is that you can't be asked about every word. So
          this test samples them. {name} words are sorted by <strong>frequency</strong>, how often
          they appear in real usage, and split into six bands, from the 600 most common words down
          to words ranked around 25,000th. You see eight words from each band.
        </p>
        <p>
          The share you know in a band is scaled up to the whole band. Know six of eight words in a
          band that stands for 2,000 word families, and you've likely got about 1,500 of them.
          Adding every band gives your estimate. Then comes the honesty check: mixed into the same
          sequence are <strong>invented words</strong> that look real but aren't. The more of those
          you answer yes to, the more the test assumes you were guessing, and it scales your score
          down to match.
        </p>
        <p>
          It's an estimate, not an exam, read it as a range and a level. What it's genuinely good at
          is showing <em>where</em> your {name} vocabulary thins out, and that the surest way to
          thicken it is to keep reading.
        </p>
      </div>

      <details class="vocab-wordlist">
        <summary>See all words used in this test</summary>
        <p>
          The list mixes real words from {name} frequency lists with a few made-up ones that catch
          guessing, so which is which is not marked here.
        </p>
        <ul class="wordlist-items">
          {items.map((it) => <li>{it.w}</li>)}
        </ul>
      </details>

      {fact && (
        <div class="vocab-facts">
          <h2>About {name} vocabulary</h2>
          <p>{fact.blurb}</p>
          <p>
            In real usage, the 1,000 most common {name} words already cover about
            <strong>{fact.coverage.top1000}%</strong> of everyday text, and the top 5,000 cover
            roughly <strong>{fact.coverage.top5000}%</strong>. The rarer words beyond that are where
            vocabularies really differ, which is why this test samples them too, not just the
            common ones.
          </p>
          <div class="facts-stats">
            <div class="facts-stat"><strong>{fact.coverage.top1000}%</strong><span>text covered by the top 1,000 words</span></div>
            {speakersLabel && <div class="facts-stat"><strong>{speakersLabel}</strong><span>speakers worldwide</span></div>}
            {lf && <div class="facts-stat"><strong>{lf.family}</strong><span>language family</span></div>}
          </div>
        </div>
      )}

      <ToolsForLanguage code={targetCode} name={name} currentId="vocabulary-size-estimator" />

      <div class="vocab-others">
        <h2>Test another language</h2>
        <div class="vocab-others-grid">
          {others.map((o) => (
            <a class="vocab-other" href={`/tools/vocabulary-size-estimator/${o.slug}/`}>
              <span class="vocab-other-flag">{o.flag}</span>{o.name}
            </a>
          ))}
        </div>
      </div>

      {CEFR_LANG_CODES.includes(targetCode) && (
        <p class="vocab-tool-link">
          <a href={`/tools/cefr-level-test/${slug}/`}>What's your {name} level? Take the CEFR test (A1-C2) &rarr;</a>
        </p>
      )}

      <p class="vocab-tool-link">
        <a href="/tools/language-difficulty-ranker/">Wondering which language to learn next? Rank 50 languages by difficulty &rarr;</a>
      </p>

      {targetCode !== 'en' && (
        <p class="vocab-tool-link">
          <a href={`/tools/how-long-to-learn-a-language/${slug}/`}>How long does it take to learn {name}? See the timeline &rarr;</a>
        </p>
      )}

      <div class="vocab-faq">
        <h2>Frequently asked questions</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/json" id="vocab-data" set:html={JSON.stringify(data)} />
  <script>
    type Band = { width: number; words: string[] };
    type LangData = { bands: Band[]; pseudowords: string[] };

    const dataEl = document.getElementById('vocab-data');
    const DATA: LangData = dataEl ? JSON.parse(dataEl.textContent || '{}') : { bands: [], pseudowords: [] };

    const quiz = document.getElementById('vocab-quiz') as HTMLDivElement;
    const result = document.getElementById('vocab-result') as HTMLDivElement;
    const wordEl = document.getElementById('quiz-word') as HTMLElement;
    const numEl = document.getElementById('quiz-num') as HTMLElement;
    const barEl = document.getElementById('quiz-bar') as HTMLElement;
    const yesBtn = document.getElementById('btn-yes') as HTMLButtonElement;
    const noBtn = document.getElementById('btn-no') as HTMLButtonElement;
    const undoBtn = document.getElementById('btn-undo') as HTMLButtonElement;
    const restartBtn = document.getElementById('btn-restart') as HTMLButtonElement;

    function shuffle<T>(arr: T[]): T[] {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    type Item = { w: string; band: number };
    type Answer = { band: number; known: boolean };

    function buildItems(): Item[] {
      const items: Item[] = [];
      DATA.bands.forEach((b, bi) => b.words.forEach((w) => items.push({ w, band: bi })));
      DATA.pseudowords.forEach((w) => items.push({ w, band: -1 }));
      return shuffle(items);
    }

    // The server renders the first alphabetical word as a placeholder; the client
    // reshuffles and drives the sequence from here.
    let order: Item[] = buildItems();
    let idx = 0;
    let answers: Answer[] = [];
    let finished = false;

    function renderCard() {
      const it = order[idx];
      if (!it) return;
      wordEl.textContent = it.w;
      wordEl.classList.remove('is-pop');
      void wordEl.offsetWidth; // retrigger the swap animation
      wordEl.classList.add('is-pop');
      numEl.textContent = String(idx + 1);
      barEl.style.width = `${(idx / order.length) * 100}%`;
      undoBtn.hidden = idx === 0;
    }

    function answer(known: boolean) {
      if (finished || idx >= order.length) return;
      answers.push({ band: order[idx].band, known });
      idx++;
      if (idx >= order.length) finish();
      else renderCard();
    }

    function undo() {
      if (finished || idx === 0) return;
      idx--;
      answers.pop();
      renderCard();
    }

    const fmt = (n: number) => n.toLocaleString('en-US');

    function level(n: number): { tag: string; blurb: string } {
      if (n < 750)
        return { tag: 'A1 · Beginner', blurb: "You're at the start. The first few hundred words already carry a lot of everyday meaning, keep going." };
      if (n < 1500)
        return { tag: 'A2 · Elementary', blurb: 'You can handle simple, familiar topics. Building toward the ~3,000 words that unlock real conversations.' };
      if (n < 3000)
        return { tag: 'B1 · Intermediate', blurb: 'You know enough to hold everyday conversations. Graded and simple authentic texts are within reach.' };
      if (n < 6000)
        return { tag: 'B2 · Upper-intermediate', blurb: "You're closing in on the ~8,000 words that make novels comfortable. Reading widely will get you there fastest." };
      if (n < 10000)
        return { tag: 'C1 · Advanced', blurb: 'You can read real books and follow nuanced discussion. The remaining words are rarer and best met in context.' };
      return { tag: 'C2 · Near-native', blurb: 'An exceptional vocabulary, in the range of an educated native speaker. Reading keeps even this sharp.' };
    }

    function estimate() {
      let pseudoHits = 0;
      const bandKnown = new Array(DATA.bands.length).fill(0);
      answers.forEach((a) => {
        if (!a.known) return;
        if (a.band === -1) pseudoHits++;
        else bandKnown[a.band]++;
      });
      const pseudoTotal = DATA.pseudowords.length;
      const f = pseudoTotal > 0 ? pseudoHits / pseudoTotal : 0;

      let total = 0;
      const bars = DATA.bands.map((b, i) => {
        const h = bandKnown[i] / b.words.length;
        let c = f < 1 ? (h - f) / (1 - f) : 0;
        c = Math.max(0, Math.min(1, c));
        total += c * b.width;
        return { known: bandKnown[i], of: b.words.length, pct: Math.round(c * 100) };
      });
      return { count: Math.round(total / 100) * 100, f, pseudoHits, pseudoTotal, bars };
    }

    function finish() {
      finished = true;
      const r = estimate();
      (document.getElementById('result-count') as HTMLElement).textContent = fmt(r.count);
      const lv = level(r.count);
      (document.getElementById('result-level') as HTMLElement).textContent = lv.tag;
      (document.getElementById('result-blurb') as HTMLElement).textContent = lv.blurb;

      const bandLabels = ['Top 600', '600-1.8k', '1.8k-4k', '4k-8k', '8k-15k', '15k-25k'];
      (document.getElementById('result-bars') as HTMLElement).innerHTML = r.bars
        .map(
          (b, i) => `
          <div class="bar-row">
            <span class="bar-label">${bandLabels[i]}</span>
            <span class="bar-track"><span class="bar-fill" style="width:${b.pct}%"></span></span>
            <span class="bar-val">${b.known}/${b.of}</span>
          </div>`
        )
        .join('');

      const note = document.getElementById('result-note') as HTMLElement;
      if (r.pseudoHits === 0) {
        note.hidden = true;
      } else {
        note.hidden = false;
        note.textContent = r.f >= 0.4
          ? `Heads up: you said yes to ${r.pseudoHits} of ${r.pseudoTotal} made-up words, so this estimate is adjusted down and is rough. Retake it and answer yes only to words you're sure of.`
          : `You said yes to ${r.pseudoHits} of ${r.pseudoTotal} made-up words, so we adjusted the score down a little to correct for guessing.`;
      }

      quiz.hidden = true;
      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function restart() {
      order = buildItems();
      idx = 0;
      answers = [];
      finished = false;
      result.hidden = true;
      quiz.hidden = false;
      renderCard();
      quiz.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    yesBtn.addEventListener('click', () => answer(true));
    noBtn.addEventListener('click', () => answer(false));
    undoBtn.addEventListener('click', undo);
    restartBtn.addEventListener('click', restart);

    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (quiz.hidden || finished) return;
      const k = e.key.toLowerCase();
      if (k === 'y' || k === '1' || e.key === 'ArrowRight') answer(true);
      else if (k === 'n' || k === '2' || e.key === 'ArrowLeft') answer(false);
      else if (k === 'u' || e.key === 'Backspace') {
        e.preventDefault();
        undo();
      }
    });

    // Shuffle client-side on load (the server-rendered word is alphabetical).
    renderCard();
  </script>
</BaseLayout>

<style>
  .vocab { padding: 3rem 0 4rem; }
  .vocab-head { max-width: 760px; margin: 0 auto; text-align: center; }
  .vocab-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    font-weight: 700; margin: 0 0 0.5rem;
  }
  .vocab-eyebrow a { color: var(--primary); text-decoration: none; }
  .vocab-eyebrow a:hover { text-decoration: underline; }
  .vocab-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
  .vocab-head h1 span { color: var(--primary); }
  .vocab-intro { color: var(--text-muted, #9fb0c3); font-size: 1.05rem; line-height: 1.6; margin: 0; }

  .vocab-quiz { max-width: 560px; margin: 2rem auto 0; }

  .quiz-progress { display: flex; align-items: center; gap: 0.8rem; margin: 0 0 1.2rem; }
  .quiz-bar-track {
    flex: 1; height: 8px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden;
  }
  .quiz-bar {
    display: block; height: 100%; width: 0; background: var(--primary);
    border-radius: 999px; transition: width 0.3s ease;
  }
  .quiz-counter {
    font-size: 0.82rem; color: var(--text-muted, #9fb0c3);
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }

  .quiz-card {
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 18px;
    background: rgba(255, 255, 255, 0.02); padding: 2rem 1.4rem 1.4rem; text-align: center;
  }
  .quiz-question {
    margin: 0; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em;
    font-weight: 700; color: var(--text-muted, #9fb0c3);
  }
  .quiz-word {
    margin: 1rem 0 1.8rem; font-size: clamp(1.9rem, 6vw, 2.7rem); font-weight: 800;
    line-height: 1.15; word-break: break-word;
  }
  .quiz-word.is-pop { animation: quiz-pop 0.18s ease-out; }
  @keyframes quiz-pop {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .quiz-word.is-pop { animation: none; }
    .quiz-bar { transition: none; }
  }

  .quiz-buttons { display: flex; gap: 0.8rem; }
  .quiz-no, .quiz-yes {
    flex: 1; min-height: 60px; border-radius: 14px; cursor: pointer;
    font-size: 1.1rem; font-weight: 700; padding: 0.9rem 1rem;
  }
  .quiz-no {
    background: transparent; color: var(--text, #e8eef5);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .quiz-no:hover { border-color: rgba(255, 255, 255, 0.45); }
  .quiz-yes {
    background: var(--gradient, linear-gradient(135deg, #4ade80, #22c55e)); color: #0b1220;
    border: none;
  }
  .quiz-yes:hover { filter: brightness(1.05); }
  .quiz-no:focus-visible, .quiz-yes:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }

  .quiz-undo {
    display: inline-block; margin: 1rem auto 0; background: none; border: none;
    color: var(--text-muted, #9fb0c3); font-size: 0.88rem; font-weight: 600;
    cursor: pointer; padding: 0.4rem 0.6rem;
  }
  .quiz-undo:hover { color: var(--text, #e8eef5); }
  .quiz-undo[hidden] { display: none; }

  .quiz-hint {
    margin: 1.1rem auto 0; max-width: 460px; text-align: center;
    font-size: 0.88rem; line-height: 1.55; color: var(--text-muted, #9fb0c3);
  }
  .quiz-keys {
    margin: 0.7rem auto 0; text-align: center; font-size: 0.8rem;
