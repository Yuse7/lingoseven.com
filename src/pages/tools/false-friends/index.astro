---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectAnswer from '../../../components/ToolDirectAnswer.astro';
import ToolAppNote from '../../../components/ToolAppNote.astro';
import { getLanguageByCode } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';
import { falseFriends, FALSE_FRIENDS_LANGS } from '../../../data/falseFriends';

// Hub: pick a language, jump to its false-friends list.
const langs = FALSE_FRIENDS_LANGS.filter((code) => codeToSlug[code])
  .map((code) => {
    const l = getLanguageByCode(code);
    return {
      name: l?.name ?? code,
      flag: l?.flag ?? '',
      slug: codeToSlug[code],
      count: falseFriends[code]?.length ?? 0,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const totalPairs = langs.reduce((sum, l) => sum + l.count, 0);

// Two real showcase examples pulled straight from the data (first two languages).
const showcase = FALSE_FRIENDS_LANGS.slice(0, 2)
  .filter((code) => falseFriends[code]?.length)
  .map((code) => {
    const l = getLanguageByCode(code);
    const f = falseFriends[code][0];
    return `${l?.name ?? code} ${f.word} means ${f.meaning.split(',')[0].trim()}, not ${f.looksLike}`;
  });
const showcaseSentence = showcase.length >= 2 ? `${showcase[0]}; ${showcase[1]}.` : `${showcase[0] ?? ''}.`;

const canonicalUrl = 'https://lingoseven.com/tools/false-friends/';
const title = 'False Friends: English Lookalike Words by Language | Lingo7';
const description =
  `False friends are words that look like an English word but mean something different. Browse verified false friends in ${langs.length} languages, what they really mean, and how to say the English word.`;

const faq = [
  {
    question: 'What are false friends in language learning?',
    answer:
      'False friends are pairs of words in two languages that look or sound alike but mean different things. Spanish embarazada looks like embarrassed but means pregnant; German Gift looks like a present but means poison. They come from shared roots or borrowings whose meanings drifted apart, and they trip up learners because a familiar-looking word feels safe to guess.',
  },
  {
    question: 'Why are false friends so easy to get wrong?',
    answer:
      'Your brain rewards the shortcut. When a foreign word looks like one you already know, you skip the check and assume the English meaning. That works most of the time, which is exactly why the exceptions catch you off guard, often in the middle of a sentence where the wrong meaning changes everything.',
  },
  {
    question: 'How do I stop confusing false friends?',
    answer:
      'Learn the common ones once, then get repeated exposure in context. Reading real sentences, with a translation a tap away, attaches the correct meaning to a situation instead of to the English lookalike. That contextual memory sticks far better than a flashcard list. Lingo7 pairs reading with native audio for exactly this.',
  },
  {
    question: 'Are false friends the same in every language?',
    answer:
      'No. Each language has its own set, shaped by its history with English and Latin. Some are shared across the Romance languages (the library trap appears in Spanish, French, Italian, and Portuguese), while others are unique. Pick your language above to see the ones that will actually trip you up.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'False Friends by Language',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: canonicalUrl,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: langs.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${l.name} false friends`,
      url: `https://lingoseven.com/tools/false-friends/${l.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="ff">
    <div class="container">
      <header class="ff-head">
        <p class="ff-eyebrow">Free tool</p>
        <h1>False friends: the words that look English but aren't</h1>
        <p class="ff-intro">
          Some foreign words look exactly like a word you already know, then mean something completely
          different. Pick a language to see its most common false friends, each with the English word it
          resembles, what it really means, and how to say the English sense instead. Every entry is real and
          verified.
        </p>
      </header>

      <ToolDirectAnswer
        lead={`False friends are words in two languages that look alike but mean different things, and every language has them.`}
        body={`${showcaseSentence} This free tool lists verified false friends across ${langs.length} languages. Pick a language to see its list and stop the mix-ups before they happen.`}
      />

      <div class="ff-lang-grid">
        {
          langs.map((l) => (
            <a class="ff-lang-card" href={`/tools/false-friends/${l.slug}/`}>
              <span class="ff-lang-flag">{l.flag}</span>
              <span class="ff-lang-name">{l.name}</span>
              <span class="ff-lang-sub">{l.count} false friends</span>
            </a>
          ))
        }
      </div>

      <div class="ff-explainer">
        <h2>How false friends happen</h2>
        <p>
          A false friend is a word that <strong>looks or sounds like a word in your language</strong> but
          means something else. English overlaps heavily with European languages because it borrowed from
          Latin, Greek, and French, and shares older roots with the Germanic ones. The spelling often stayed
          close while the meaning drifted, which is how you end up with words that read like an old friend and
          behave like a stranger.
        </p>
        <p>
          The reason they catch you is psychological, not grammatical. A familiar-looking word feels safe, so
          you skip the check and guess the English meaning. That guess is right often enough to become a
          habit, and the habit is exactly what the exceptions exploit. <strong>Learning the common offenders
          once</strong>, then meeting them in context, is what breaks the habit for good. Parallel text and
          audio make that context effortless, which is what reading in Lingo7 is built for.
        </p>
      </div>

      <ToolAppNote
        lead="Then meet those words in real books."
        body="False friends stick when you see them doing their real job in a sentence. Lingo7 lets you read real books with sentence-aligned translation and native-narrated audio, so the true meaning attaches to the story instead of the English lookalike. Save the tricky words and review them later. Free to start."
      />

      <p class="ff-tool-link">
        <a href="/tools/reading-level-recommender/">Find books at your level in any language &rarr;</a>
      </p>
      <p class="ff-tool-link">
        <a href="/tools/cefr-level-test/">Not sure of your level? Take the CEFR test (A1-C2) &rarr;</a>
      </p>
      <p class="ff-tool-link">
        <a href="/tools/how-long-to-learn-a-language/">How long does it take to learn a language? &rarr;</a>
      </p>
      <p class="ff-tool-link">
        <a href="/tools/language-difficulty-ranker/">Rank every language by difficulty for your native tongue &rarr;</a>
      </p>

      <div class="ff-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ff { padding: 3rem 0 4rem; }
  .ff-head { max-width: 760px; margin: 0 auto 1.5rem; text-align: center; }
  .ff-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    color: var(--primary); font-weight: 700; margin: 0 0 0.5rem;
  }
  .ff-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
  .ff-intro { color: var(--text-muted, #9fb0c3); font-size: 1.05rem; line-height: 1.6; margin: 0; }

  .ff-lang-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.8rem; max-width: 820px; margin: 2rem auto 0;
  }
  .ff-lang-card {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    text-decoration: none; text-align: center;
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px; padding: 1.2rem 1rem; transition: all 0.15s ease;
  }
  .ff-lang-card:hover { border-color: var(--primary); transform: translateY(-2px); }
  .ff-lang-flag { font-size: 2rem; }
  .ff-lang-name { color: var(--text, #e8eef5); font-weight: 700; font-size: 1.05rem; }
  .ff-lang-sub { color: var(--text-muted, #9fb0c3); font-size: 0.78rem; font-variant-numeric: tabular-nums; }

  .ff-explainer { max-width: 760px; margin: 3rem auto 0; }
  .ff-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .ff-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }
  .ff-explainer strong { color: var(--text, #e8eef5); }

  .ff-tool-link { max-width: 760px; margin: 2rem auto 0; text-align: center; font-size: 0.95rem; }
  .ff-tool-link a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .ff-tool-link a:hover { text-decoration: underline; }

  .ff-faq { max-width: 760px; margin: 3rem auto 0; }
  .ff-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .ff-faq details {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
  }
  .ff-faq summary { cursor: pointer; font-weight: 600; }
  .ff-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }
</style>
