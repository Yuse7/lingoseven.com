---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaButtons from '../../../components/CtaButtons.astro';
import { cefrTest, CEFR_LANG_CODES } from '../../../data/cefrTest';
import { getLanguageByCode } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';

// Hub page: pick a language, then take its CEFR level test.
const langs = CEFR_LANG_CODES.filter((code) => codeToSlug[code] && cefrTest[code]).map((code) => {
  const l = getLanguageByCode(code);
  return { name: l?.name ?? code, flag: l?.flag ?? '', slug: codeToSlug[code] };
});

const canonicalUrl = 'https://lingoseven.com/tools/cefr-level-test/';
const title = 'CEFR Level Test: Find Your Language Level (A1-C2) | Lingo7';
const description =
  `Free CEFR level test. Pick your language and find your level from A1 to C2 in about five minutes, with grammar and vocabulary subscores. ${langs.length} languages, no sign-up.`;

const faq = [
  {
    question: 'What is a CEFR level test?',
    answer:
      'It places your ability on the Common European Framework scale, from A1 (beginner) to C2 (proficient). You answer a series of questions that get harder as you go, covering grammar and vocabulary. Your level is the highest band where you keep answering correctly, so it reflects what you can do reliably.',
  },
  {
    question: 'What do A1, A2, B1, B2, C1 and C2 mean?',
    answer:
      'A1 and A2 are beginner and elementary (simple phrases, everyday basics). B1 and B2 are intermediate and upper-intermediate (real conversations, then reading novels and working in the language). C1 and C2 are advanced and proficient (near-native command with full nuance). Most learners who want to "use" a language are aiming for B2.',
  },
  {
    question: 'Which languages can I test?',
    answer:
      `Pick one above to start. Each test uses questions written for that language across all six CEFR levels, takes about five minutes, and gives you a level plus grammar and vocabulary subscores. We are adding more languages over time.`,
  },
  {
    question: 'Is the test free, and is it an official certificate?',
    answer:
      'The test is free and needs no sign-up. It is a self-assessment to place your level and show where to focus, not an official certificate. Accredited exams test all four skills under controlled conditions; this points you at the right level and the fastest way to climb it.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CEFR Level Test',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: canonicalUrl,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: langs.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${l.name} CEFR level test`,
      url: `https://lingoseven.com/tools/cefr-level-test/${l.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="cefr">
    <div class="container">
      <header class="cefr-head">
        <p class="cefr-eyebrow">Free tool</p>
        <h1>What's your language level?</h1>
        <p class="cefr-intro">
          Find your level on the CEFR scale, from A1 (beginner) to C2 (proficient), in about five
          minutes. Pick a language below to start. Each test scores grammar and vocabulary, shows where
          your level starts to thin out, and points you at the fastest way up: reading real books.
        </p>
      </header>

      <div class="lang-grid">
        {
          langs.map((l) => (
            <a class="lang-card" href={`/tools/cefr-level-test/${l.slug}/`}>
              <span class="lang-flag">{l.flag}</span>
              <span class="lang-name">{l.name}</span>
              <span class="lang-sub">level test &rarr;</span>
            </a>
          ))
        }
      </div>

      <div class="cefr-cta">
        <h2>The fastest way up the CEFR scale is reading</h2>
        <p>
          Whatever your level, you climb quicker by meeting the language in real sentences, again and
          again. Lingo7 lets you read real books at your level, with tap-to-translate and
          native-narrated audio. Free to start.
        </p>
        <CtaButtons size="large" />
      </div>

      <div class="cefr-explainer">
        <h2>How the test works</h2>
        <p>
          Each language's test has questions spread evenly across the six CEFR levels (A1 through C2),
          ordered from easiest to hardest. Roughly half check <strong>grammar</strong> and half check
          <strong> vocabulary</strong>, so the result reflects both sides of your ability.
        </p>
        <p>
          Your level is the highest band where you stay above 60% correct. The test climbs from A1 and
          stops at the first level you can no longer hold, because that ceiling reflects what you can do
          reliably. You also get a per-level breakdown and a grammar-versus-vocabulary split, so you see
          exactly where to focus next.
        </p>
      </div>

      <p class="cefr-tool-link">
        <a href="/tools/vocabulary-size-estimator/">How many words do you know? Take the vocabulary test &rarr;</a>
      </p>
      <p class="cefr-tool-link">
        <a href="/tools/language-difficulty-ranker/">Wondering which language to learn next? Rank 50 languages by difficulty &rarr;</a>
      </p>

      <div class="cefr-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cefr { padding: 3rem 0 4rem; }
  .cefr-head { max-width: 760px; margin: 0 auto 1.5rem; text-align: center; }
  .cefr-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    color: var(--primary); font-weight: 700; margin: 0 0 0.5rem;
  }
  .cefr-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
  .cefr-intro { color: var(--text-muted, #9fb0c3); font-size: 1.05rem; line-height: 1.6; margin: 0 0 1.5rem; }

  .lang-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.8rem; max-width: 820px; margin: 1.5rem auto 0;
  }
  .lang-card {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    text-decoration: none; text-align: center;
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px; padding: 1.2rem 1rem; transition: all 0.15s ease;
  }
  .lang-card:hover { border-color: var(--primary); transform: translateY(-2px); }
  .lang-flag { font-size: 2rem; }
  .lang-name { color: var(--text, #e8eef5); font-weight: 700; font-size: 1.05rem; }
  .lang-sub { color: var(--text-muted, #9fb0c3); font-size: 0.82rem; }

  .cefr-cta {
    max-width: 760px; margin: 3rem auto 0; text-align: center;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.18);
    border-radius: 16px; padding: 2.2rem 1.5rem;
  }
  .cefr-cta h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
  .cefr-cta p { color: var(--text-muted, #9fb0c3); margin: 0 0 1.4rem; line-height: 1.6; }
  .cefr-cta :global(.cta-buttons) { justify-content: center; }

  .cefr-explainer { max-width: 760px; margin: 3rem auto 0; }
  .cefr-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .cefr-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }
  .cefr-explainer strong { color: var(--text, #e8eef5); }

  .cefr-tool-link { max-width: 760px; margin: 2rem auto 0; text-align: center; font-size: 0.95rem; }
  .cefr-tool-link a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .cefr-tool-link a:hover { text-decoration: underline; }

  .cefr-faq { max-width: 760px; margin: 3rem auto 0; }
  .cefr-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .cefr-faq details {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
  }
  .cefr-faq summary { cursor: pointer; font-weight: 600; }
  .cefr-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }
</style>
