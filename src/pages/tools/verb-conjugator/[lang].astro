---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectAnswer from '../../../components/ToolDirectAnswer.astro';
import CtaButtons from '../../../components/CtaButtons.astro';
import ToolsForLanguage from '../../../components/ToolsForLanguage.astro';
import { getLanguageByCode } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';
import { languageFacts } from '../../../data/languageFacts';
import { CEFR_LANG_CODES } from '../../../data/cefrTest';
import { READING_LANG_CODES } from '../../../data/readingBooks';
import { conjugations, CONJ_LANGS } from '../../../data/conjugations';

// Shape of a conjugation entry (mirrors src/data/conjugations.ts). Declared
// locally so the page does not depend on the data module re-exporting the type;
// TypeScript's structural typing keeps it compatible with the imported data.
interface Verb {
  verb: string;
  english: string;
  note: string;
  tenses: { name: string; forms: { person: string; form: string }[] }[];
}

// One static page per language that has a curated verb set + a URL slug.
export function getStaticPaths() {
  return CONJ_LANGS.filter((code) => codeToSlug[code]).map((code) => ({
    params: { lang: codeToSlug[code] },
    props: { code },
  }));
}

const { code } = Astro.props;
const lang = getLanguageByCode(code);
const name = lang?.name ?? code;
const slug = codeToSlug[code];
const verbs: Verb[] = conjugations[code];

// Tense labels come straight from the data (they carry native names).
const tenseNames = verbs[0].tenses.map((t) => t.name);
const tenseList = tenseNames.join(', ');

// Representative verbs for the copy, pulled from the data so forms stay exact.
const firstVerb = verbs[0];
const toBe = verbs.find((v) => v.english === 'to be') ?? verbs[1];

// A concrete first-person example across the three tenses, from the data itself.
const exForms = firstVerb.tenses.map((t) => t.forms[0].form);
const exPerson = firstVerb.tenses[0].forms[0].person;

const commonList = verbs
  .slice(0, 8)
  .map((v) => `${v.verb} (${v.english})`)
  .join(', ');

const lf = languageFacts[code];
const fsiPhrase =
  lf && lf.fsiHours > 0
    ? ` ${name} is FSI Category ${lf.fsiCategory}, about ${lf.fsiHours} hours to professional proficiency.`
    : '';

const canonicalUrl = `https://lingoseven.com/tools/verb-conjugator/${slug}/`;
const title = `${name} Verb Conjugator (Present, Past, Future) | Lingo7`;
const description =
  `Conjugate ${verbs.length} essential ${name} verbs in the present, past and future. Full conjugation tables for regular and irregular verbs, tap a verb to see every form.`;

const answerBody =
  `This free tool lays out full tables for ${verbs.length} of the most common ${name} verbs across ${tenseNames.length} core tenses. Pick a verb like ${firstVerb.verb} (${firstVerb.english}) or ${toBe.verb} (${toBe.english}) to see every form.`;

const faq = [
  {
    question: `How do you conjugate ${name} verbs?`,
    answer:
      `To conjugate a ${name} verb, you change its form to match the subject and the tense. Take ${firstVerb.verb} (${firstVerb.english}): in the ${exPerson} form it is ${exForms[0]} now, ${exForms[1]} in the past, and ${exForms[2]} in the future. Regular verbs follow a fixed pattern by ending; irregular ones you learn one at a time. This tool shows the full table for each.`,
  },
  {
    question: `What are the most common ${name} verbs?`,
    answer:
      `The most common ${name} verbs include ${commonList}. These high-frequency verbs are also the most irregular in most languages, which is why they are worth drilling first. This tool has full present, past and future tables for all ${verbs.length}.`,
  },
  {
    question: `Is ${name} verb conjugation hard?`,
    answer:
      `${name} conjugation takes practice but follows clear rules. Regular verbs are predictable once you learn the endings; the real work is the handful of very common irregular verbs and knowing which tense to use.${fsiPhrase} The fastest way to make the forms automatic is to meet them again and again in real sentences, which is what reading does.`,
  },
  {
    question: `How many tenses does ${name} have?`,
    answer:
      `These three, ${tenseList}, are the core of everyday ${name} and the right place to start. Real ${name} also uses other moods and aspects (and, in most languages, extra compound tenses), but they build on the same stems and personal endings you see in these tables.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${name} Verb Conjugator`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: canonicalUrl,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Common ${name} verbs and their conjugations`,
    itemListElement: verbs.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${v.verb} (${v.english})`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Verb Conjugator',
        item: 'https://lingoseven.com/tools/verb-conjugator/',
      },
      { '@type': 'ListItem', position: 3, name, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];

// Cross-link cluster: every other language with a conjugator page.
const others = CONJ_LANGS.filter((c) => c !== code && codeToSlug[c])
  .map((c) => {
    const l = getLanguageByCode(c);
    return { name: l?.name ?? c, flag: l?.flag ?? '', slug: codeToSlug[c] };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="vc">
    <div class="container">
      <header class="vc-head">
        <p class="vc-eyebrow"><a href="/tools/verb-conjugator/">Verb conjugator</a></p>
        <h1><span>{name}</span> verb conjugation tables</h1>
        <p class="vc-intro">
          Pick one of {verbs.length} common {name} verbs and see it fully conjugated in the present, past
          and future, for every person. These are the verbs you meet first and use most, regular and
          irregular.
        </p>
      </header>

      <ToolDirectAnswer
        lead={`${name} verb conjugation is how a verb changes its ending, and sometimes its stem, to match the subject and the tense.`}
        body={answerBody}
      />

      <div class="vc-controls" role="group" aria-label={`Choose a ${name} verb`}>
        <span class="vc-controls-label">Choose a verb</span>
        <div class="vc-pills" id="vc-pills">
          {
            verbs.map((v, i) => (
              <button type="button" class={`vc-pill${i === 0 ? ' is-active' : ''}`} data-idx={i}>
                {v.verb}
              </button>
            ))
          }
        </div>
      </div>

      <p class="vc-caption" id="vc-caption">
        Showing <strong>{firstVerb.verb}</strong> ({firstVerb.english}) &middot; {firstVerb.note}
      </p>

      <div class="vc-verbs" id="vc-verbs">
        {
          verbs.map((v, i) => (
            <article
              class={`vc-verb${i === 0 ? '' : ' is-hidden'}`}
              data-idx={i}
              data-verb={v.verb}
              data-en={v.english}
              data-note={v.note}
            >
              <div class="vc-verb-head">
                <h3 class="vc-verb-title">{v.verb}</h3>
                <span class="vc-verb-en">{v.english}</span>
                <span class="vc-verb-note">{v.note}</span>
              </div>
              <div class="vc-tenses">
                {v.tenses.map((t) => (
                  <div class="vc-tense">
                    <div class="vc-tense-name">{t.name}</div>
                    <table class="vc-table">
                      <tbody>
                        {t.forms.map((f) => (
                          <tr>
                            <th scope="row">{f.person}</th>
                            <td>{f.form}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <div class="vc-cta">
        <h2>Learn {name} verbs faster by reading them in context</h2>
        <p>
          Tables get you started, but verbs stick when you meet them in real sentences. Lingo7 lets you
          read real books in {name} with sentence-aligned translation and native-narrated audio, so you
          see these forms again and again where they actually live. Tap any word to save it, then review
          it later. Free to start.
        </p>
        <CtaButtons size="large" />
      </div>

      <div class="vc-explainer">
        <h2>How {name} conjugation works</h2>
        <p>
          To <strong>conjugate</strong> a verb is to change its form to show who is doing the action (the
          subject) and when (the tense). In each table above, the subject runs down the left and the
          matching form sits beside it, across {tenseNames.length} core tenses: {tenseList}.
        </p>
        <p>
          Verbs split into <strong>regular</strong> and <strong>irregular</strong>. Regular verbs follow a
          fixed pattern you can apply to thousands of others once you learn it; the badge on each verb
          names its type ({firstVerb.note} for {firstVerb.verb}, for example). Irregular verbs like {toBe.verb}
          ({toBe.english}) change in ways you memorize one by one, which is exactly why the most common
          verbs are so often the most irregular.
        </p>
        <p>
          You do not learn these by staring at the grid. You learn them by meeting them, over and over, in
          real sentences until the pattern feels obvious. That is what reading does, and it is what reading
          in Lingo7 is built for: open a real book in {name}, tap any verb form to see its meaning, and the
          conjugations start to stick on their own.
        </p>
      </div>

      <div class="vc-links">
        <p class="vc-tool-link">
          <a href={`/en/learn/${slug}/`}>Start reading {name} with Lingo7 &rarr;</a>
        </p>
        {READING_LANG_CODES.includes(code) && (
          <p class="vc-tool-link">
            <a href={`/tools/reading-level-recommender/${slug}/`}>Find {name} books at your level (A1 to C1) &rarr;</a>
          </p>
        )}
        {CEFR_LANG_CODES.includes(code) && (
          <p class="vc-tool-link">
            <a href={`/tools/cefr-level-test/${slug}/`}>Not sure of your level? Take the {name} CEFR test (A1-C2) &rarr;</a>
          </p>
        )}
        {lf && lf.fsiHours > 0 && (
          <p class="vc-tool-link">
            <a href={`/tools/how-long-to-learn-a-language/${slug}/`}>How long does it take to learn {name}? See the timeline &rarr;</a>
          </p>
        )}
        <p class="vc-tool-link">
          <a href="/tools/language-difficulty-ranker/">Compare {name} against 48 languages by difficulty &rarr;</a>
        </p>
      </div>

      <ToolsForLanguage code={code} name={name} currentId="verb-conjugator" />

      <div class="vc-others">
        <h2>Conjugate verbs in another language</h2>
        <div class="vc-others-grid">
          {
            others.map((o) => (
              <a class="vc-other" href={`/tools/verb-conjugator/${o.slug}/`}>
                <span class="vc-other-flag">{o.flag}</span>
                {o.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="vc-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.vc-pill'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.vc-verb'));
    const caption = document.getElementById('vc-caption');

    function show(idx: string) {
      panels.forEach((p) => p.classList.toggle('is-hidden', p.dataset.idx !== idx));
      pills.forEach((p) => p.classList.toggle('is-active', p.dataset.idx === idx));
      const active = panels.find((p) => p.dataset.idx === idx);
      if (active && caption) {
        const verb = active.dataset.verb || '';
        const en = active.dataset.en || '';
        const note = active.dataset.note || '';
        caption.innerHTML = `Showing <strong>${verb}</strong> (${en}) · ${note}`;
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => show(pill.dataset.idx || '0'));
    });
  </script>
</BaseLayout>

<style>
  .vc { padding: 3rem 0 4rem; }
  .vc-head { max-width: 760px; margin: 0 auto 1.5rem; text-align: center; }
  .vc-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    font-weight: 700; margin: 0 0 0.5rem;
  }
  .vc-eyebrow a { color: var(--primary); text-decoration: none; }
  .vc-eyebrow a:hover { text-decoration: underline; }
  .vc-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
  .vc-head h1 span { color: var(--primary); }
  .vc-intro { color: var(--text-muted, #9fb0c3); font-size: 1.05rem; line-height: 1.6; margin: 0; }

  .vc-controls {
    display: flex; flex-direction: column; align-items: center; gap: 0.7rem;
    max-width: 820px; margin: 2.2rem auto 0;
  }
  .vc-controls-label {
    font-size: 0.82rem; color: var(--text-muted, #9fb0c3); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .vc-pills { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; }
  .vc-pill {
    font: inherit; cursor: pointer; color: var(--text, #e8eef5); font-weight: 700;
    background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px; padding: 0.5rem 1.1rem; transition: all 0.12s ease;
  }
  .vc-pill:hover { border-color: var(--primary); color: var(--primary); }
  .vc-pill.is-active { background: var(--primary); color: #0b1120; border-color: var(--primary); }

  .vc-caption {
    max-width: 820px; margin: 1.2rem auto 0; text-align: center;
    color: var(--text-muted, #9fb0c3); font-size: 0.92rem;
  }
  .vc-caption strong { color: var(--text, #e8eef5); }

  .vc-verbs { max-width: 820px; margin: 0 auto; }
  .vc-verb { margin: 1.4rem auto 0; }
  .vc-verb.is-hidden { display: none; }
  .vc-verb-head {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem;
    padding-bottom: 0.4rem;
  }
  .vc-verb-title { margin: 0; font-size: 1.4rem; font-weight: 800; color: var(--text, #e8eef5); }
  .vc-verb-en { color: var(--text-muted, #9fb0c3); font-size: 1rem; }
  .vc-verb-note {
    margin-left: auto; white-space: nowrap; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted, #9fb0c3);
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; padding: 0.25rem 0.7rem;
  }

  .vc-tenses {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem; margin-top: 0.9rem;
  }
  .vc-tense {
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px; overflow: hidden;
  }
  .vc-tense-name {
    padding: 0.55rem 0.85rem; font-weight: 800; font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--primary);
    background: rgba(74, 222, 128, 0.1);
  }
  .vc-table { width: 100%; border-collapse: collapse; }
  .vc-table th, .vc-table td {
    padding: 0.42rem 0.85rem; text-align: left; font-size: 0.93rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06); vertical-align: baseline;
  }
  .vc-table th { color: var(--text-muted, #9fb0c3); font-weight: 500; white-space: nowrap; width: 44%; }
  .vc-table td { color: var(--text, #e8eef5); font-weight: 700; }

  .vc-cta {
    max-width: 760px; margin: 3rem auto 0; text-align: center;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.18);
    border-radius: 16px; padding: 2.2rem 1.5rem;
  }
  .vc-cta h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
  .vc-cta p { color: var(--text-muted, #9fb0c3); margin: 0 0 1.4rem; line-height: 1.6; }
  .vc-cta :global(.cta-buttons) { justify-content: center; }

  .vc-explainer { max-width: 760px; margin: 3rem auto 0; }
  .vc-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .vc-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }
  .vc-explainer strong { color: var(--text, #e8eef5); }

  .vc-links { max-width: 760px; margin: 2.4rem auto 0; }
  .vc-tool-link { margin: 0.6rem 0 0; text-align: center; font-size: 0.95rem; }
  .vc-tool-link a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .vc-tool-link a:hover { text-decoration: underline; }

  .vc-others { max-width: 760px; margin: 3rem auto 0; text-align: center; }
  .vc-others h2 { font-size: 1.3rem; margin: 0 0 1rem; }
  .vc-others-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .vc-other {
    display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;
    color: var(--text, #e8eef5); font-weight: 600; font-size: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; padding: 0.4rem 0.9rem;
    background: rgba(255, 255, 255, 0.03); transition: all 0.12s ease;
  }
  .vc-other:hover { border-color: var(--primary); color: var(--primary); }
  .vc-other-flag { font-size: 1.1rem; }

  .vc-faq { max-width: 760px; margin: 3rem auto 0; }
  .vc-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .vc-faq details {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
  }
  .vc-faq summary { cursor: pointer; font-weight: 600; }
  .vc-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }

  @media (max-width: 600px) {
    .vc-tenses { grid-template-columns: 1fr; }
    .vc-verb-note { margin-left: 0; }
  }
</style>
