---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectAnswer from '../../../components/ToolDirectAnswer.astro';
import CtaButtons from '../../../components/CtaButtons.astro';
import { getLanguageByCode } from '../../../data/languages';
import { codeToSlug } from '../../../data/languageSlugs';
import { flashcards, FLASHCARD_LANGS } from '../../../data/flashcards';

// Hub: pick a language, jump to its ready-made flashcard deck.
const langs = FLASHCARD_LANGS.filter((code) => codeToSlug[code])
  .map((code) => {
    const l = getLanguageByCode(code);
    return {
      name: l?.name ?? code,
      flag: l?.flag ?? '',
      slug: codeToSlug[code],
      count: flashcards[code]?.length ?? 0,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const totalCards = langs.reduce((sum, l) => sum + l.count, 0);

const canonicalUrl = 'https://lingoseven.com/tools/flashcards/';
const title = `Free Flashcards to Learn a Language (${langs.length} Languages) | Lingo7`;
const description =
  `Free, ready-made flashcard decks of the most common words in ${langs.length} languages. Each card has the word, its meaning, and an example. Download as CSV for Anki or Quizlet.`;

const faq = [
  {
    question: 'What are the best flashcards for learning a language?',
    answer:
      'The best flashcards drill the most frequent words first, because a few thousand high-frequency words cover most of everyday speech and text. Each card should carry an example sentence so you learn the word in context, not as a bare translation. Every deck here is built from the highest-frequency words in that language, with a meaning and a real example on each card.',
  },
  {
    question: 'How do I turn a word list into Anki flashcards?',
    answer:
      'Save the list as a CSV with one row per card (word, meaning, and optionally an example), then in Anki choose File, Import and map the columns to the front and back of your note type. Each deck on this page is already formatted that way: click Download CSV and import it straight into Anki, Quizlet, or any spaced-repetition app.',
  },
  {
    question: 'Do flashcards actually work for language learning?',
    answer:
      'Yes, for building recognition of vocabulary, especially when paired with spaced repetition so you review words just before you would forget them. Their limit is context: flashcards teach you to recognize a word, not to use it. The strongest combination is flashcards for raw vocabulary plus reading for grammar, collocation, and meaning in real sentences.',
  },
  {
    question: 'How many words should I learn with flashcards?',
    answer:
      'The first 2,000 to 3,000 words carry most of the load in any language, and around 5,000 gets you comfortably through real books. Flashcards are the fastest way to front-load that core. Beyond it, most vocabulary is picked up more efficiently through reading, where you meet less common words naturally in context.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Language Flashcards',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: canonicalUrl,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Lingo7', url: 'https://lingoseven.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: langs.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${l.name} flashcards`,
      url: `https://lingoseven.com/tools/flashcards/${l.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="fc">
    <div class="container">
      <header class="fc-head">
        <p class="fc-eyebrow">Free tool</p>
        <h1>Free flashcards to learn a language</h1>
        <p class="fc-intro">
          The fastest words to learn are the ones you see most. Pick a language to get a ready-made deck of
          its highest-frequency words, each with a plain English meaning and a real example sentence.
          Download it as a CSV for Anki or Quizlet in one click.
        </p>
      </header>

      <ToolDirectAnswer
        lead={`Flashcards are a fast way to learn the most common words in a new language before you start reading.`}
        body={`Pick a language below to get a ready-made deck of its highest-frequency words, each with an English meaning and an example sentence. Download it as a CSV for Anki or Quizlet, then lock the words in by reading real books. ${totalCards} cards across ${langs.length} languages.`}
      />

      <div class="fc-langgrid">
        {
          langs.map((l) => (
            <a class="fc-langcard" href={`/tools/flashcards/${l.slug}/`}>
              <span class="fc-langflag">{l.flag}</span>
              <span class="fc-langname">{l.name}</span>
              <span class="fc-langsub">{l.count} words &middot; CSV</span>
            </a>
          ))
        }
      </div>

      <div class="fc-cta">
        <h2>Then turn those words into real reading</h2>
        <p>
          Flashcards fix words in memory; reading teaches you to use them. Lingo7 lets you read real books
          with sentence-aligned translation and native-narrated audio, and save any word to review later.
          Free to start.
        </p>
        <CtaButtons size="large" />
      </div>

      <div class="fc-explainer">
        <h2>How the decks work</h2>
        <p>
          Each deck is built from <strong>high-frequency words</strong>, the ones that make up most of
          everyday speech and text in that language. Learning them first gives you the biggest return per
          card, because you meet them constantly the moment you start reading or listening. Every card
          carries a plain meaning and a real example sentence, so you learn the word in context rather than
          as a bare translation.
        </p>
        <p>
          Flashcards work best with <strong>spaced repetition</strong>, and Anki and Quizlet both handle
          that for you. Download a deck as a CSV, import it, and review a few minutes a day. The honest
          limit is that flashcards build recognition, not use. Pair them with reading, where the same words
          show up in real sentences, which is exactly what reading in Lingo7 is built for.
        </p>
      </div>

      <p class="fc-tool-link">
        <a href="/tools/reading-level-recommender/">Which book should you read at your level? &rarr;</a>
      </p>
      <p class="fc-tool-link">
        <a href="/tools/cefr-level-test/">Not sure of your level? Find it with the CEFR test (A1 to C2) &rarr;</a>
      </p>
      <p class="fc-tool-link">
        <a href="/tools/how-long-to-learn-a-language/">How long does it take to learn a language? &rarr;</a>
      </p>
      <p class="fc-tool-link">
        <a href="/tools/language-difficulty-ranker/">Compare 48 languages by difficulty for your native tongue &rarr;</a>
      </p>

      <div class="fc-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .fc { padding: 3rem 0 4rem; }
  .fc-head { max-width: 760px; margin: 0 auto 1.5rem; text-align: center; }
  .fc-eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem;
    color: var(--primary); font-weight: 700; margin: 0 0 0.5rem;
  }
  .fc-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
  .fc-intro { color: var(--text-muted, #9fb0c3); font-size: 1.05rem; line-height: 1.6; margin: 0; }

  .fc-langgrid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.8rem; max-width: 820px; margin: 2rem auto 0;
  }
  .fc-langcard {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    text-decoration: none; text-align: center;
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px; padding: 1.2rem 1rem; transition: all 0.15s ease;
  }
  .fc-langcard:hover { border-color: var(--primary); transform: translateY(-2px); }
  .fc-langflag { font-size: 2rem; }
  .fc-langname { color: var(--text, #e8eef5); font-weight: 700; font-size: 1.05rem; }
  .fc-langsub { color: var(--text-muted, #9fb0c3); font-size: 0.78rem; font-variant-numeric: tabular-nums; }

  .fc-cta {
    max-width: 760px; margin: 3rem auto 0; text-align: center;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.18);
    border-radius: 16px; padding: 2.2rem 1.5rem;
  }
  .fc-cta h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
  .fc-cta p { color: var(--text-muted, #9fb0c3); margin: 0 0 1.4rem; line-height: 1.6; }
  .fc-cta :global(.cta-buttons) { justify-content: center; }

  .fc-explainer { max-width: 760px; margin: 3rem auto 0; }
  .fc-explainer h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .fc-explainer p { color: var(--text-muted, #9fb0c3); line-height: 1.7; margin: 0 0 1rem; }
  .fc-explainer strong { color: var(--text, #e8eef5); }

  .fc-tool-link { max-width: 760px; margin: 2rem auto 0; text-align: center; font-size: 0.95rem; }
  .fc-tool-link a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .fc-tool-link a:hover { text-decoration: underline; }

  .fc-faq { max-width: 760px; margin: 3rem auto 0; }
  .fc-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .fc-faq details {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
  }
  .fc-faq summary { cursor: pointer; font-weight: 600; }
  .fc-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }
</style>
