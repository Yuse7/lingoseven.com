---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDemoCta from '../../components/AppDemoCta.astro';
import { LINGO7, getApp, COMPARISONS, rankedApps, featLabel, AS_OF, type ReadingApp } from '../../data/readingApps';

const compares = COMPARISONS.map((c) => {
  const a = getApp(c.competitorSlug)!;
  return { slug: c.slug, app: a };
});

const apps = rankedApps();
const us = LINGO7;

const COLS: { key: keyof ReadingApp['feats']; label: string }[] = [
  { key: 'importBooks', label: 'Your own books' },
  { key: 'parallel', label: 'Parallel translation' },
  { key: 'audio', label: 'Synced audio' },
  { key: 'srs', label: 'Vocabulary trainer' },
  { key: 'speaking', label: 'Speaking practice' },
];

const canonicalUrl = 'https://lingoseven.com/compare/';
const title = 'Lingo7 vs LingQ, Beelinguapp, Readle, EWA: Compared (2026) | Lingo7';
const description =
  'Honest comparisons of Lingo7 with LingQ, Beelinguapp, Readle and EWA for reading books in a foreign language: parallel translation, audio, imports, languages and price.';

const directAnswer =
  `Lingo7, LingQ, Beelinguapp, Readle and EWA all help you read in a foreign language, but they work differently. ` +
  `Lingo7 and LingQ let you read your own books; Beelinguapp, Readle and EWA give you a fixed catalog. ` +
  `Lingo7 adds a side-by-side parallel translation, audio and a vocabulary trainer in one app. These pages compare them honestly, feature by feature.`;

const faq = [
  {
    question: 'What is the best alternative to LingQ for reading?',
    answer:
      'If you want to read your own imported books but prefer a continuous side-by-side parallel translation rather than tapping each word, Lingo7 is the closest alternative, and it adds native-narrated audio and a built-in vocabulary trainer. Beelinguapp is a lighter, catalog-based alternative if you are happy reading graded stories instead of full books.',
  },
  {
    question: 'Which reading app supports the most languages?',
    answer:
      `Among these apps, Lingo7 (${us.languages.length} languages) and LingQ (50+) have the widest coverage. Beelinguapp covers roughly 20, EWA and Readle far fewer. If your target language is outside the major European set, coverage is the first thing to check, since it is where these apps differ most.`,
  },
  {
    question: 'Do these apps let you read your own books?',
    answer:
      `${apps
        .filter((a) => a.feats.importBooks === true)
        .map((a) => a.name)
        .join(' and ')} let you import your own files (for example EPUB or PDF). Beelinguapp, Readle and EWA give you a fixed catalog of stories or licensed books instead, so you cannot read an arbitrary book of your choosing.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingoseven.com/' },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <section class="chub">
    <div class="container">
      <header class="chub-head">
        <p class="chub-eyebrow">Honest comparisons</p>
        <h1>Lingo7 vs other reading apps <span>(2026)</span></h1>
      </header>

      <p class="chub-answer">{directAnswer}</p>

      <div class="chub-cards">
        {
          compares.map((c) => (
            <a class="chub-card" href={`/compare/${c.slug}/`}>
              <h2>Lingo7 vs {c.app.name}</h2>
              <p>{c.app.vs!.chooseThemIf[0]}</p>
              <span class="chub-card-go">See the comparison &rarr;</span>
            </a>
          ))
        }
      </div>

      <div class="chub-table-wrap">
        <h2>All five apps at a glance</h2>
        <p class="chub-table-note">Ranked for reading real books. As of {AS_OF}.</p>
        <div class="chub-table-scroll">
          <table class="chub-table">
            <thead>
              <tr>
                <th scope="col">App</th>
                {COLS.map((c) => <th scope="col">{c.label}</th>)}
                <th scope="col">Languages</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {
                apps.map((a) => (
                  <tr class={a.slug === 'lingo7' ? 'chub-row-us' : ''}>
                    <th scope="row">{a.name}</th>
                    {COLS.map((c) => (
                      <td data-v={featLabel(a.feats[c.key])}>{featLabel(a.feats[c.key])}</td>
                    ))}
                    <td>{a.languageNote}</td>
                    <td>{a.priceShort}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <AppDemoCta
        title="Read any book, in parallel, with audio"
        text={`Lingo7 lets you read real books, ours or your own upload, with the original and a ` +
          `sentence-by-sentence {uiLang} translation side by side, native-narrated audio, and a tap to send ` +
          `new words to a spaced-repetition trainer. Free to start, in ${us.languages.length} languages.`}
      />

      <div class="chub-faq">
        <h2>Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
      </div>

      <p class="chub-tool-link">
        <a href="/best-apps-to-read-books-in/">Best apps to read books, by language &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .chub { padding: 3rem 0 4rem; }
  .chub-head { max-width: 820px; margin: 0 auto 1.2rem; text-align: center; }
  .chub-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; color: var(--primary); font-weight: 700; margin: 0 0 0.5rem; }
  .chub-head h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.15; margin: 0; }
  .chub-head h1 span { color: var(--text-muted, #9fb0c3); font-weight: 700; }

  .chub-answer {
    max-width: 760px; margin: 0 auto; text-align: left;
    background: rgba(74, 222, 128, 0.06); border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 16px; padding: 1.3rem 1.5rem; color: var(--text, #e8eef5); font-size: 1.05rem; line-height: 1.65;
  }

  .chub-cards { max-width: 820px; margin: 2.5rem auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .chub-card {
    display: block; text-decoration: none;
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px; padding: 1.3rem 1.4rem; transition: all 0.14s ease;
  }
  .chub-card:hover { border-color: var(--primary); transform: translateY(-2px); }
  .chub-card h2 { font-size: 1.2rem; margin: 0 0 0.5rem; color: var(--text, #e8eef5); }
  .chub-card p { color: var(--text-muted, #9fb0c3); font-size: 0.92rem; line-height: 1.5; margin: 0 0 0.8rem; }
  .chub-card-go { color: var(--primary); font-weight: 600; font-size: 0.9rem; }

  .chub-table-wrap { max-width: 900px; margin: 3rem auto 0; }
  .chub-table-wrap h2 { font-size: 1.5rem; margin: 0 0 0.3rem; text-align: center; }
  .chub-table-note { color: var(--text-muted, #9fb0c3); font-size: 0.85rem; text-align: center; margin: 0 0 1.2rem; }
  .chub-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .chub-table { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 0.9rem; }
  .chub-table th, .chub-table td { padding: 0.7rem 0.8rem; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .chub-table thead th { color: var(--text-muted, #9fb0c3); font-weight: 600; font-size: 0.82rem; border-bottom: 1px solid rgba(255, 255, 255, 0.16); }
  .chub-table tbody th[scope='row'] { text-align: left; color: var(--text, #e8eef5); font-weight: 700; }
  .chub-table td { color: var(--text-muted, #9fb0c3); }
  .chub-table td[data-v='Yes'] { color: var(--primary); font-weight: 700; }
  .chub-table .chub-row-us { background: rgba(74, 222, 128, 0.07); }
  .chub-table .chub-row-us th[scope='row'] { color: var(--primary); }

  .chub-faq { max-width: 760px; margin: 3rem auto 0; }
  .chub-faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
  .chub-faq details { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 0.7rem; }
  .chub-faq summary { cursor: pointer; font-weight: 600; }
  .chub-faq p { color: var(--text-muted, #9fb0c3); line-height: 1.6; margin: 0.7rem 0 0; }

  .chub-tool-link { max-width: 760px; margin: 2.5rem auto 0; text-align: center; font-size: 0.95rem; }
  .chub-tool-link a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .chub-tool-link a:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .chub-cards { grid-template-columns: 1fr; }
  }
</style>
