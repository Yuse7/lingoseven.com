---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButtons from '../components/CtaButtons.astro';

// Link-in-bio landing: a single short URL (lingoseven.com/get) for social
// profiles (Instagram, etc.) that fans out to both app stores. Intentionally
// minimal: logo, one line, two store buttons. noindex so it is not treated as
// thin/doorway content by search engines.
---

<BaseLayout
  title="Get Lingo7 — App Store & Google Play"
  description="Download Lingo7 and learn a language by reading the books you love. Available on the App Store and Google Play."
  canonicalUrl="https://lingoseven.com/get"
  showNav={false}
  noindex={true}
>
  <main class="get">
    <section class="get-card">
      <img class="get-logo" src="/images/logo.svg" alt="Lingo7" width="84" height="84" />
      <h1 class="get-title">Lingo7</h1>
      <p class="get-tagline">Learn a language by reading the books you love.</p>

      <div class="hero-cta get-cta">
        <CtaButtons size="large" />
      </div>

      <img class="get-mascot" src="/images/pic.png" alt="" loading="lazy" />
    </section>
  </main>
</BaseLayout>

<style>
  .get {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 20px 60px;
  }

  .get-card {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .get-logo {
    width: 84px;
    height: 84px;
    border-radius: 22px;
  }

  .get-title {
    margin: 18px 0 6px;
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .get-tagline {
    margin: 0 0 30px;
    font-size: 1.1rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
    max-width: 360px;
  }

  .get-cta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 280px;
  }

  /* Make both store buttons full width and equally weighted in this context. */
  .get-cta :global(.cta-buttons) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .get-cta :global(.btn) {
    justify-content: center;
    width: 100%;
  }

  .get-mascot {
    margin-top: 44px;
    max-width: 240px;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 480px) {
    .get-title { font-size: 2.2rem; }
  }
</style>
